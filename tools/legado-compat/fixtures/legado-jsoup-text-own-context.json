  "cases": [
    {
      "id": "direct_own_text_link",
      "html": "<nav><a id=\"next\" href=\"/next\">下一页</a></nav>",
      "contextSelector": "synthetic-root",
      "rule": "text.下一页",
      "expectedIds": ["next"],
      "expectedCount": 1,
      "semantics": "A direct text node on the link is selectable and retains its href consumer."
    },
    {
      "id": "nested_text_does_not_promote_ancestor",
      "html": "<nav><a id=\"wrapper\" href=\"/wrong\"><span id=\"label\">下一页</span></a></nav>",
      "contextSelector": "synthetic-root",
      "rule": "text.下一页",
      "expectedIds": ["label"],
      "expectedCount": 1,
      "semantics": "Jsoup getElementsContainingOwnText does not select an ancestor merely because a descendant contains the text."
    },
    {
      "id": "context_element_own_text_matches_self",
      "html": "<a id=\"self\" href=\"/author\">作者</a>",
      "contextSelector": "#self",
      "rule": "text.作者",
      "expectedIds": ["self"],
      "expectedCount": 1,
      "semantics": "The supplied Element is included by the Jsoup collector when its own text matches."
    },
    {
      "id": "synthetic_document_root_is_not_text_candidate",
      "html": "<article id=\"body\">正文</article>",
      "contextSelector": "synthetic-root",
      "rule": "text.正文",
      "expectedIds": ["body"],
      "expectedCount": 1,
      "semantics": "The parser synthetic root remains a Document boundary even when the descendant text matches."
    }
