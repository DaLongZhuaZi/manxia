  "consumerContract": {
    "holder": "legadoGetStringListSingle creates a detached div and assigns response HTML",
    "requiredFix": "When a manual pseudo is the only simple selector in a compound, compile that compound as universal * before browser selection and target projection.",
    "legadoReference": "AnalyzeByJSoup delegates such selectors to Jsoup Element.select, where a pseudo-only compound is equivalent to the universal element selector."
  }
