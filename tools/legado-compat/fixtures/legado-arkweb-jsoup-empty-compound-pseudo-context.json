  "cases": [
    {
      "id": "direct-child-universal-not",
      "html": "<div><p class=\"keep\"><span>keep</span></p><p class=\"skip\"><span>skip</span></p></div>",
      "rule": "div > :not(.skip) > span@text",
      "expected": ["keep"],
      "semantics": "a_pseudo_only_compound_after_direct_child_combinator_is_universal"
    },
    {
      "id": "descendant-universal-has",
      "html": "<section><div><p class=\"keep\"><a>keep</a></p><p class=\"skip\"><a>skip</a></p></div></section>",
      "rule": "section :has(> a):not(.skip) > a@text",
      "expected": ["keep"],
      "semantics": "a_pseudo_only_descendant_compound_keeps_the_universal_target"
    },
    {
      "id": "direct-child-after-matchesown",
      "html": "<div><p>parent<span>keep</span></p><p><span>drop</span></p></div>",
      "rule": "p:matchesOwn(parent)>:not(br,a)@text",
      "expected": ["keep"],
      "semantics": "a_pseudo_only_right_operand_after_a_custom_pseudo_is_universal"
    },
    {
      "id": "pseudo-only-left-matchesown",
      "html": "<div><p><a>keep</a></p><p><a>also-keep</a></p></div>",
      "rule": ":matchesOwn(^$)>a@text",
      "expected": ["keep", "also-keep"],
      "semantics": "a_pseudo_only_left_operand_before_direct_child_is_universal"
    },
    {
      "id": "repeated-pseudo-only-left-compound",
      "html": "<div><p><span>marker</span><a>keep</a></p><p class=\"skip\"><span>marker</span><a>skip</a></p></div>",
      "rule": ":has(> span):not(.skip)>a@text",
      "expected": ["keep"],
      "semantics": "multiple_manual_pseudos_share_one_universal_left_compound_before_direct_child"
    },
    {
      "id": "pseudo-only-sibling-compounds",
      "html": "<section><div><p>left</p></div><div><p>right</p></div></section>",
      "rule": ":has(> p)+:has(> p)@text",
      "expected": ["right"],
      "semantics": "pseudo_only_compounds_joined_by_adjacent_sibling_preserve_universal_targets"
    }
  ],
  "affectedSourceOrdinals": [357, 402],
