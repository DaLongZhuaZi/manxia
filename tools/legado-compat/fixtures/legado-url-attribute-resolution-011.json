  "html": "<section class=\"primary\"><a href=\"/a\">A</a><a href=\"/b\">B</a></section><img src=\"/img/cover.webp\" data-src=\"/img/lazy.webp\">",
  "baseUrl": "https://fixture.invalid/detail/page",
  "cases": [
    {
      "id": "css-attribute-raw-multi",
      "workflow": "Search",
      "rule": ".primary@a@href",
      "expectedLegadoSelectorValues": ["/a", "/b"],
      "expectedV2AnalyzerValues": ["/a", "/b"],
      "consumerResolution": "https://fixture.invalid/a and https://fixture.invalid/b"
    },
    {
      "id": "cover-raw-before-consumer-resolution",
      "workflow": "BookInfo",
      "rule": "img@src",
      "expectedLegadoSelectorValue": "/img/cover.webp",
      "expectedV2AnalyzerValue": "/img/cover.webp",
      "consumerResolution": "https://fixture.invalid/img/cover.webp"
    },
    {
      "id": "lazy-attribute-preserved",
      "workflow": "Content",
      "rule": "img@data-src",
      "expectedLegadoSelectorValue": "/img/lazy.webp",
      "expectedV2AnalyzerValue": "/img/lazy.webp",
      "consumerResolution": "resolve only in image/request consumer"
    },
    {
      "id": "url-option-remains-attached",
      "workflow": "Toc",
      "rule": ".primary@a@href",
      "expectedRequestCarrier": "resolved identity plus untouched option suffix",
      "consumerResolution": "LegadoUrlAnalyzer runs at request-owning workflow"
    }
