
class ThemesBrowser extends HTMLElement {
    style() {
        return `
            .premium-label{
                width: fit-content;
                height: 20px;
                padding: 0 8px;
                border-radius: 24px;
                border: 1px;
                font-size: 12px;
                font-weight: 500;
                letter-spacing: 0em;
                text-align: center;
                color: var(--gray-1);
                text-transform: uppercase;
                display: inline-block;
                text-decoration: none;
                border: 1px solid var(--yellow-5);
                background: rgb(249, 136, 127);
                background: -moz-radial-gradient(circle, rgba(249, 136, 127, 1) 0%, rgba(248, 209, 67, 1) 100%);
                background: -webkit-radial-gradient(circle, rgba(249, 136, 127, 1) 0%, rgba(248, 209, 67, 1) 100%);
                background: radial-gradient(circle, rgba(249, 136, 127, 1) 0%, rgba(248, 209, 67, 1) 100%);
                position: relative;
                top: -1px;
                left: 5px;
                line-height: 21px;
            }
            .premium-warning{
                background: var(--yellow-1);
                text-align: center;
                color: var(--gray-9);
                border-radius: 0 0 4px 4px;
                font-size: 12px;
                padding: 8px 0;
                line-height: 16px;
            }
            .premium-warning a{
                background: rgb(249, 136, 127);
                background: -moz-linear-gradient(to bottom, rgba(249, 136, 127, 1) 0%, rgba(248, 209, 67, 1) 100%);
                background: -webkit-linear-gradient(to bottom, rgba(249, 136, 127, 1) 0%, rgba(248, 209, 67, 1) 100%);
                background: linear-gradient(to bottom, rgba(249, 136, 127, 1) 0%, rgba(248, 209, 67, 1) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                border-bottom: 1px solid rgb(217 160 73);
            }
            .container{
                padding: 11px 20px 14px;
            }
            .title{
                color: var(--gray-7);
                text-transform: uppercase;
            }
            .row{
                display: flex;
                max-width: 216px;
                width: 100%;
                justify-content: center;
                margin: 14px auto 0;
                gap: 20px;
            }
            .theme-trigger{
                width: 56px;
                height: 56px;
                border: 1px solid var(--gray-5);
                border-radius: 100px;
                box-sizing: border-box;
                cursor: pointer;
                overflow: hidden;
            }
            .theme-trigger img{
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
            .theme-trigger.current{
                border: 3px solid var(--gray-5);
            }
            .theme-trigger.current.hide-current{
                border: 1px solid var(--gray-5);
            }
            :host{
                margin-bottom: -4px;
                display: block;
            }
            .row.basic{
                margin-bottom: 18px;
            }
            @media (min-width: 571px) {
                .basic{
                    display: none;
                }
            }
            @media (max-width: 570px) {
                .title{
                    text-align: center;
                }
            }
        `
    }
    themes = [
        { type: 'basic', name: 'light', color: 'rgb(250 254 255)' },
        { type: 'basic', name: 'dark', color: '#1E1F22' },
        { type: 'glass', style: 'g1', name: 'glass-g1', icon: '/img/glass/1.svg' },
        { type: 'glass', style: 'g2', name: 'glass-g2', icon: '/img/glass/2.svg' },
        { type: 'glass', style: 'g3', name: 'glass-g3', icon: '/img/glass/3.svg' },
    ]

    connectedCallback() {
        if (this.shadowRoot) return
        this.attachShadow({ mode: 'open' });
        this.isPremium = this.hasAttribute('premium')

        let currentThemeName = getCookie('prefers_color_scheme') ? getCookie('prefers_color_scheme') : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        let prefersGlassStyle = this.isPremium ? (getCookie('prefers_glass_style') || 'g1') : null
        let html = `<link rel="stylesheet" href="/resources/fonts/zlibicons.css?${ZLibrary._.version}"><style>${this.style()}</style>`

        html += `<div class="container">`
        html += `<div class="title basic">${i18next.t('Standard mode')}</div>`
        html += `<div class="row basic">`
        this.themes.filter(el => el.type == 'basic').forEach(theme => {
            html += `<div class="theme-trigger ${theme.name == currentThemeName && 'current'}" data-theme="${theme.name}" style="background-color: ${theme.color}"></div>`
        })
        html += `</div><div class="title">${i18next.t('Aurora mode')} <sup><small><i style="text-transform: none">(beta)</i></small></sup> ${!this.isPremium ? `<a href="/upgrade" target="_blank" class="premium-label">Premium</a>` : ``}</div>`
        html += `<div class="row">`
        this.isPremium ? 
            this.themes.filter(el => el.type == 'glass').forEach(theme => {
                html += `<div class="theme-trigger ${theme.type !== currentThemeName ? 'hide-current' : ''} ${(theme.style == prefersGlassStyle) ? 'current' : ''}" data-type="glass" data-theme="${theme.name}"><img src="${theme.icon}" /></div>`
            }) : 
            this.themes.filter(el => el.type == 'glass').forEach(theme => {
                html += `<a class="theme-trigger" href="/upgrade" target="_blank"><img src="${theme.icon}" /></a>`
            })
        html += `</div></div>`

        if (!this.isPremium) {
            html += '<div class="premium-warning">'
            html += i18next.t('New fantastic Northern Lights <br /> mode now available to ')
            html += '<a href="/upgrade">' + i18next.t('Premium users') + '</a>'
            html += '</div>'
        }

        this.shadowRoot.innerHTML = html

        this.shadowRoot.querySelectorAll('div.theme-trigger').forEach(el => {
            el.addEventListener('click', () => {
                this.dispatchEvent(new CustomEvent('change', { detail: { theme: el.dataset.theme } }))
                currentThemeName = el.dataset.theme
                if(el.dataset.type == 'glass'){
                    this.shadowRoot.querySelectorAll('.hide-current').forEach(el => el.classList.remove('hide-current'))
                }
                this.shadowRoot.querySelectorAll('.theme-trigger').forEach(el => el.classList.remove('current'))
                this.shadowRoot.querySelector(`.theme-trigger[data-theme="${currentThemeName}"]`).classList.add('current')
            })
        })

        ZLibrary.dispatch('ready', this)
    }
    disconnect() {
        this.remove();
    }
}
customElements.define('z-themes-browser', ThemesBrowser)