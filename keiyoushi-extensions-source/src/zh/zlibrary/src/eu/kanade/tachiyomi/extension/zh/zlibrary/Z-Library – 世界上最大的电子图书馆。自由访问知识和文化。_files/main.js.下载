function openTelegramApp(bot,hash=null){if(!bot){return}
hash=typeof hash!=="undefined"?'?start='+hash:""
window.location.href='https://t.me/'+bot+hash}
function checkTelegramUserBinding(success,failed){const $isPinnedContent=$('.tg-bot-isPinned')
if($isPinnedContent.length&&$isPinnedContent.is(':visible')){return}
let ms=5000
window.checkTelegramUserBindingCounter=window.checkTelegramUserBindingCounter?window.checkTelegramUserBindingCounter+1:1
if(window.checkTelegramUserBindingCounter<5){ms=2000}else if(window.checkTelegramUserBindingCounter>10){window.checkTelegramUserBindingCounter=0
if(typeof failed==='function'){failed()}
return}
new ZLibraryResponse('/papi/user/telegram/pinned').success(response=>{if(response.isPinned===true){if($isPinnedContent.length){if($isPinnedContent.is(':visible')){return}
changeTelegramDivDisplay(true)}
window.checkTelegramUserBindingCounter=0
window.TelegramPinned=true
const msg=i18next.t('Your account has been successfully connected to Telegram!')
if($isPinnedContent.length){loadTelegramBotName()
ZLibraryNotify().success(msg)
if(typeof success==='function'){success()}}else{loadTelegramBotName(function(botName){ZLibraryNotify().success(msg)
setTimeout(function(){openTelegramApp(botName)},1000)},function(){ZLibraryNotify().success(msg)
if(typeof success==='function'){success()}})}}else if(response.connectError){window.location.reload()}else{setTimeout(function(){checkTelegramUserBinding(success,failed)},ms)}}).fetch()}
function updateTelegramBindingStatus(){if(typeof window.TelegramPinned!=='undefined'){return}
const status=getTelegramBindingStatusFromLocalStorage()
if(status!==null){window.TelegramPinned=status
loadTelegramBotName()
return}
new ZLibraryResponse('/papi/user/telegram/pinned').success(response=>{if(response.connectError||response.error){return}
setTelegramBindingStatusToLocalStorage(response.isPinned)
window.TelegramPinned=response.isPinned
loadTelegramBotName()}).fetch()}
function resetTelegramBotName(){if(!window.localStorage){return}
localStorage.removeItem("TelegramBotName")
window.TelegramBotName=null}
function loadTelegramBotName(success,failed){if(!window.TelegramPinned){if(typeof failed==='function'){failed()}
return}
if(typeof window.TelegramBotName==='string'){if(typeof success==='function'){success(window.TelegramBotName)}
return}
if(window.localStorage&&(window.TelegramBotName=localStorage.getItem("TelegramBotName"))){$(document).trigger('tg.botName.loaded')
if(typeof success==='function'){success(window.TelegramBotName)}
return}
new ZLibraryResponse('/papi/user/telegram/botname').success(response=>{if(response.bot){window.TelegramBotName=response.bot
if(window.localStorage){localStorage.setItem("TelegramBotName",response.bot)
window.dispatchEvent(new CustomEvent('TelegramBotPinned',{detail:{name:response.bot}}));}
$(document).trigger('tg.botName.loaded')
if(typeof success==='function'){success(window.TelegramBotName)}}}).fetch()}
function changeTelegramDivDisplay(pinned){const $divNotPinned=$('.tg-bot-isNotPinned')
const $divPinned=$('.tg-bot-isPinned')
if(!$divNotPinned.length||!$divPinned.length){return}
$divNotPinned.css('display',!pinned?'block':'none')
$divPinned.css('display',pinned?'block':'none')
setTelegramBindingStatusToLocalStorage(pinned)}
function removeTelegramUserBinding(button){const $button=$(button)
$button.attr('disabled','disabled')
const request=new Request('/papi/user/telegram/binding',{method:'DELETE',})
const spinner=new ZLibrarySpinner($button).color('#D9D9D9')
setTelegramBindingStatusToLocalStorage(null)
new ZLibraryResponse(request).spinner(spinner).success(response=>{$button.removeAttr('disabled')
if(response.connectError){new ZLibraryNotify().error(i18next.t('Connection timeout. Please try again later.'))
return}
if(response.code===200){window.TelegramPinned=false;changeTelegramDivDisplay(false)
resetTelegramBotName()
ZLibraryNotify().success(i18next.t('Your account has been disconnected from Telegram!'))}else{ZLibraryNotify().info(response.message)
doLoadTelegramBindingStatus()}}).error(error=>{$button.removeAttr('disabled')}).fetch()}
