{
  "$schema": "./source-schema.json",
  "metadata": {
    "id": "komiic",
    "name": "Komiic",
    "version": "1.0.0",
    "language": "zh-CN",
    "baseUrl": "https://komiic.com",
    "description": "Komiic 是一个免费的在线漫画阅读平台",
    "author": "ManXia Team",
    "icon": "icon.png",
    "nsfw": false,
    "tags": ["Chinese", "Manga", "Webtoon"],
    "updateStrategy": "latest_chapter"
  },
  
  "network": {
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "headers": {
      "Referer": "https://komiic.com/",
      "Accept": "application/json, text/plain, */*",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
    },
    "timeout": 30000,
    "retryCount": 3,
    "retryDelay": 1000,
    "rateLimit": {
      "requestsPerSecond": 2,
      "burstSize": 5
    }
  },
  
  "api": {
    "type": "graphql",
    "endpoint": "https://komiic.com/api/query",
    "authentication": {
      "type": "none"
    }
  },
  
  "features": {
    "popular": {
      "enabled": true,
      "method": "POST",
      "url": "{{baseUrl}}/api/query",
      "body": {
        "operationName": "recentUpdate",
        "query": "query recentUpdate($pagination: Pagination!) { recentUpdate(pagination: $pagination) { id title authors { id name } imageUrl } }",
        "variables": {
          "pagination": {
            "limit": "{{limit}}",
            "offset": "{{offset}}"
          }
        }
      },
      "responseType": "json",
      "parser": {
        "type": "json",
        "listPath": "$.data.recentUpdate",
        "item": {
          "id": "$.id",
          "title": "$.title",
          "author": "$.authors[0].name",
          "coverUrl": "$.imageUrl",
          "url": "{{baseUrl}}/comic/{{id}}"
        }
      },
      "pagination": {
        "type": "offset",
        "limitParam": "limit",
        "offsetParam": "offset",
        "defaultLimit": 20,
        "maxLimit": 50
      }
    },
    
    "latest": {
      "enabled": true,
      "method": "POST",
      "url": "{{baseUrl}}/api/query",
      "body": {
        "operationName": "recentUpdate",
        "query": "query recentUpdate($pagination: Pagination!) { recentUpdate(pagination: $pagination) { id title authors { id name } imageUrl dateUpdated } }",
        "variables": {
          "pagination": {
            "limit": "{{limit}}",
            "offset": "{{offset}}"
          }
        }
      },
      "responseType": "json",
      "parser": {
        "type": "json",
        "listPath": "$.data.recentUpdate",
        "item": {
          "id": "$.id",
          "title": "$.title",
          "author": "$.authors[0].name",
          "coverUrl": "$.imageUrl",
          "url": "{{baseUrl}}/comic/{{id}}",
          "updateTime": "$.dateUpdated"
        }
      }
    },
    
    "search": {
      "enabled": true,
      "method": "POST",
      "url": "{{baseUrl}}/api/query",
      "body": {
        "operationName": "searchComicByKeyword",
        "query": "query searchComicByKeyword($keyword: String!, $pagination: Pagination!) { searchComicByKeyword(keyword: $keyword, pagination: $pagination) { id title authors { id name } imageUrl } }",
        "variables": {
          "keyword": "{{keyword}}",
          "pagination": {
            "limit": "{{limit}}",
            "offset": "{{offset}}"
          }
        }
      },
      "responseType": "json",
      "parser": {
        "type": "json",
        "listPath": "$.data.searchComicByKeyword",
        "item": {
          "id": "$.id",
          "title": "$.title",
          "author": "$.authors[0].name",
          "coverUrl": "$.imageUrl",
          "url": "{{baseUrl}}/comic/{{id}}"
        }
      },
      "filters": [
        {
          "type": "text",
          "id": "keyword",
          "name": "关键词",
          "placeholder": "输入漫画名称或作者"
        }
      ]
    },
    
    "detail": {
      "enabled": true,
      "method": "POST",
      "url": "{{baseUrl}}/api/query",
      "body": {
        "operationName": "comicById",
        "query": "query comicById($comicId: ID!) { comicById(comicId: $comicId) { id title description authors { id name } imageUrl status dateUpdated chapters { id title dateUpdated } } }",
        "variables": {
          "comicId": "{{comicId}}"
        }
      },
      "responseType": "json",
      "parser": {
        "type": "json",
        "root": "$.data.comicById",
        "fields": {
          "id": "$.id",
          "title": "$.title",
          "description": "$.description",
          "author": "$.authors[0].name",
          "coverUrl": "$.imageUrl",
          "status": "$.status",
          "updateTime": "$.dateUpdated",
          "chapters": {
            "listPath": "$.chapters",
            "item": {
              "id": "$.id",
              "title": "$.title",
              "updateTime": "$.dateUpdated"
            }
          }
        }
      }
    },
    
    "pages": {
      "enabled": true,
      "method": "POST",
      "url": "{{baseUrl}}/api/query",
      "body": {
        "operationName": "chapterById",
        "query": "query chapterById($chapterId: ID!) { chapter(chapterId: $chapterId) { id images { id kid width height } } }",
        "variables": {
          "chapterId": "{{chapterId}}"
        }
      },
      "responseType": "json",
      "parser": {
        "type": "json",
        "listPath": "$.data.chapter.images",
        "item": {
          "url": "https://komiic.com/api/image/{{kid}}",
          "width": "$.width",
          "height": "$.height"
        }
      },
      "imageHeaders": {
        "Referer": "https://komiic.com/"
      }
    }
  },
  
  "settings": {
    "imageQuality": {
      "type": "select",
      "name": "图片质量",
      "default": "high",
      "options": [
        { "value": "low", "label": "低" },
        { "value": "medium", "label": "中" },
        { "value": "high", "label": "高" },
        { "value": "original", "label": "原图" }
      ]
    },
    "dataServer": {
      "type": "select",
      "name": "数据服务器",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "自动选择" },
        { "value": "cn", "label": "中国大陆" },
        { "value": "hk", "label": "香港" },
        { "value": "tw", "label": "台湾" }
      ]
    },
    "showNSFW": {
      "type": "boolean",
      "name": "显示成人内容",
      "default": false
    }
  },
  
  "urlPatterns": {
    "comic": "^https?://komiic\\.com/comic/([^/]+)$",
    "chapter": "^https?://komiic\\.com/comic/([^/]+)/chapter/([^/]+)$"
  },
  
  "notes": [
    "Komiic 使用 GraphQL API",
    "图片需要特定的 Referer 头才能访问",
    "部分内容可能需要登录才能查看"
  ],
  
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2025-11-17",
      "changes": [
        "初始版本",
        "支持热门、最新、搜索功能",
        "支持漫画详情和章节列表",
        "支持图片加载"
      ]
    }
  ]
}
