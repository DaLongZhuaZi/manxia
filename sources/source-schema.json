{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manxia.app/schemas/source-v1.json",
  "title": "ManXia Source Plugin Schema",
  "description": "JSON格式的漫画图源插件定义",
  "type": "object",
  "required": ["metadata", "network", "api", "features"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version", "language", "baseUrl"],
      "properties": {
        "id": {
          "type": "string",
          "description": "图源唯一标识符",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "description": "图源显示名称"
        },
        "version": {
          "type": "string",
          "description": "图源版本号",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "language": {
          "type": "string",
          "description": "图源语言代码",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "baseUrl": {
          "type": "string",
          "description": "图源基础URL",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "description": "图源描述"
        },
        "author": {
          "type": "string",
          "description": "作者"
        },
        "icon": {
          "type": "string",
          "description": "图标文件名"
        },
        "nsfw": {
          "type": "boolean",
          "description": "是否包含成人内容",
          "default": false
        },
        "tags": {
          "type": "array",
          "description": "标签列表",
          "items": {
            "type": "string"
          }
        },
        "updateStrategy": {
          "type": "string",
          "description": "更新策略",
          "enum": ["latest_chapter", "all_chapters", "manual"]
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "userAgent": {
          "type": "string",
          "description": "User-Agent字符串"
        },
        "headers": {
          "type": "object",
          "description": "默认HTTP头",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "integer",
          "description": "请求超时时间（毫秒）",
          "minimum": 1000,
          "default": 30000
        },
        "retryCount": {
          "type": "integer",
          "description": "重试次数",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "retryDelay": {
          "type": "integer",
          "description": "重试延迟（毫秒）",
          "minimum": 0,
          "default": 1000
        },
        "rateLimit": {
          "type": "object",
          "description": "速率限制",
          "properties": {
            "requestsPerSecond": {
              "type": "number",
              "minimum": 0.1
            },
            "burstSize": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["type", "endpoint"],
      "properties": {
        "type": {
          "type": "string",
          "description": "API类型",
          "enum": ["rest", "graphql", "html", "custom"]
        },
        "endpoint": {
          "type": "string",
          "description": "API端点URL"
        },
        "authentication": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["none", "basic", "bearer", "oauth2", "custom"]
            },
            "credentials": {
              "type": "object"
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "description": "功能定义",
      "properties": {
        "popular": {
          "$ref": "#/definitions/feature"
        },
        "latest": {
          "$ref": "#/definitions/feature"
        },
        "search": {
          "$ref": "#/definitions/feature"
        },
        "detail": {
          "$ref": "#/definitions/feature"
        },
        "pages": {
          "$ref": "#/definitions/feature"
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "用户设置",
      "additionalProperties": {
        "$ref": "#/definitions/setting"
      }
    },
    "urlPatterns": {
      "type": "object",
      "description": "URL匹配模式",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "description": "使用说明",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "array",
      "description": "更新日志",
      "items": {
        "type": "object",
        "required": ["version", "date", "changes"],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "feature": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE"]
        },
        "url": {
          "type": "string"
        },
        "body": {
          "type": "object"
        },
        "responseType": {
          "type": "string",
          "enum": ["json", "html", "xml", "text"]
        },
        "parser": {
          "type": "object"
        },
        "pagination": {
          "type": "object"
        },
        "filters": {
          "type": "array"
        },
        "imageHeaders": {
          "type": "object"
        }
      }
    },
    "setting": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "number", "boolean", "select", "multiselect"]
        },
        "name": {
          "type": "string"
        },
        "default": {},
        "options": {
          "type": "array"
        },
        "placeholder": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}
