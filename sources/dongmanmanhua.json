{
  "metadata": {
    "name": "Dongman Manhua",
    "version": "1.0.0",
    "author": "ManXia Team",
    "description": "咚漫漫画 - 中文漫画网站",
    "language": "zh-Hans",
    "baseUrl": "https://www.dongmanmanhua.cn",
    "icon": "https://www.dongmanmanhua.cn/favicon.ico",
    "nsfw": false
  },
  
  "settings": {
    "headers": {
      "Referer": "https://www.dongmanmanhua.cn/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
  },
  
  "workflows": {
    "popular": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}/dailySchedule"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "extract",
        "selector": "div#dailyList .daily_section li a, div.daily_lst.comp li a",
        "multiple": true,
        "fields": {
          "url": "::attr(href)",
          "title": "p.subj::text",
          "cover": "img::attr(src)"
        }
      }
    ],
    
    "latest": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}/dailySchedule?sortOrder=UPDATE&webtoonCompleteType=ONGOING"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "extract",
        "selector": "div#dailyList li a",
        "multiple": true,
        "fields": {
          "url": "::attr(href)",
          "title": "p.subj::text",
          "cover": "img::attr(src)"
        }
      }
    ],
    
    "search": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}/search?keyword={{keyword}}&page={{page}}"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "extract",
        "selector": "#content > div.card_wrap.search ul:not(#filterLayer) li a",
        "multiple": true,
        "fields": {
          "url": "::attr(href)",
          "title": "p.subj::text",
          "cover": "img::attr(src)"
        }
      }
    ],
    
    "getMangaDetail": [
      {
        "type": "navigate",
        "url": "{{url}}"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "extract",
        "selector": "#content",
        "fields": {
          "title": "h1.subj::text, h3.subj::text",
          "author": ".detail_header .info .author::text",
          "description": "#_asideDetail p.summary::text",
          "cover": ".detail_header span.thmb img::attr(src)"
        }
      }
    ],
    
    "getChapterList": [
      {
        "type": "navigate",
        "url": "{{url}}"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "extract",
        "selector": "ul#_listUl li",
        "multiple": true,
        "fields": {
          "id": "a::attr(href)",
          "title": "span.subj span::text",
          "publishTime": "span.date::text"
        }
      }
    ],
    
    "getPageList": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}{{chapterId}}"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 3000
      },
      {
        "type": "extract",
        "selector": "div#_imageList > img",
        "multiple": true,
        "fields": {
          "imageUrl": "::attr(data-url)"
        }
      }
    ],
    
    "getImageUrl": {
      "type": "direct",
      "url": "{{imageUrl}}"
    }
  }
}
