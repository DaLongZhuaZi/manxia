{
  "metadata": {
    "name": "Komiic",
    "version": "3.0.0",
    "author": "ManXia Team",
    "description": "Komiic 是一个免费的在线漫画阅读平台，使用DOM选择器提取数据",
    "baseUrl": "https://komiic.com",
    "language": "zh-TW",
    "created": "2025-11-17",
    "updated": "2025-11-18"
  },
  
  "settings": {
    "timeout": 30000,
    "retryCount": 3,
    "enableJavaScript": true,
    "enableImages": true,
    "enableCookies": true,
    "bypassCloudflare": false,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
  },
  
  "workflows": {
    "search": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}",
        "description": "导航到Komiic首页"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 5000,
        "description": "等待Vue渲染和图片加载"
      },
      {
        "type": "condition",
        "selector": ".v-overlay__content .v-card button",
        "exists": true,
        "description": "检查是否有弹窗",
        "then": [
          {
            "type": "click",
            "selector": ".v-overlay__content .v-card button",
            "description": "点击弹窗的了解按钮"
          },
          {
            "type": "wait",
            "condition": "time",
            "duration": 1000
          }
        ]
      },
      {
        "type": "extract",
        "selector": ".ComicCard",
        "multiple": true,
        "description": "提取漫画列表",
        "fields": {
          "id": "@href",
          "title": ".text-subtitle-2::text",
          "cover": ".ComicCard__image img::attr(src)",
          "status": ".status::text",
          "views": ".Comic_views::text",
          "favorites": ".ComicCard__favorite::text"
        }
      }
    ],
    
    "getMangaDetail": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}/comic/{mangaId}",
        "description": "导航到漫画详情页"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "extract",
        "selector": ".ComicMain__info",
        "description": "提取漫画详细信息",
        "fields": {
          "title": "h1.text-h6::text",
          "cover": ".v-img img::attr(src)",
          "status": ".v-row:has-text('狀態') .v-col:nth-child(2)::text",
          "year": ".v-row:has-text('年份') .v-col:nth-child(2)::text",
          "author": ".v-row:has-text('作者') a::text",
          "categories": ".v-row:has-text('類型') .v-chip::text",
          "views": ".v-row:has-text('點閱') .v-col:nth-child(2)::text",
          "updated": ".v-row:has-text('更新') .v-col:nth-child(2)::text",
          "description": ".v-card-text:first-of-type::text"
        }
      }
    ],
    
    "getChapterList": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}/comic/{mangaId}",
        "description": "导航到漫画详情页获取章节列表"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 2000
      },
      {
        "type": "script",
        "description": "滚动到章节列表区域",
        "code": "window.scrollTo(0, document.body.scrollHeight);"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 1000
      },
      {
        "type": "extract",
        "selector": ".chapter-item",
        "multiple": true,
        "description": "提取章节列表",
        "fields": {
          "id": "@href",
          "title": ".chapter-title::text",
          "publishTime": ".chapter-date::text"
        }
      }
    ],
    
    "getPageList": [
      {
        "type": "navigate",
        "url": "{{baseUrl}}/comic/{mangaId}/chapter/{chapterId}/images/all",
        "description": "导航到章节阅读页"
      },
      {
        "type": "wait",
        "condition": "time",
        "duration": 3000
      },
      {
        "type": "extract",
        "selector": ".v-img",
        "multiple": true,
        "description": "提取图片列表",
        "fields": {
          "imageUrl": "img::attr(src)",
          "page": "@data-index"
        }
      }
    ],
    
    "getImageUrl": [
      {
        "type": "script",
        "description": "直接返回图片URL",
        "code": "return '{imageUrl}';"
      },
      {
        "type": "extract",
        "selector": "script",
        "fields": {
          "imageUrl": "$"
        }
      }
    ]
  }
}
