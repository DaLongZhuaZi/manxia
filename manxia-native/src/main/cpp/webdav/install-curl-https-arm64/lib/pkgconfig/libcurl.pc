# This should most probably benefit from getting a "Requires:" field added
# dynamically by configure.
#
prefix=F:/DevEcoStudioProject/manxia/entry/src/main/cpp/webdav/install-curl-https-arm64
exec_prefix=${prefix}
libdir=F:/DevEcoStudioProject/manxia/entry/src/main/cpp/webdav/install-curl-https-arm64/lib
includedir=${prefix}/include
supported_protocols="FILE FTP FTPS HTTP HTTPS MQTT SCP SFTP"
supported_features="SSL IPv6 AsynchDNS Largefile alt-svc HSTS NTLM HTTPS-proxy threadsafe"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with ftp, http, etc.
Version: 8.5.0
Libs: -L${libdir} -lcurl 
Libs.private:  -lunwind -l:libunwind.a -lc -l:libunwind.a -lpthread F:/DevEcoStudioProject/manxia/entry/src/main/cpp/webdav/install-mbedtls-arm64/lib/libmbedtls.so F:/DevEcoStudioProject/manxia/entry/src/main/cpp/webdav/install-mbedtls-arm64/lib/libmbedx509.so F:/DevEcoStudioProject/manxia/entry/src/main/cpp/webdav/install-mbedtls-arm64/lib/libmbedcrypto.so F:/DevEcoStudioProject/manxia/entry/src/main/cpp/webdav/install-libssh2-arm64/lib/libssh2.a
Cflags: -I${includedir} 
