  BELOW = 'BELOW',
  WEAK = 'WEAK',
  LIKELY = 'LIKELY',
  STRONG = 'STRONG',
  EXACT = 'EXACT'
}

/**
 * 合并动作
 */
enum MergeAction {
  MERGE_TO_EXISTING = 'MERGE_TO_EXISTING',
  CREATE_NEW = 'CREATE_NEW',
  SKIP = 'SKIP'
}

/**
 * 重复原因
 */
