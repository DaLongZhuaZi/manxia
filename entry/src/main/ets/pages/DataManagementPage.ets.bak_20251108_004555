/**
 * 导入状态枚举
 */
enum ImportStatus {
  IDLE = 'idle',
  SELECTING = 'selecting',
  EXTRACTING = 'extracting',
  PARSING = 'parsing',
  PROCESSING = 'processing',
  IMPORTING = 'importing',
  COMPLETED = 'completed',
  ERROR = 'error'
}

/**
 * 导入进度信息接口
 */
interface ImportProgress {
  status: ImportStatus;
  message: string;
  progress: number; // 0-100
  currentFile?: string;
  totalFiles?: number;
  processedFiles?: number;
}

/**
 * 导入结果详情接口
 */
interface ImportResultDetail {
  fileName: string;
  success: boolean;
  errorMessage?: string;
  comicInfo?: ComicInfo;
  mangaId?: string;
