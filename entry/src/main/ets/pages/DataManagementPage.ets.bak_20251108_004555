  TITLE_EXACT = 'TITLE_EXACT',
  AUTHOR_EXACT = 'AUTHOR_EXACT',
  TITLE_SIMILAR = 'TITLE_SIMILAR',
  AUTHOR_SIMILAR = 'AUTHOR_SIMILAR',
