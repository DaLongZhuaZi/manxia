      case MergeMode.StrictNew:
        return '严格新建';
      case MergeMode.AutoRecommend:
        return '自动推荐';
      case MergeMode.ManualCustom:
        return '手动自定义';
      default:
        return '未知';
    }
  }

  private getMatchStrengthLabel(strength?: MatchStrength): string {
    if (!strength) {
      return '未知';
    }
    switch (strength) {
      case MatchStrength.BELOW:
        return '低于阈值';
      case MatchStrength.WEAK:
        return '较弱';
      case MatchStrength.LIKELY:
        return '可能';
      case MatchStrength.STRONG:
        return '强';
      case MatchStrength.EXACT:
        return '完全匹配';
      default:
        return '未知';
    }
  }

  private getMergeActionLabel(action?: MergeAction): string {
    if (!action) {
      return '未知';
    }
    switch (action) {
      case MergeAction.MERGE_TO_EXISTING:
        return '合并至已有';
      case MergeAction.CREATE_NEW:
        return '新建';
      case MergeAction.SKIP:
        return '跳过';
      default:
        return '未知';
    }
  }

  private getDuplicateReasonsLabel(reasons?: DuplicateReason[]): string {
    if (!reasons || reasons.length === 0) {
      return '无';
    }
    const labels: string[] = [];
    for (let i = 0; i < reasons.length; i++) {
      const reason: DuplicateReason = reasons[i];
      switch (reason) {
        case DuplicateReason.TITLE_EXACT:
          labels.push('标题完全相同');
          break;
        case DuplicateReason.AUTHOR_EXACT:
          labels.push('作者完全相同');
          break;
        case DuplicateReason.TITLE_SIMILAR:
          labels.push('标题相似');
          break;
        case DuplicateReason.AUTHOR_SIMILAR:
          labels.push('作者相似');
          break;
        case DuplicateReason.TAGS_OVERLAP:
          labels.push('标签重叠');
          break;
        default:
          labels.push('其他');
          break;
      }
    }
    return labels.join('、');
  }

  build() {
    HdsNavDestination() {
      Stack() {
        // 背景层
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background', this.themeState.currentTheme))
          .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
          .animation(ThemeAwareHelper.getThemeTransitionAnimation())

        // 内容层
        Scroll(this.scroller) {
          Column({ space: 24 }) {
            // [修复] 添加Blank占位符，防止内容与标题栏重叠
            Blank().height(TITLE_BAR_HEIGHT_MINI)
            
            // 主题切换按钮区域
            Row() {
              Blank().layoutWeight(1)
              ThemeToggle({
                themeManager: this.themeManager,
                showLabel: false,
                iconSize: 20
              })
            }
            .width('100%')
            .padding({ left: 20, right: 20 })

            // 页面标题
            Text('数据管理')
              .fontSize(24)
              .fontWeight(FontWeight.Bold)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
              .width('100%')
              .textAlign(TextAlign.Center)
              .margin({ bottom: 20 })

            // 功能说明
            Column({ space: 12 }) {
              Text('漫画文件导入')
                .fontSize(18)
                .fontWeight(FontWeight.Medium)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))

              Text('支持导入ZIP、CBZ、RAR、CBR格式的漫画压缩包，自动解析ComicInfo.xml元数据并导入到本地数据库。')
                .fontSize(14)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_secondary', this.themeState.currentTheme))
                .lineHeight(20)
            }
            .width('100%')
            .padding(16)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_secondary', this.themeState.currentTheme))
            .borderRadius(8)

            // 测试功能区域已移除

            // 文件选择区域
            Column({ space: 16 }) {
              Row() {
                Text('选择文件')
                  .fontSize(16)
                  .fontWeight(FontWeight.Medium)
                  .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
                  .layoutWeight(1)

                Text(`已选择: ${this.selectedFiles.length} 个文件`)
                  .fontSize(12)
                  .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              }
              .width('100%')

              AnimatedButton({
                text: '选择漫画文件',
                buttonWidth: '100%',
                buttonHeight: 48,
                onButtonClick: () => {
                  this.selectFiles();
                }
              })

              Column({ space: 4 }) {
                ForEach(this.selectedFiles.slice(0, 3), (file: string, index: number) => {
                  Text(`📁 ${this.getFileNameFromUri(file)}`)
                    .fontSize(12)
                    .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_secondary', this.themeState.currentTheme))
                    .width('100%')
                })

                Text(`... 还有 ${this.selectedFiles.length - 3} 个文件`)
                  .fontSize(12)
                  .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
                  .visibility(this.selectedFiles.length > 3 ? Visibility.Visible : Visibility.None)
              }
              .width('100%')
              .padding(8)
              .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('comp_background_tertiary', this.themeState.currentTheme))
              .borderRadius(4)
              .visibility(this.selectedFiles.length > 0 ? Visibility.Visible : Visibility.None)
            }
            .width('100%')
            .padding(16)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_secondary', this.themeState.currentTheme))
            .borderRadius(8)

            // 进度指示器
            this.buildProgressIndicator()

            // 导入操作区域
            Column({ space: 16 }) {
              AnimatedButton({
                text: '开始导入',
                buttonWidth: '100%',
                buttonHeight: 48,
                disabled: this.selectedFiles.length === 0 || 
                         (this.importProgress.status !== ImportStatus.IDLE && 
                          this.importProgress.status !== ImportStatus.COMPLETED && 
                          this.importProgress.status !== ImportStatus.ERROR),
                onButtonClick: () => {
                  this.startImport();
                }
              })

              AnimatedButton({
                text: '清空选择',
                buttonWidth: '100%',
                buttonHeight: 40,
                onButtonClick: () => {
                  this.selectedFiles = [];
                  this.importProgress = {
                    status: ImportStatus.IDLE,
                    message: '准备就绪',
                    progress: 0
                  };
                  this.showResults = false;
                  this.importResults = [];
                }
              })
              .visibility(this.selectedFiles.length > 0 ? Visibility.Visible : Visibility.None)
            }
            .width('100%')
            .padding(16)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_secondary', this.themeState.currentTheme))
            .borderRadius(8)

            // 导入结果
            this.buildImportResults()

            // 底部间距
            Blank().height(20)
          }
          .width('100%')
          .padding({ bottom: 20 })
        }
        .width('100%')
        .height('100%')
        .padding({ 
          top: this.statusBarHeight, 
          bottom: this.navigationBarHeight,
          left: 16,
          right: 16
        })
      }
    }
    .onReady((context: NavDestinationContext) => {
      logger.info(TAG, 'HdsNavDestination.onReady 已触发');
      this.pathStack = context.pathStack;
    })
    .backgroundColor(Color.Transparent)
  }
}

export { DataManagementPage };