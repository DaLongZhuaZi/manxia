      this.applySourceFeatureVisibility();
      
      logger.info(TAG, `�յ���ʼ�����ؼ���: ${this.searchKeyword}, contentType=${this.contentTypeFilter}, sourceType=${this.sourceTypeFilter}`);
      this.performSearch();
