  private showToast(message: string, duration: number = 2000): void {
    try {
      const toastConfig: ToastConfig = {
        message: message,
        duration: duration,
        bottom: 100
      };
      this.getUIContext().getPromptAction().showToast(toastConfig);
    } catch (error) {
      logger.warn(TAG, `Toast显示失败: ${message}`);
    }
  }

  /**
   * 显示更多选项菜单
   */
  private showMoreOptions(): void {
    try {
      this.getUIContext().getPromptAction().showActionMenu({
        title: '更多选项',
        buttons: [
          { text: '主题切换', color: '#007DFF' },
          { text: '设置', color: '#007DFF' },
          { text: '测试管理', color: '#007DFF' },
          { text: '关于应用', color: '#007DFF' }
        ]
      }, (err, data) => {
        if (err) {
          logger.error(TAG, '显示更多选项菜单失败', String(err));
          this.showToast('菜单显示失败');
          return;
        }
        
        switch (data.index) {
          case 0:
            this.themeManager.toggleTheme();
            this.showToast('主题已切换');
            break;
          case 1:
            this.currentTabIndex = TabIndex.SETTINGS;
            this.tabsController.changeIndex(this.currentTabIndex);
            break;
          case 2:
            this.pathStack.pushPath({ name: 'TestManagementPage' });
            break;
          case 3:
            this.showToast(`漫画阅读器 v${this.systemVersion}`);
            break;
        }
      });
    } catch (error) {
      logger.error(TAG, '显示更多选项菜单失败', String(error));
      this.showToast('菜单显示失败');
    }
  }

