            .width(80)
            .height(80)
            .objectFit(ImageFit.Cover)
            .borderRadius(8)
        }
        .width('100%')
        .height(120)
        .padding(16)
        .backgroundColor(item.backgroundColor)
        .borderRadius(12)
      })
    }
    .width('100%')
    .height(120)
    .autoPlay(true)
    .interval(4000)
    .indicator(
      new DotIndicator()
        .itemWidth(8)
        .itemHeight(8)
        .selectedItemWidth(16)
        .selectedItemHeight(8)
        .color(Color.White)
        .selectedColor(Color.White)
    )
    .onChange((index: number) => {
      this.currentBannerIndex = index;
    })
  }

