  /**
   * 打开漫画详情页
   */
  private openMangaDetail(manga: Manga) {
    try {
      const params: MangaDetailPageParams = {
        mangaId: manga.id
      };

      this.pathStack.pushPathByName('MangaDetailPage', params);
      logger.info(TAG, `打开漫画详情页: ${manga.title}`);
    } catch (error) {
      logger.error(TAG, '打开漫画详情页失败', error);
      this.showToast('打开漫画详情页失败');
    }
  }

  /**
   * 打开漫画阅读器
   */
  private async openMangaReader(manga: Manga) {
    try {
      // 基于阅读历史确定恢复目标
      let targetChapterId: string | undefined = undefined;
      let targetPageIndex: number = 0;

      const historyList = await this.dataService.getReadingHistory(200);
      for (let i: number = 0; i < historyList.length; i++) {
        const h = historyList[i];
        if (h.comicId === manga.id) {
          targetChapterId = h.chapterId;
          targetPageIndex = h.pageIndex;
          break;
        }
      }

      // 若没有历史记录或历史章节失效，则查询数据库中的第一章
      if (!targetChapterId) {
        const chapterInfos = await this.dataManager.getComicChapters(manga.id);
        if (chapterInfos && chapterInfos.length > 0) {
          const firstChapterId: string = chapterInfos[0].id;
          targetChapterId = firstChapterId;
          targetPageIndex = 0;
          logger.info(TAG, `无阅读历史，默认从第一章开始。chapterId=${String(targetChapterId)}`);
        } else {
          logger.warn(TAG, `漫画(${manga.title})未找到章节，无法进入阅读器`);
          this.showToast('未找到章节，无法进入阅读器');
          return;
        }
      } else {
        logger.info(TAG, `恢复阅读：chapterId=${String(targetChapterId)}, pageIndex=${String(targetPageIndex)}`);
      }

      const params: MangaReaderPageParams = {
        mangaId: manga.id,
        chapterId: targetChapterId,
        pageIndex: targetPageIndex,
        fromPage: 'MainMenuPage'
      } as MangaReaderPageParams;

      this.pathStack.pushPathByName('MangaReaderPage', params);
      logger.info(TAG, `打开漫画阅读器: ${manga.title}`);
    } catch (error) {
      const errMsg: string = error instanceof Error ? error.message : String(error);
      logger.error(TAG, '打开漫画阅读器失败', errMsg);
      this.showToast('打开漫画阅读器失败');
    }
  }

