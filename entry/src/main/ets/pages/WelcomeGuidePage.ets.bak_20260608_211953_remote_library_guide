                    .borderRadius(16)
                    .margin({ right: 8 })
                    .onClick(() => {
                      this.copySourceUrl();
                    })
                }
                .width('100%')
                .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_secondary', this.themeState.currentTheme))
                .borderRadius(8)
              }
              .width('100%')
              .padding({ left: 32, right: 32 })
              .margin({ bottom: 12 })
            }

            if (this.currentStep === GuideStep.IMAGE_SOURCE_GUIDE) {
              this.buildImageSourceGuideActionSection()
            }

            if (this.currentStep === GuideStep.BOOK_SOURCE_GUIDE) {
              this.buildBookSourceGuideActionSection()
            }

            if (this.currentStep === GuideStep.CUSTOM_EXPERIENCE) {
              this.buildCustomExperienceGuideSection()
            }

            if (this.currentStep === GuideStep.ANALYTICS_PERMISSION) {
              this.buildNotificationGuideSection()
            }

            if (this.currentStep === GuideStep.LIBRARY_INTRO) {
              this.buildPrivacyAndSfwGuideSection()
            }
          }
        }
        .justifyContent(FlexAlign.Center)
        .alignItems(HorizontalAlign.Center)
        .layoutWeight(1)
        .opacity(this.contentOpacity)
        .translate({ y: this.contentTranslateY })

        // 底部按钮区域
        Column({ space: 12 }) {
          // 主要操作按钮 - 暂时使用普通Button来排查AnimatedButton的问题
          Button(this.getCurrentStepContent().buttonText)
            .fontSize(16)
            .fontFamily(this.appFontFamily)
            .height(48)
            .width('80%')
            .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_white', this.themeState.currentTheme))
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
            .borderRadius(24)
            .enabled(!this.isAnimating)  // 动画期间禁用按钮
            .opacity(this.isAnimating ? 0.6 : 1.0)
            .onClick(() => {
              logger.info(TAG, `🔘 Button点击回调触发，当前步骤: ${this.currentStep}, 按钮文本: ${this.getCurrentStepContent().buttonText}`);
              this.handleNextStep();
            })

          // 下一步按钮（用于可导航步骤，允许不导航直接进入下一步）
          if (this.currentStep === GuideStep.DATA_IMPORT) {
            Text('下一步')
              .fontSize(14)
              .fontFamily(this.appFontFamily)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
              .margin({ top: 8 })
              .opacity(this.isAnimating ? 0.5 : 1.0)
              .enabled(!this.isAnimating)
              .onClick(() => {
                if (!this.isAnimating) {
                  this.handleNextStepSkipNavigation();
                }
              })
          }
        }
        .width('100%')
        .alignItems(HorizontalAlign.Center)
        .padding({ bottom: 32 })
      }
      .width('100%')
      .height('100%')
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
      .padding({
        top: this.statusBarHeight,
        bottom: this.navigationBarHeight
      })
    }
    .width('100%')
    .height('100%')
  }
}

export { WelcomeGuidePage };
