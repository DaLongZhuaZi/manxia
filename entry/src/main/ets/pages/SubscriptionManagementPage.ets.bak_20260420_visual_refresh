          .width('100%')
          .padding(12)
          .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('button_background', this.themeState.currentTheme))
          .borderRadius(8)
        }, (candidate: SubscriptionTargetPreviewCandidate, index: number): string => `${candidate.itemId}_${index}`)
      }
      .width('100%')
    }
    .width('100%')
  }

  build() {
    HdsNavDestination() {
      Stack() {
        SharedPageBackgroundLayer({
          defaultBackgroundColor: ThemeAwareHelper.getTestManagementThemedColor('background', this.themeState.currentTheme),
          mode: GlobalBackgroundLayerMode.IMMERSIVE
        })
          .width('100%')
          .height('100%')
          .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])

        Column({ space: 12 }) {
          Blank().height(SettingsPageTitleBarManager.getContentTopPadding(this.statusBarHeight))
          this.buildStatsCard()
          this.buildHintCard()

          if (this.isLoading) {
            Column({ space: 10 }) {
              LoadingProgress()
                .width(36)
                .height(36)
              Text('正在加载内容跟踪规则...')
                .fontSize(13)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_secondary', this.themeState.currentTheme))
            }
            .width('100%')
            .layoutWeight(1)
            .justifyContent(FlexAlign.Center)
            .alignItems(HorizontalAlign.Center)
          } else if (this.rules.length <= 0) {
            this.buildEmptyState()
          } else {
            List({ space: 12 }) {
              ForEach(this.rules, (rule: SubscriptionRule, index: number) => {
                ListItem() {
                  this.buildRuleListItem(rule, index)
                }
              }, (rule: SubscriptionRule): string => rule.id)
            }
            .width('100%')
            .height('100%')
            .layoutWeight(1)
            .padding({ left: 16, right: 16, bottom: 16 + this.navigationBarHeight })
            .scrollBar(BarState.Auto)
            .edgeEffect(EdgeEffect.Spring)
          }
        }
        .width('100%')
        .height('100%')
        .padding({ left: 16, right: 16, bottom: this.navigationBarHeight })
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])

        if (this.showCreateDialog) {
          this.buildCreateDialog()
        }
        if (this.showDeleteDialog) {
          this.buildDeleteDialog()
        }
        if (this.showPreviewDialog) {
          this.buildPreviewDialog()
        }

        SettingsImmersiveTitleBar({
          themeState: this.themeState,
          title: '统一内容跟踪',
          appFontFamily: this.appFontFamily,
          maxDirectActions: 3,
          actions: this.getActionItems()
        })
      }
      .width('100%')
      .height('100%')
    }
    .hideTitleBar(true)
    .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.TOP, LayoutSafeAreaEdge.BOTTOM])
    .backgroundColor(Color.Transparent)
  }
}
