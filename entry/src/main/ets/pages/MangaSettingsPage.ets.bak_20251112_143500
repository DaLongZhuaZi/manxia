          .justifyContent(FlexAlign.SpaceBetween)

          Slider({
            value: this.preloadPagesCount,
            min: 1,
            max: MAX_PRELOAD_PAGES,
            step: 1,
            style: SliderStyle.InSet
          })
            .blockColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
            .trackColor(ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme))
            .selectedColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
            .trackThickness(4)
            .onChange((value: number) => {
              this.setPreloadPagesCount(Math.round(value));
            })

          Text(`当前设置: 提前加载 ${this.preloadPagesCount} 页 (最大${MAX_PRELOAD_PAGES}页)`)
            .fontSize(12)
            .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
            .width('100%')
        }
        .width('100%')
      }
    }
    .width('100%')
    .padding(16)
    .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('panel_background', this.themeState.currentTheme))
    .borderRadius(12)
    .border({ width: 1, color: ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme) })
  }

  // 构建设置项：高级设置（可展开）
  @Builder
  buildAdvancedSettings() {
    Column({ space: 16 }) {
      Row() {
        Text('高级设置')
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          .layoutWeight(1)
        
        Text(this.advancedSettingsExpanded ? '收起' : '展开')
          .fontSize(14)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
          .onClick(() => {
            this.advancedSettingsExpanded = !this.advancedSettingsExpanded;
          })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 16 })

      if (this.advancedSettingsExpanded) {
        Column({ space: 16 }) {
          // 屏幕亮度
          Column({ space: 8 }) {
            Row() {
              Text('屏幕亮度')
                .fontSize(14)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
              Text(`${this.readingSettings.brightness}%`)
                .fontSize(14)
                .fontWeight(FontWeight.Bold)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
            }
            .width('100%')
            .justifyContent(FlexAlign.SpaceBetween)

            Slider({
              value: this.readingSettings.brightness,
              min: 0,
              max: 100,
              step: 1,
              style: SliderStyle.InSet
            })
              .blockColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
              .trackColor(ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme))
              .selectedColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
              .trackThickness(4)
              .onChange((value: number) => {
                this.setBrightness(Math.round(value));
              })
          }
          .width('100%')

          // 页面间距
          Column({ space: 8 }) {
            Row() {
              Text('页面间距')
                .fontSize(14)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
              Text(`${this.readingSettings.pageSpacing}px`)
                .fontSize(14)
                .fontWeight(FontWeight.Bold)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
            }
            .width('100%')
            .justifyContent(FlexAlign.SpaceBetween)

            Slider({
              value: this.readingSettings.pageSpacing,
              min: 0,
              max: 50,
              step: 1,
              style: SliderStyle.InSet
            })
              .blockColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
              .trackColor(ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme))
              .selectedColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
              .trackThickness(4)
              .onChange((value: number) => {
                this.setPageSpacing(Math.round(value));
              })
          }
          .width('100%')

          // 自动翻页间隔
          Column({ space: 8 }) {
            Row() {
              Text('自动翻页间隔')
                .fontSize(14)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
              Text(this.readingSettings.autoPageTurnInterval === 0 ? '禁用' : `${this.readingSettings.autoPageTurnInterval}秒`)
                .fontSize(14)
                .fontWeight(FontWeight.Bold)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
            }
            .width('100%')
            .justifyContent(FlexAlign.SpaceBetween)

            Slider({
              value: this.readingSettings.autoPageTurnInterval,
              min: 0,
              max: 60,
              step: 1,
              style: SliderStyle.InSet
            })
              .blockColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
              .trackColor(ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme))
              .selectedColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
              .trackThickness(4)
              .onChange((value: number) => {
                this.setAutoPageTurnInterval(Math.round(value));
              })
            
            Text('设置为0将禁用自动翻页')
              .fontSize(12)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              .width('100%')
          }
          .width('100%')
        }
        .width('100%')
        .padding({ left: 16, right: 16, bottom: 16 })
      }
    }
    .width('100%')
    .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('panel_background', this.themeState.currentTheme))
    .borderRadius(12)
    .border({ width: 1, color: ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme) })
  }

  // 构建设置项：滤镜设置（可展开）
  @Builder
  buildFilterSettings() {
    Column({ space: 16 }) {
      Row() {
        Text('滤镜设置')
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          .layoutWeight(1)
        
        Toggle({ type: ToggleType.Switch, isOn: this.readingSettings.filterSettings.enabled })
          .selectedColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
          .switchPointColor(ThemeAwareHelper.getTestManagementThemedColor('button_text_primary', this.themeState.currentTheme))
          .onChange((isOn: boolean) => {
            this.setFilterEnabled(isOn);
          })
        
        Text(this.filterSettingsExpanded ? '收起' : '展开')
          .fontSize(14)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
          .margin({ left: 12 })
          .onClick(() => {
            this.filterSettingsExpanded = !this.filterSettingsExpanded;
          })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 16 })
      // 根据需求：默认展开，但内部不显示任何内容
      if (this.filterSettingsExpanded) {
        Column() {}
          .width('100%')
          .padding({ left: 16, right: 16, bottom: 16 })
      }
    }
    .width('100%')
    .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('panel_background', this.themeState.currentTheme))
    .borderRadius(12)
    .border({ width: 1, color: ThemeAwareHelper.getTestManagementThemedColor('panel_border', this.themeState.currentTheme) })
  }

  // 构建操作按钮区域
  @Builder
  buildActionButtons() {
    Column({ space: 12 }) {
      // 第一行：主要操作按钮
      Row({ space: 12 }) {
        Column() {
          Button({ stateEffect: true }) {
            Text('重置默认')
              .fontSize(16)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          }
            .width('100%')
            .height(44)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('button_warning', this.themeState.currentTheme))
            .borderRadius(12)
            .onClick(() => {
              this.readingSettings = DEFAULT_READING_SETTINGS;
              this.preloadPagesCount = 3;
              this.preloadAllPages = false;
              logger.info(TAG, '已重置为默认设置');
            })
        }.width('30%')

        Column() {
          Button({ stateEffect: true }) {
            Text('保存')
              .fontSize(16)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          }
            .width('100%')
            .height(44)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme))
            .borderRadius(12)
            .onClick(() => this.saveSettings())
        }.layoutWeight(1)

        Column() {
          Button({ stateEffect: true }) {
            Text('保存并返回')
              .fontSize(16)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          }
            .width('100%')
            .height(44)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
            .borderRadius(12)
            .onClick(() => this.saveAndGoBack())
        }.layoutWeight(1)
      }
      .width('100%')

      // 第二行：删除漫画按钮
      Row() {
        Button({ stateEffect: true }) {
          Text('删除漫画')
            .fontSize(16)
            .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_white', this.themeState.currentTheme))
        }
          .width('100%')
          .height(44)
          .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('button_danger', this.themeState.currentTheme))
          .borderRadius(12)
          .onClick(() => this.showMangaDeleteConfirmDialog())
      }
      .width('100%')
    }
    .width('100%')
    .padding({ top: 16, bottom: 24 })
  }

  // 构建删除确认对话框
  @Builder
  buildDeleteConfirmDialog() {
    Stack({ alignContent: Alignment.Center }) {
      // 半透明遮罩
      Column()
        .width('100%')
        .height('100%')
        .backgroundColor('#80000000')
        .onClick(() => {
          if (!this.isDeleting) {
            this.showDeleteConfirmDialog = false;
          }
        })

      // 确认对话框
      Column({ space: 20 }) {
        Text('确认删除')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))

        Column({ space: 12 }) {
          Text('您确定要删除这部漫画吗？')
            .fontSize(16)
            .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          
          if (this.currentManga) {
            Text(this.currentManga.title)
              .fontSize(14)
              .fontWeight(FontWeight.Medium)
              .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
              .maxLines(2)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
          }
          
          Text('此操作将删除漫画的所有数据和文件，包括阅读进度、书签等，且不可恢复。')
            .fontSize(13)
            .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
            .lineHeight(20)
        }
        .width('100%')

        Row({ space: 12 }) {
          Column() {
            Button({ stateEffect: true }) {
              Text('取消')
                .fontSize(16)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
            }
              .width('100%')
              .height(44)
              .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('button_secondary', this.themeState.currentTheme))
              .borderRadius(8)
              .enabled(!this.isDeleting)
              .onClick(() => {
                if (!this.isDeleting) {
                  this.showDeleteConfirmDialog = false;
                }
              })
          }.layoutWeight(1)

          Column() {
            Button({ stateEffect: true }) {
              Text(this.isDeleting ? '删除中...' : '确认删除')
                .fontSize(16)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_white', this.themeState.currentTheme))
            }
            .width('100%')
            .height(44)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('button_danger', this.themeState.currentTheme))
            .borderRadius(8)
            .enabled(!this.isDeleting)
            .onClick(() => {
              if (!this.isDeleting) {
                this.deleteManga();
              }
            })
          }.layoutWeight(1)
        }
        .width('100%')
      }
      .width('85%')
      .padding(24)
      .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('panel_background', this.themeState.currentTheme))
      .borderRadius(16)
      .shadow({ radius: 24, color: '#40000000', offsetX: 0, offsetY: 4 })
    }
    .width('100%')
    .height('100%')
    .zIndex(2000)
  }

  build() {
    HdsNavDestination() {
      Stack() {
        // 背景层
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_dark', this.themeState.currentTheme))

        // 内容层
        Scroll(this.scroller) {
          Column({ space: 16 }) {
            Blank().height(TITLE_BAR_HEIGHT_MINI)

            // 漫画信息区域
            this.buildMangaInfoSection()
            
            // 阅读方向设置
            this.buildReadingDirectionSettings()
            
            // 阅读模式设置
            this.buildReadingModeSettings()
            
            // 基础设置
            this.buildBasicSettings()
            
            // 预加载设置
            this.buildPreloadSettings()
            
            // 高级设置
            this.buildAdvancedSettings()
            
            // 滤镜设置
            this.buildFilterSettings()
            
            // 操作按钮
            this.buildActionButtons()
          }
          .width('100%')
          .constraintSize({ maxWidth: this.responsive_maxContentWidth }) // 响应式最大宽度
          .padding({ left: this.responsive_contentPadding, right: this.responsive_contentPadding, bottom: 40 })
        }
        .width('100%')
        .height('100%')
        .align(Alignment.TopStart) // 响应式：大屏居中对齐
        .edgeEffect(EdgeEffect.Spring)
        .scrollBar(BarState.Auto)

        // 删除确认对话框
        if (this.showDeleteConfirmDialog) {
          this.buildDeleteConfirmDialog()
        }
      }
    }
    .titleBar({
      padding: {
        start: LengthMetrics.vp(16),
        end: LengthMetrics.vp(16)
      },
      style: {
        scrollEffectOpts: {
          enableScrollEffect: true,
          scrollEffectType: ScrollEffectType.COMMON_BLUR,
          blurEffectiveStartOffset: LengthMetrics.vp(0),
          blurEffectiveEndOffset: LengthMetrics.vp(TITLE_BAR_HEIGHT_MINI)
        },
        originalStyle: {
          backgroundStyle: { backgroundColor: Color.Transparent },
          contentStyle: {
            titleStyle: { mainTitleColor: ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme) },
            backIconStyle: { backgroundColor: ThemeAwareHelper.getTestManagementThemedColor('comp_background_tertiary', this.themeState.currentTheme), iconColor: ThemeAwareHelper.getTestManagementThemedColor('icon_primary', this.themeState.currentTheme) }
          }
        },
        scrollEffectStyle: {
          backgroundStyle: {
            backgroundColor: this.themeState.currentTheme === ThemeType.DARK ? '#E61A1A1A' : '#E6F5F5F5'
          },
          contentStyle: {
            titleStyle: { mainTitleColor: ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme) },
            backIconStyle: { backgroundColor: ThemeAwareHelper.getTestManagementThemedColor('comp_background_tertiary', this.themeState.currentTheme), iconColor: ThemeAwareHelper.getTestManagementThemedColor('icon_primary', this.themeState.currentTheme) }
          }
        }
      },
      content: {
        title: { mainTitle: '漫画设置' },
        menu: {
          value: [{
            content: {
              label: '切换主题',
              icon: $r('app.media.SculptureLargeAnimalistA'),
              isEnabled: true,
              action: () => { this.themeManager.toggleTheme(); }
            }
          }]
        }
      }
    })
    .onReady((context: NavDestinationContext) => {
      this.onReady(context);
    })
    .backgroundColor(Color.Transparent)
  }
}

export { MangaSettingsPage }