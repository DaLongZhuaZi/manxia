    eventBus.subscribe(GameEvent.NOVEL_LIST_REFRESH_NEEDED, (payload: IEventPayload) => {
      logger.info(TAG, `收到小说列表刷新事件，重新加载小说列表`);
      this.loadNovelList();
    });

    // 注册隐私模式监听器
    this.privacyModeListener = (isPrivacy: boolean) => {
      logger.info(TAG, `隐私模式状态变化: ${isPrivacy}`);
      this.isPrivacyMode = isPrivacy;
      if (isPrivacy) {
        // 进入隐私模式：保存当前视图模式
        this.prePrivacyViewMode = this.libraryViewMode;
        this.showCategoryDetail = false;
        this.selectedShelf = null;
        this.isShelfEditMode = false;
        logger.info(TAG, '[隐私书架] 已解锁，书架视图将显示置顶隐私书架');
      } else {
        // 退出隐私模式：恢复之前的视图模式
        this.libraryViewMode = this.prePrivacyViewMode;
        this.showCategoryDetail = false;
        this.selectedShelf = null;
      }
      // 静默刷新书库内容（增量更新，避免闪烁）
      this.silentRefreshLibrary();
      this.loadNovelList();
    };
    this.privacyModeManager.addListener(this.privacyModeListener);

    // 注册SFW模式监听器，实现实时刷新
    this.sfwModeListener = (enabled: boolean) => {
      logger.info(TAG, `SFW模式切换: ${enabled}, 立即刷新页面`);
      // 根据当前标签页刷新对应数据
      // 刷新当前Tab
      switch (this.currentTabIndex) {
        case TabIndex.HOME:
          this.loadRecentReadingList(); // 重新加载最近阅读（包含NSFW过滤）
          break;
        case TabIndex.LIBRARY:
          this.applyLibraryFilter(); // 重新应用筛选，包含NSFW过滤
          break;
        case TabIndex.DISCOVER:
          this.applyDiscoverFilter(); // 发现页也需要过滤
          break;
        case TabIndex.SOURCE:
          // 图源页面也需要刷新
          this.loadSources();
          break;
        case TabIndex.BOOK_SOURCE:
          // 书源页面也需要刷新NSFW过滤
          this.filterBookSourceList(this.bookSourceSearchKeyword);
          break;
