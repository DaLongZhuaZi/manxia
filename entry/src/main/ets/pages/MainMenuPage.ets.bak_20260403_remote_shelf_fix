      contentTypes: [ShelfContentType.MANGA, ShelfContentType.EBOOK, ShelfContentType.NOVEL],
      icon: '🔒',
      color: '#1D2433',
      order: -999,
      isSystem: true,
      createTime: 0,
      updateTime: 0,
      dynamicFilter: {
        authors: [],
        tags: [],
        titleKeywords: [],
        sourceNames: [],
        customKeywords: [],
        nsfwFilter: 'all'
      }
