        // 单选
        Radio({ value: contentType, group: 'contentType' })
          .checked(this.newShelfContentTypes.includes(contentType))
          .onChange((isChecked: boolean) => {
            if (isChecked) {
              this.newShelfContentTypes = [contentType];
            }
          })
