  /**
   * 获取有效的电子书封面路径
   * 支持：APP沙箱目录、Download目录、网络URL等多种来源
   * [新增] 专门处理电子书封面路径的多种情况
   */
  private getValidEBookCoverPath(ebook: EBook): string {
    const raw = this.getEBookCoverPath(ebook);
    if (!raw || raw.length === 0) {
      return '';
    }

    if (raw.startsWith('http://') || raw.startsWith('https://')) {
      return raw;
    }

    if (raw.startsWith('file://')) {
      return raw;
    }

    if (raw.startsWith('app.media.') || raw.startsWith('$r(')) {
      logger.debug('MainMenuPage', `电子书封面为资源引用，跳过路径转换: ${raw}`);
      return '';
    }

    return `file://${raw}`;
  }

  private getEBookTransitionCoverPath(ebook: EBook): string {
    const raw = this.getEBookCoverPath(ebook);
    if (!raw || raw.length === 0) {
      return '';
    }

    if (raw.startsWith('app.media.')) {
      logger.debug('MainMenuPage', `电子书封面为资源引用，直接传递给过渡动画: ${raw}`);
      return raw;
    }

    if (raw.startsWith('$r(')) {
      logger.warn('MainMenuPage', `电子书封面为未解析资源表达式，无法用于过渡动画: ${raw}`);
      return '';
    }

    return this.getValidEBookCoverPath(ebook);
  }


