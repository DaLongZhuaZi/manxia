  /**
   * 检查图源更新
   */
  private async checkSourceUpdates(): Promise<void> {
    try {
      // 检查是否启用了图源功能并导入了仓库
      const repoUrl = this.sourceUpdateManager.getRepoUrl();
      if (!repoUrl || repoUrl.length === 0) {
        logger.debug(TAG, '未设置图源仓库，跳过更新检查');
        return;
      }

      // 初始化更新管理器
      const context = this.getUIContext().getHostContext() as common.Context;
      if (context) {
        await this.sourceUpdateManager.initialize(context);
      }

      // 检查更新
      const result = await this.sourceUpdateManager.checkForUpdates();
      this.hasSourceUpdate = result.hasUpdate;
      
      if (result.hasUpdate) {
        logger.info(TAG, `发现图源更新: ${result.newSources.length}个新图源, ${result.updatedSources.length}个更新`);
      }
    } catch (error) {
      logger.error(TAG, `检查图源更新失败: ${String(error)}`);
    }
  }

  /**
   * 快速同步图源仓库（用于更新检查后的一键同步）
   */
  private async quickSyncSourceRepository(): Promise<void> {
    try {
      this.showToast('正在同步图源仓库...');
      const success = await this.sourceUpdateManager.syncRepository();
      
      if (success) {
        const repoUrl = this.sourceUpdateManager.getRepoUrl();
        if (repoUrl && repoUrl.length > 0) {
          await this.markRepositoryCommitVersion(repoUrl);
        }
        this.hasSourceUpdate = false;
        await this.refreshSources();
        this.showToast('图源仓库同步完成');
      } else {
        this.showToast('同步失败，请检查网络连接');
      }
    } catch (error) {
      logger.error(TAG, `同步图源仓库失败: ${String(error)}`);
      this.showToast('同步失败');
    }
  }

  /**
   * 同步成功后标记当前仓库提交版本
   */
  private async markRepositoryCommitVersion(url: string): Promise<void> {
    try {
      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
      if (!context) {
        logger.warn(TAG, '无法获取上下文，跳过图源仓库版本标记');
        return;
      }
      await this.versionHistoryManager.initialize(context as common.Context);
      const marker = await this.versionHistoryManager.markRepositoryVersionByUrl(url);
      if (marker) {
        logger.info(TAG, `已记录图源仓库提交版本: ${marker.name} @ ${marker.commitShortSha}`);
      }
    } catch (error) {
      logger.warn(TAG, `记录图源仓库提交版本失败: ${String(error)}`);
    }
  }

  /**
   * 查找已保存仓库中是否存在漫匣图源仓库
   */
  private findManxiaSourceRepository(): SavedRepository | null {
    for (const repo of this.savedRepositories) {
      const candidates: string[] = [];
      if (repo.url) {
        candidates.push(repo.url);
      }
      if (repo.originalUrl) {
        candidates.push(repo.originalUrl);
      }
      if (repo.lastEffectiveUrl) {
        candidates.push(repo.lastEffectiveUrl);
      }

      for (const candidateUrl of candidates) {
        if (this.versionHistoryManager.isManxiaExtensionsRepositoryUrl(candidateUrl)) {
          return repo;
        }
      }
    }
    return null;
  }

  /**
   * 应用启动阶段：仅检查并自动更新漫匣图源仓库
   */
  private async checkAndAutoUpdateManxiaSourceRepository(): Promise<void> {
    try {
      const manxiaRepo = this.findManxiaSourceRepository();
      if (!manxiaRepo) {
        logger.debug(TAG, '未检测到漫匣图源仓库，跳过自动更新检查');
        return;
      }

      const checkResult: VersionRepositoryUpdateCheckResult = await this.versionHistoryManager.checkManxiaExtensionsRepositoryUpdate();
      if (!checkResult.canCheck) {
        logger.warn(TAG, `漫匣图源仓库更新检查不可用: ${checkResult.errorMessage}`);
        return;
      }

      const repoUrl = (manxiaRepo.originalUrl && manxiaRepo.originalUrl.length > 0)
        ? manxiaRepo.originalUrl
        : manxiaRepo.url;

      // 首次接入没有本地提交版本标记时，先建立基线
      if (!checkResult.localMarker) {
        logger.info(TAG, `首次建立漫匣图源仓库版本基线: key=${MANXIA_EXTENSIONS_REPOSITORY_KEY}`);
        await this.markRepositoryCommitVersion(repoUrl);
        return;
      }

      if (!checkResult.hasUpdate) {
        logger.debug(TAG, '漫匣图源仓库提交无新版本');
        return;
      }

      const localSha = checkResult.localMarker.commitShortSha;
      const remoteSha = checkResult.latestCommit ? checkResult.latestCommit.shortSha : 'unknown';
      logger.info(TAG, `检测到漫匣图源仓库更新: ${localSha} -> ${remoteSha}`);

      const syncResult = await this.repositoryManager.syncRepositoryFromUrl(repoUrl, manxiaRepo.name);
      if (!syncResult.success) {
        logger.warn(TAG, `漫匣图源仓库自动更新失败: ${syncResult.message}`);
        return;
      }

      logger.info(TAG, `漫匣图源仓库自动更新完成: ${syncResult.message}`);
      await this.markRepositoryCommitVersion(repoUrl);
      await this.loadSavedRepositories();
      await this.loadSources();
    } catch (error) {
      logger.error(TAG, `自动更新漫匣图源仓库失败: ${String(error)}`);
    }
  }

  /**
   * 解析并修复仓库URL
   * 自动处理空格、换行等情况，拼接完整的URL
   */
  private parseAndFixRepoUrl(input: string): string {
    if (!input) return '';
    
    // 移除所有空格、换行、制表符
    let cleaned = input.replace(/[\s\r\n\t]+/g, '');
    
    // 如果不是http或https开头，直接返回清理后的内容
    if (!cleaned.startsWith('http://') && !cleaned.startsWith('https://')) {
      return cleaned;
    }
    
    // 检查是否以index.min.json或index.main.json结尾
    if (cleaned.endsWith('index.min.json') || cleaned.endsWith('index.main.json')) {
      return cleaned;
    }
    
    // 尝试在清理后的字符串中查找index.min.json或index.main.json
    const minJsonIndex = cleaned.indexOf('index.min.json');
    const mainJsonIndex = cleaned.indexOf('index.main.json');
    
    if (minJsonIndex !== -1) {
      // 截取到index.min.json结束
      return cleaned.substring(0, minJsonIndex + 'index.min.json'.length);
    }
    
    if (mainJsonIndex !== -1) {
      // 截取到index.main.json结束
      return cleaned.substring(0, mainJsonIndex + 'index.main.json'.length);
    }
    
    // 如果没有找到特定结尾，返回清理后的URL
    return cleaned;
  }

  /**
   * 导入图源
   */
  private async importSource(): Promise<void> {
    try {
      // 获取UIAbilityContext
      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
      if (!context) {
        this.showToast('无法获取应用上下文');
        logger.error(TAG, '无法获取UIAbilityContext');
        return;
      }

      // 创建文档选择器
      const documentPicker = new picker.DocumentViewPicker(context);
      
      // 设置选择选项 - 只允许选择JSON文件
      const selectOptions: picker.DocumentSelectOptions = {
        maxSelectNumber: 1, // 一次只能选择一个图源文件
        fileSuffixFilters: ['.json'], // 只允许选择JSON文件
      };

      logger.info(TAG, '打开文件选择器，选择图源JSON文件');
      
      // 打开文件选择器
      const selectResult = await documentPicker.select(selectOptions);
      
      if (!selectResult || !selectResult.length || selectResult.length === 0) {
        logger.info(TAG, '用户取消了文件选择');
        return;
      }

      const fileUri = selectResult[0];
      logger.info(TAG, `用户选择了文件: ${fileUri}`);
      
      this.showToast('开始导入图源...');
      
      // 读取文件内容
      const file = fs.openSync(fileUri, fs.OpenMode.READ_ONLY);
      const buffer = new ArrayBuffer(1024 * 1024); // 1MB缓冲区
      const readLen = fs.readSync(file.fd, buffer);
      fs.closeSync(file);
      
      // 使用TextDecoder正确解码UTF-8
      const uint8Array = new Uint8Array(buffer, 0, readLen);
      const decoder = new util.TextDecoder('utf-8', { ignoreBOM: true });
      const jsonContent = decoder.decode(uint8Array);
      
      logger.debug(TAG, `读取到JSON内容，长度: ${jsonContent.length}`);
      
      // 导入图源
      const result = await this.sourceManager.importFromJSON(jsonContent);
      
      if (result.success) {
        this.showToast('图源导入成功！');
        logger.info(TAG, '图源导入成功');
        await this.loadSources();
      } else {
        this.showToast(`导入失败: ${result.error || '未知错误'}`);
        logger.error(TAG, `图源导入失败: ${result.error}`);
      }
    } catch (error) {
      logger.error(TAG, '导入图源失败', String(error));
      this.showToast('导入图源失败，请检查文件格式');
    }
  }

