  /**
   * 显示删除漫画确认对话框
   */
  private showDeleteMangaDialog(mangaId: string): void {
    const manga = this.findLibraryMangaById(mangaId);
    if (!manga) {
      logger.error(TAG, `未找到漫画ID为 ${mangaId} 的漫画`);
      this.resetSwipeState();
      return;
    }

    if (this.isRemoteProviderManga(manga)) {
      if (manga.sourceInfo?.providerType === 'komga') {
        this.showToast('Komga 内容需在服务器侧管理，当前不支持从主书库删除');
        this.resetSwipeState();
        return;
      }

      this.getUIContext().showAlertDialog({
        title: '移除远程漫画',
        message: `确定要将《${manga.title}》从 Suwayomi 书库移除吗？`,
        autoCancel: true,
        alignment: DialogAlignment.Center,
        primaryButton: {
          value: '取消',
          action: () => {
            this.resetSwipeState();
          }
        },
        secondaryButton: {
          value: '移除',
          fontColor: ThemeAwareHelper.getTestManagementThemedColor('button_danger', this.themeState.currentTheme),
          action: async () => {
            try {
              const removed = await this.remoteLibraryBridge.removeFromLibrary(manga);
              if (!removed) {
                this.showToast('移除失败');
                this.resetSwipeState();
                return;
              }

              await this.silentRefreshLibrary(true);
              this.showToast('已从远程书库移除');
              this.resetSwipeState();
            } catch (error) {
              logger.error(TAG, '移除远程漫画失败', String(error));
              this.showToast('移除失败');
              this.resetSwipeState();
            }
          }
        }
      });
      return;
    }

    logger.info(TAG, `显示删除漫画确认对话框: ${manga.title} (ID: ${mangaId})`);

    // 显示确认对话框
    this.getUIContext().showAlertDialog({
      title: '删除漫画',
      message: `确定要删除漫画"${manga.title}"吗？\n\n此操作将删除该漫画的所有数据和文件，且不可恢复。`,
      autoCancel: true,
      alignment: DialogAlignment.Center,
      primaryButton: {
        value: '取消',
        action: () => {
          logger.info(TAG, '用户取消删除漫画');
          this.resetSwipeState();
        }
      },
      secondaryButton: {
        value: '删除',
        fontColor: ThemeAwareHelper.getTestManagementThemedColor('button_danger', this.themeState.currentTheme),
        action: async () => {
          try {
            logger.info(TAG, `开始删除漫画: ${mangaId}`);
            await this.dataManager.deleteComic(mangaId);

            this.animateLibraryCollectionLayout(() => {
              for (let i: number = 0; i < this.mangaList.length; i++) {
                if (this.mangaList[i].id === mangaId) {
                  this.mangaList.splice(i, 1);
                  break;
                }
              }
              this.incrementalUpdateMangaList(this.pdfEbookList,
                this.mangaList.filter((item: Manga) => item.contentType === 'ebook'));
              void this.applyLibraryFilter();
              this.applyEBookFilter();
            });

            eventBus.publish(GameEvent.MANGA_DELETED, new MangaDeletedPayload(mangaId));

            this.showToast('漫画已删除');
            logger.info(TAG, `漫画删除成功: ${mangaId}`);
            this.resetSwipeState();
          } catch (error) {
            logger.error(TAG, '删除漫画失败', String(error));
            this.showToast('删除失败');
            this.resetSwipeState();
          }
        }
      }
    });
  }


