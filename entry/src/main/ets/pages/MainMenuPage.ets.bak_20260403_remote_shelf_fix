  private buildDynamicMainMenuGuideFlow(): AppGuideFlowDefinition {
    const visibleTabs = this.getVisibleTabsForGuide();
    const steps: AppGuideStep[] = [];
    const orderedTabTitles = visibleTabs.map((config: TabConfig) => config.title).join('、');
    const introPageId = this.getCurrentMainGuidePageId();

    steps.push({
      id: 'main_bottom_bar_intro',
      pageId: introPageId,
      anchorId: this.getCurrentBottomBarGuideAnchorId(),
      title: '这是你当前实际启用的底栏标签',
      message: orderedTabTitles.length > 0
        ? `我会严格按照你现在的底栏配置顺序介绍：${orderedTabTitles}。先定位整个底栏，再逐个说明每个标签页的作用。`
        : '我会先定位当前底栏，再逐个说明每个标签页的作用。',
      cardPosition: 'top',
      nextButtonText: '继续查看'
    });

    for (const config of visibleTabs) {
      steps.push({
        id: `main_tab_${config.index}`,
        pageId: this.mapTabIndexToGuidePageId(config.index),
        anchorId: this.getGuideTabAnchorId(config.index),
        title: this.getMainMenuTabGuideTitle(config),
        message: this.getMainMenuTabGuideMessage(config),
        cardPosition: 'top'
      });
    }

    for (const item of this.getMainMenuSettingGuideItems()) {
      steps.push({
        id: `main_settings_${item.anchorId}`,
        pageId: AppGuidePageId.MAIN_SETTINGS,
        anchorId: item.anchorId,
        title: item.guideTitle,
        message: item.guideMessage,
        cardPosition: 'top'
      });
    }

    if (steps.length > 0) {
      steps[steps.length - 1].nextButtonText = '完成';
    }

    return {
      id: AppGuideFlowId.MAIN_MENU_CORE,
      title: '主页面与入口引导',
      description: '按当前真实底栏顺序介绍主页面标签，并继续介绍管理标签页里当前显示的核心入口。',
      autoStartPageId: AppGuidePageId.MAIN_LIBRARY,
      helpCenterReplayEnabled: true,
      steps: steps
    };
  }

  private ensureGuideTabVisible(pageId: AppGuidePageId): boolean {
    if (!this.isMainGuidePage(pageId)) {
      return false;
    }
    const targetTab = this.mapGuidePageIdToTabIndex(pageId);
    if (this.currentTabIndex === targetTab) {
      return false;
    }
    const actualIndex = this.getActualTabsIndexForTabIndex(targetTab);
    if (actualIndex < 0) {
      logger.warn(TAG, `引导目标标签当前不可见: 标签索引=${targetTab}`);
      return false;
    }
    if (!this.useTopTabsNavigation) {
      this.resetBottomBarScrollState();
      this.bottomBarOffsetY = 0;
    }
    this.changeMainContentToActualIndex(actualIndex);
    logger.info(TAG, `引导切换主页面标签: 标签索引=${targetTab}`);
    return true;
  }

  private resolveGuideHighlightRect(anchorId?: string, borderRadius: number = 18): GuideHighlightRect | null {
    if (!anchorId || anchorId.length <= 0) {
      return null;
    }
    try {
      const candidateIds: string[] = anchorId === 'guide_main_bottom_bar'
        ? ['guide_main_bottom_bar_horizontal', 'guide_main_bottom_bar_top', 'guide_main_bottom_bar_side']
        : [anchorId];
      for (const candidateId of candidateIds) {
        const rect = resolveGuideHighlightRectInRoot(
          this.uiContext,
          candidateId,
          borderRadius,
          MAIN_MENU_GUIDE_ROOT_ID
        );
        if (rect) {
          return {
            x: rect.x,
            y: rect.y + MAIN_MENU_GUIDE_HIGHLIGHT_Y_COMPENSATION_VP,
            width: rect.width,
            height: rect.height,
            borderRadius: rect.borderRadius
          };
        }
      }
      return null;
    } catch (error) {
      logger.warn(TAG, `获取引导锚点位置失败: 锚点=${anchorId}, 错误=${String(error)}`);
      return null;
    }
  }

  private alignSettingsGuideViewport(anchorId?: string): boolean {
    if (!anchorId || !anchorId.startsWith('guide_main_setting_')) {
      return false;
    }
    try {
      const componentUtils = this.uiContext.getComponentUtils();
      const anchorRect = componentUtils.getRectangleById(anchorId);
      const viewportRect = componentUtils.getRectangleById('guide_main_settings_scroll');
      if (!anchorRect || !viewportRect ||
        Number(anchorRect.size.width) <= 0 || Number(anchorRect.size.height) <= 0 ||
        Number(viewportRect.size.width) <= 0 || Number(viewportRect.size.height) <= 0) {
        return false;
      }

      const viewportTop = px2vp(Number(viewportRect.windowOffset.y));
      const viewportHeight = px2vp(Number(viewportRect.size.height));
      const anchorTop = px2vp(Number(anchorRect.windowOffset.y));
      const desiredAnchorTop = viewportTop + Math.max(104, Math.min(156, viewportHeight * 0.28));
      const currentOffsetY = Number(this.settingsScroller.currentOffset()?.yOffset ?? 0);
      const targetOffsetY = Math.max(0, currentOffsetY + (anchorTop - desiredAnchorTop));

      if (Math.abs(targetOffsetY - currentOffsetY) < 12) {
        return false;
      }

      this.settingsScroller.scrollTo({
        xOffset: 0,
        yOffset: targetOffsetY,
        animation: { duration: 320 }
      });
      return true;
    } catch (_error) {
      const topPaddingVp: number = this.useTopTabsNavigation && this.getEffectiveTabletTopBarPosition() === 'top'
        ? this.BOTTOM_BAR_HEIGHT + this.TABLET_TOP_BAR_VERTICAL_MARGIN + 20
        : 16;
      const bottomPaddingVp: number = this.useTopTabsNavigation
        ? this.navigationBarHeight + 28
        : this.BOTTOM_BAR_HEIGHT + this.BOTTOM_BAR_MARGIN_BOTTOM + 20;
      const scrollResult = ensureGuideAnchorVisibleInScroller(
        this.uiContext,
        this.settingsScroller,
        anchorId,
        'guide_main_settings_scroll',
        topPaddingVp,
        bottomPaddingVp,
        280
      );
      if (!scrollResult.available) {
        return false;
      }
      return scrollResult.scrolled;
    }
  }

  private async refreshMainMenuGuide(trigger: string): Promise<void> {
    if (this.fromGuide && !this.welcomeGuideManager.isGuideCompleted()) {
      this.appGuideStep = null;
      this.appGuideHighlightRect = null;
      return;
    }
    await this.appGuideManager.initialize();
    this.appGuideManager.setFlowOverride(this.buildDynamicMainMenuGuideFlow());

    if (!this.appGuideManager.getCurrentStep()) {
      const startupPending = AppStorage.get<boolean>('appGuideStartupPending') === true;
      if (startupPending) {
        AppStorage.setOrCreate('appGuideStartupPending', false);
        await this.appGuideManager.startFlow(AppGuideFlowId.MAIN_MENU_CORE, 'auto');
      } else {
        await this.appGuideManager.tryAutoStartFlowByPage(this.getCurrentMainGuidePageId());
      }
    }

    const step = this.appGuideManager.getCurrentStep();
    if (!step || !this.isMainGuidePage(step.pageId)) {
      this.appGuideStep = null;
      this.appGuideHighlightRect = null;
      return;
    }

    const targetTab = this.mapGuidePageIdToTabIndex(step.pageId);
    const targetActualIndex = this.getActualTabsIndexForTabIndex(targetTab);
    if (targetActualIndex < 0 && this.currentTabIndex !== targetTab) {
      logger.warn(TAG, `引导目标标签当前已隐藏，自动跳过该步骤: 步骤=${step.id}, 标签索引=${targetTab}`);
      await this.appGuideManager.nextStep();
      void this.refreshMainMenuGuide(`${trigger}_skip_hidden_tab`);
      return;
    }

    if (this.ensureGuideTabVisible(step.pageId)) {
      setTimeout(() => {
        void this.refreshMainMenuGuide(`${trigger}_after_tab`);
      }, 120);
      return;
    }

    if (!this.useTopTabsNavigation && this.bottomBarOffsetY > 0.1) {
      this.resetBottomBarScrollState();
      this.bottomBarOffsetY = 0;
      if (!trigger.endsWith('_bar_ready')) {
        setTimeout(() => {
          void this.refreshMainMenuGuide(`${trigger}_bar_ready`);
        }, 80);
        return;
      }
    }

    if (this.alignSettingsGuideViewport(step.anchorId) && !trigger.endsWith('_settings_scroll_ready')) {
      setTimeout(() => {
        void this.refreshMainMenuGuide(`${trigger}_settings_scroll_ready`);
      }, 320);
      return;
    }

    this.appGuideStep = step;
    this.appGuideHighlightRect = this.resolveGuideHighlightRect(step.anchorId, step.borderRadius ?? 18);
    if (!this.appGuideHighlightRect && !trigger.endsWith('_retry_layout')) {
      setTimeout(() => {
        void this.refreshMainMenuGuide(`${trigger}_retry_layout`);
      }, 120);
      return;
    }
    logger.debug(TAG, `主页面引导已刷新: 触发源=${trigger}, 步骤=${step.id}`);
  }

  private handleMainGuideNext(): void {
    void this.appGuideManager.nextStep().then(() => {
      void this.refreshMainMenuGuide('next');
    });
  }

  private handleMainGuideSkip(): void {
    void this.appGuideManager.skipCurrentFlow().then(() => {
      void this.refreshMainMenuGuide('skip');
    });
  }

  aboutToDisappear() {
    this.stopNavStackReturnWatch();
    logger.lifecycle(TAG, '应用主页面即将销毁');

    if (this.sideTabCenterTimer >= 0) {
      clearTimeout(this.sideTabCenterTimer);
      this.sideTabCenterTimer = -1;
    }
    this.hideLibraryRefreshFloatingBarImmediately();
    this.clearWindowModeTransitionTimers();
    this.clearMainMenuWindowInsetsResyncTimer();
    this.windowModeTransitionOverlayVisible = false;
    this.windowModeTransitionOverlayOpacity = 0;

    // 移除隐私模式监听器
    if (this.privacyModeListener) {
      this.privacyModeManager.removeListener(this.privacyModeListener);
      this.privacyModeListener = null;
      logger.debug(TAG, '隐私模式监听器已清理');
    }

    // 移除SFW模式监听器
    if (this.sfwModeListener) {
      this.contentFilterManager.removeListener(this.sfwModeListener);
      this.sfwModeListener = null;
      logger.debug(TAG, 'SFW模式监听器已清理');
    }

    // 移除设备变化监听器
    if (this.deviceChangeListener) {
      this.deviceManager.removeListener(this.deviceChangeListener);
      this.deviceChangeListener = null;
    }

    ThemeAwareHelper.cleanupThemeAware(this.componentId);
    FontAwareHelper.cleanupFontAware(this.componentId);

    // 取消订阅漫画导入完成事件
    eventBus.unsubscribe(GameEvent.MANGA_IMPORT_COMPLETED, (payload: IEventPayload) => {
      const mangaPayload = payload as MangaImportCompletedPayload;
      logger.info(TAG, `收到漫画导入完成事件，成功导入 ${mangaPayload.importedCount} 个漫画`);
      // 静默刷新漫画列表（增量更新）
      this.silentRefreshLibrary();
    });
  }

