  /**
   * 检查电子书是否有阅读进度
   * 判断条件：有 domPos 或 currentChapterIndex > 0 或 progress > 0
   */
  private hasEBookReadingProgress(ebook: EBook): boolean {
    if (!ebook.readingProgress) {
      return false;
    }
    const progress = ebook.readingProgress;
    // 有 domPos 表示有精确的阅读位置
    if (progress.domPos && progress.domPos.length > 0) {
      return true;
    }
    // 章节索引大于 0 表示已经翻过页
    if (progress.currentChapterIndex > 0) {
      return true;
    }
    // 进度大于 0 也表示有阅读记录
    if (progress.progress > 0) {
      return true;
    }
    return false;
  }

  /**
   * 检查漫画是否有阅读进度
   * 判断条件：有 currentChapterId 或 currentPageIndex > 0
   */
  private hasMangaReadingProgress(manga: Manga): boolean {
    if (!manga.readingProgress) {
      return false;
    }
    const progress = manga.readingProgress;
    // 有章节ID表示有阅读记录
    if (progress.currentChapterId && progress.currentChapterId.length > 0) {
      return true;
    }
    // 页码大于 0 表示已经翻过页
    if (progress.currentPageIndex > 0) {
      return true;
    }
    // 阅读百分比大于 0 也表示有阅读记录
    if (progress.readingPercentage > 0) {
      return true;
    }
    return false;
  }

  private hasNovelReadingProgress(novel: NovelBook): boolean {
    if (novel.readStatus === NovelReadStatus.READING || novel.readStatus === NovelReadStatus.FINISHED) {
      return true;
    }
    if ((novel.lastReadChapterIndex ?? 0) > 0) {
      return true;
    }
    if ((novel.lastReadPosition ?? 0) > 0) {
      return true;
    }
    return (novel.lastReadTime ?? 0) > 0;
  }

  private hasLibraryInfoText(value: string | null | undefined): boolean {
    return value !== undefined && value !== null && value.trim().length > 0;
  }

  private getMangaPrimaryAuthor(manga: Manga): string {
