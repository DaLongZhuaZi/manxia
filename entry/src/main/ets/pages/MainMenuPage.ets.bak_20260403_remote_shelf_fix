        // 普通模式：直接查询非隐私内容
        localComics = await this.dataManager.getNonPrivateComics();
        onlineComics = await this.dataManager.getNonPrivateOnlineComics();
        logger.info(TAG, `普通模式：从comic_info表获取到 ${localComics.length} 条非隐私本地漫画`);
        logger.info(TAG, `普通模式：从online_comic_info表获取到 ${onlineComics.length} 条非隐私在线漫画`);
      }

      // 转换本地漫画
      for (const comicInfo of localComics) {
        try {
          const manga = await ComicConverter.convertComicInfoToMangaAsync(comicInfo);
          mangaList.push(manga);
        } catch (convErr) {
          logger.warn(TAG, `转换本地漫画失败: ${String(convErr)}`);
          const fallback = ComicConverter.convertComicInfoToManga(comicInfo);
          mangaList.push(fallback);
        }
      }

      // 转换在线漫画
      for (const onlineComicInfo of onlineComics) {
        try {
          const manga = await ComicConverter.convertOnlineComicInfoToMangaAsync(onlineComicInfo);
          mangaList.push(manga);
        } catch (convErr) {
          logger.warn(TAG, `转换在线漫画失败: ${String(convErr)}`);
        }
      }

      logger.info(TAG, `总共加载 ${mangaList.length} 部漫画（本地: ${localComics.length}, 在线: ${onlineComics.length}）`);
    } catch (error) {
      logger.error(TAG, `加载漫画数据失败: ${String(error)}`);
    }

    if (!this.isPrivacyMode) {
      try {
        const remoteLibraryManga = await this.remoteLibraryBridge.getCachedLibraryManga();
        for (let index = 0; index < remoteLibraryManga.length; index++) {
          mangaList.push(remoteLibraryManga[index]);
        }
        logger.info(TAG, `已追加远程书库缓存内容: ${remoteLibraryManga.length} 条`);
      } catch (error) {
        logger.warn(TAG, `读取远程书库缓存失败: ${String(error)}`);
      }
    }

    return mangaList;
  }

  private filterFavoriteMangaItems(items: Manga[]): Manga[] {
    return items.filter((manga: Manga) => manga.isFavorite);
  }

  private filterFavoriteEBookItems(items: EBook[]): EBook[] {
    return items.filter((ebook: EBook) => ebook.isFavorite);
  }

  private filterFavoriteNovelItems(items: NovelBook[]): NovelBook[] {
    return items.filter((novel: NovelBook) => novel.isFavorite);
  }

  /**
   * 加载漫画列表
   * 优化：不加载章节信息，书库只需要基本信息即可
   * 章节数据在进入详情页时再加载，这样可以大幅提升书库加载速度
   */
  private async loadMangaList(): Promise<void> {
    try {
      this.isLoadingMangaList = true;
      logger.info(TAG, '开始加载漫画列表（不加载章节信息）...');

      // 同时加载本地和在线漫画（不加载章节，大幅提升速度）
      const mangaList = await this.loadAllMangaFromDatabase();
      const favoriteMangaList = this.filterFavoriteMangaItems(mangaList);
      logger.info(TAG, `从数据库获取到 ${mangaList.length} 条漫画记录，其中收藏 ${favoriteMangaList.length} 条`);

      // 不加载章节信息 - 书库列表不需要章节数据
      // 章节信息将在进入详情页或阅读器时加载
      for (const manga of mangaList) {
        manga.chapters = []; // 书库列表不需要章节数据
      }

      // 保留完整列表，交由 applyLibraryFilter 根据当前筛选类型统一处理
      this.mangaList = favoriteMangaList;
      logger.info(TAG, `成功加载 ${this.mangaList.length} 部漫画（未加载章节）`);

      // 预加载网络封面图片（支持AVIF格式）
      this.preloadNetworkCovers(this.mangaList);

      // 应用筛选
      this.applyLibraryFilter();
      this.refreshRemoteLibraryInBackground();
    } catch (error) {
      logger.error(TAG, '加载漫画列表失败', String(error));
      this.mangaList = [];
      // 应用筛选
      this.applyLibraryFilter();
    } finally {
      this.isLoadingMangaList = false;
    }
  }


  /**
   * 预加载网络封面图片（支持AVIF格式）
   * 对于网络图片，使用CoverImageManager预加载到PixelMap
   */
  private preloadNetworkCovers(mangaList: Manga[]): void {
    const coverManager = getCoverImageManager();
    const networkCovers: string[] = [];
    
    for (const manga of mangaList) {
      const coverUrl = manga.coverImagePath;
      if (coverUrl && (coverUrl.startsWith('http://') || coverUrl.startsWith('https://'))) {
        networkCovers.push(coverUrl);
      }
    }
    
    if (networkCovers.length > 0) {
      logger.info(TAG, `开始预加载 ${networkCovers.length} 个网络封面图片`);
      // 异步预加载，不阻塞UI
      coverManager.preloadCovers(networkCovers).then(() => {
        logger.info(TAG, `网络封面预加载完成`);
      }).catch((e: Error) => {
        logger.warn(TAG, `网络封面预加载部分失败: ${e.message}`);
      });
    }
  }

  /**
   * 刷新书库（漫画与电子书）列表
   */
  public async refreshMangaList(): Promise<void> {
    if (this.isRefreshing || this.isLoadingMangaList || this.isLoadingEbookList) {
      return;
    }

    this.isRefreshing = true;
    try {
      await Promise.all([
        this.loadMangaList(),
        this.loadEBookList()
      ]);
    } catch (error) {
      logger.error(TAG, `刷新书库失败: ${String(error instanceof Error ? error.message : error)}`);
      this.showToast('刷新失败，请稍后重试');
    } finally {
      this.isRefreshing = false;
    }
  }

  private async refreshShelfViewContent(): Promise<void> {
    if (this.isRefreshing || this.isLoadingMangaList || this.isLoadingEbookList || this.isLoadingNovelList) {
      logger.debug(TAG, '[书架视图] 下拉刷新忽略：已有刷新任务进行中');
      return;
    }

    this.isRefreshing = true;
    logger.info(TAG, `[书架视图] 开始下拉刷新 (隐私模式=${this.isPrivacyMode})`);
    try {
      await Promise.all([
        this.loadMangaList(),
        this.loadEBookList(),
        this.loadNovelList()
      ]);
      this.typeShelves = this.typeShelfManager.getShelves();
      this.bookshelfCategories = this.categoryManager.getCategories();
      logger.info(TAG, '[书架视图] 下拉刷新完成');
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      logger.error(TAG, `[书架视图] 下拉刷新失败: ${message}`);
      this.showToast('刷新失败，请稍后重试');
    } finally {
      this.isRefreshing = false;
    }
  }

  // ==================== 多选模式相关方法 ====================

  /**
   * 是否存在任意一种书库多选模式
   */
  private hasActiveLibraryMultiSelectMode(): boolean {
    return this.isMultiSelectMode || this.isEBookMultiSelectMode || this.isNovelMultiSelectMode;
  }

  private shouldUseUnifiedLibraryMixedMultiSelect(): boolean {
    return this.currentTabIndex === TabIndex.LIBRARY
      && this.libraryViewMode !== LibraryViewMode.CATEGORY
      && !this.showCategoryDetail;
  }

  private isUnifiedLibraryMixedMultiSelectActive(): boolean {
    return this.shouldUseUnifiedLibraryMixedMultiSelect()
      && this.isMultiSelectMode
      && this.isEBookMultiSelectMode
      && this.isNovelMultiSelectMode;
  }

  private getLibraryTotalSelectedCount(): number {
    return this.selectedMangaIds.size + this.selectedEBookIds.size + this.selectedNovelIds.size;
  }

  private animateLibraryMultiSelectState(update: () => void): void {
    animateTo({ duration: 220, curve: Curve.EaseOut }, () => {
      this.hideLibraryRefreshFloatingBarImmediately();
      this.hideMangaContextMenu();
      this.hideEBookContextMenu();
      this.hideNovelContextMenu();
      update();
    });
  }

  private runAfterLibraryContextMenuDismissed(action: () => void): void {
    setTimeout(() => {
      action();
    }, 80);
  }

  /**
   * 退出所有书库多选模式，避免在切换书架/退出详情后残留状态
   */
  private exitAllLibraryMultiSelectModes(): void {
    if (!this.hasActiveLibraryMultiSelectMode()) {
      return;
    }
    this.animateLibraryMultiSelectState(() => {
      this.isMultiSelectMode = false;
      this.isEBookMultiSelectMode = false;
      this.isNovelMultiSelectMode = false;
      this.selectedMangaIds = new Set();
      this.selectedEBookIds = new Set();
      this.selectedNovelIds = new Set();
    });
    logger.info(TAG, '退出全部书库多选模式');
  }

  /**
   * 获取当前上下文可见的漫画/PDF 选择池
   */
  private getVisibleMangaMultiSelectItems(): Manga[] {
    if (this.libraryViewMode === LibraryViewMode.CATEGORY && this.showCategoryDetail) {
      if (this.selectedShelf !== null) {
        return this.getCustomShelfMixedItems()
          .filter((item: ShelfMixedItem) => item.type === 'manga' || item.type === 'pdfebook')
          .map((item: ShelfMixedItem) => item.data as Manga);
      }
      if (this.selectedShelfType === LibraryContentType.EBOOK) {
        return this.getShelfFilteredPdfEBookList();
      }
      return this.getShelfFilteredMangaList();
    }
    return [...this.filteredMangaList, ...this.filteredPdfEbookList];
  }

  /**
   * 获取当前上下文可见的电子书选择池
   */
  private getVisibleEBookMultiSelectItems(): EBook[] {
    if (this.libraryViewMode === LibraryViewMode.CATEGORY && this.showCategoryDetail) {
      if (this.selectedShelf !== null) {
        return this.getCustomShelfMixedItems()
          .filter((item: ShelfMixedItem) => item.type === 'ebook')
          .map((item: ShelfMixedItem) => item.data as EBook);
      }
      return this.getShelfFilteredEBookList();
    }
    return this.filteredEbookList.slice();
  }

  /**
   * 获取当前上下文可见的小说选择池
   */
  private getVisibleNovelMultiSelectItems(): NovelBook[] {
    if (this.libraryViewMode === LibraryViewMode.CATEGORY && this.showCategoryDetail) {
      if (this.selectedShelf !== null) {
        return this.getCustomShelfMixedItems()
          .filter((item: ShelfMixedItem) => item.type === 'novel')
          .map((item: ShelfMixedItem) => item.data as NovelBook);
      }
      return this.getShelfFilteredNovelList();
