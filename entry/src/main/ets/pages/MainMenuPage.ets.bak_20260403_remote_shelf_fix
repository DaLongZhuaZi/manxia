  private getDefaultVisibleTabIndices(): number[] {
    return [TabIndex.LIBRARY, TabIndex.SOURCE, TabIndex.BOOK_SOURCE, TabIndex.SETTINGS]
      .filter((index: number) => {
        const config = this.tabConfigs.find((item: TabConfig) => item.index === index);
        return config ? this.shouldDisplayTabConfig(config) : false;
      });
  }

  private async loadVisibleTabs(): Promise<void> {
    const defaultVisibleTabs = this.getDefaultVisibleTabIndices();
    try {
      const settingsManager = SettingsManager.getInstance();
      const savedTabs = await settingsManager.getVisibleTabs();
      const allowedIndices = this.tabConfigs.map(cfg => cfg.index);
      const filteredDefaultTabs = defaultVisibleTabs.filter((idx: number) => allowedIndices.includes(idx));

      if (savedTabs && savedTabs.length > 0) {
        const filteredTabs = savedTabs.filter((idx: number) => idx !== TabIndex.HOME && allowedIndices.includes(idx));
        this.visibleTabIndices = filteredTabs.length > 0 ? filteredTabs : filteredDefaultTabs;
        logger.info(TAG, `已加载自定义标签配置: ${JSON.stringify(this.visibleTabIndices)}`);
      } else {
        this.visibleTabIndices = filteredDefaultTabs;
        logger.info(TAG, '使用默认标签配置');
      }

      AppStorage.setOrCreate('visible_tabs', this.visibleTabIndices);
      this.updateCachedVisibleTabConfigs();
      this.ensureCurrentTabIsVisible(this.isFirstTabLoad);
      this.isFirstTabLoad = false;
      void this.refreshMainMenuGuide('tabs_config_ready');
    } catch (error) {
      logger.error(TAG, '加载可见标签配置失败', String(error));
      const allowedIndices = this.tabConfigs.map(cfg => cfg.index);
      this.visibleTabIndices = defaultVisibleTabs.filter((idx: number) => allowedIndices.includes(idx));
      this.updateCachedVisibleTabConfigs();
      this.ensureCurrentTabIsVisible(this.isFirstTabLoad);
      this.isFirstTabLoad = false;
      void this.refreshMainMenuGuide('tabs_config_failed');
    }
  }


  /**
   * 确保 currentTabIndex 指向一个可见的标签
   * @param forceFirst 是否强制选中第一个可见标签（仅在应用启动时为true）
   */
  private ensureCurrentTabIsVisible(forceFirst: boolean = false): void {
    if (this.cachedVisibleTabConfigs.length === 0) {
      return;
    }

    const currentTabActualIndex = this.cachedVisibleTabConfigs.findIndex(
      (cfg: TabConfig) => cfg.index === this.currentTabIndex
    );
    const isCurrentTabVisible = currentTabActualIndex >= 0;

    if (!isCurrentTabVisible) {
      const firstVisibleTab = this.cachedVisibleTabConfigs[0];
      this.currentTabIndex = firstVisibleTab.index;
      this.changeMainContentToActualIndex(0, false);
      logger.info(TAG, `已切换到第一个可见标签: ${firstVisibleTab.title} (index=${firstVisibleTab.index})`);
      return;
    }

    if (forceFirst) {
      logger.info(TAG, `启动时保留默认标签: ${this.currentTabIndex}`);
    }
  }

  /**
   * 更新缓存的可见标签配置
   * 调用时机：visibleTabIndices 或 advancedModeEnabled 变化时
   * 按照 visibleTabIndices 的顺序排列标签（支持用户自定义排序）
   */
  private updateCachedVisibleTabConfigs(): void {
    // 先按用户定义的顺序构建可见标签列表
    const orderedConfigs: TabConfig[] = [];
    
    // 按 visibleTabIndices 的顺序添加标签
    for (const tabIndex of this.visibleTabIndices) {
      const cfg = this.tabConfigs.find((c: TabConfig) => c.index === tabIndex);
      if (cfg && this.shouldDisplayTabConfig(cfg)) {
        orderedConfigs.push(cfg);
      }
    }
    
    // 确保必须显示的标签存在（如果不在列表中则追加到末尾）
    for (const cfg of this.tabConfigs) {
      if (cfg.required &&
        this.shouldDisplayTabConfig(cfg) &&
        !orderedConfigs.some((c: TabConfig) => c.index === cfg.index)) {
        orderedConfigs.push(cfg);
      }
    }
    
    this.cachedVisibleTabConfigs = orderedConfigs;
    this.syncBottomBarVisualProgressFromActualIndex(this.getActualTabsIndexForTabIndex(this.currentTabIndex));
    logger.info(TAG, `更新可见标签缓存: ${this.cachedVisibleTabConfigs.length} 个标签，顺序: ${orderedConfigs.map((c: TabConfig) => c.title).join(', ')}`);
    this.scrollSideTabToCenter(this.currentTabIndex);
  }

