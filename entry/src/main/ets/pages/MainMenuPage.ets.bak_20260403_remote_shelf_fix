  private async batchDeleteLibraryMixedItems(): Promise<void> {
    const totalSelectedCount = this.getLibraryTotalSelectedCount();
    if (totalSelectedCount === 0) {
      return;
    }

    this.isDeletingManga = true;
    this.isDeletingEBook = true;
    this.isDeletingNovel = true;
    try {
      let successCount = 0;
      let failedCount = 0;

      const mangaIds = Array.from(this.selectedMangaIds);
      const localMangaIds: string[] = [];
      let komgaBlockedCount = 0;
      for (let index = 0; index < mangaIds.length; index++) {
        const mangaId = mangaIds[index];
        let manga = this.findLibraryMangaById(mangaId);
        if (manga === null && mangaId.startsWith('provider:')) {
          manga = await this.remoteLibraryBridge.getCachedMangaById(mangaId);
        }

        if (manga !== null && this.isRemoteProviderManga(manga)) {
          if (manga.sourceInfo?.providerType === 'komga') {
            failedCount++;
            komgaBlockedCount++;
            continue;
          }

          const removed = await this.remoteLibraryBridge.removeFromLibrary(manga);
          if (removed) {
            successCount++;
          } else {
            failedCount++;
          }
          continue;
        }

        localMangaIds.push(mangaId);
      }

      if (localMangaIds.length > 0) {
        const result = await this.dataManager.deleteComics(localMangaIds);
        successCount += result.successCount;
        failedCount += result.failedCount;
      }

      for (const ebookId of Array.from(this.selectedEBookIds)) {
        try {
          await this.ebookDataManager.deleteEBook(ebookId);
          successCount++;
        } catch (error) {
          failedCount++;
          logger.error(TAG, `删除电子书失败: ${ebookId}, ${String(error)}`);
        }
      }

      for (const novelId of Array.from(this.selectedNovelIds)) {
        try {
          await this.novelDataManager?.deleteBook(novelId);
          successCount++;
        } catch (error) {
          failedCount++;
          logger.error(TAG, `删除小说失败: ${novelId}, ${String(error)}`);
        }
      }

      logger.info(TAG, `书库混合批量删除完成: 成功=${successCount}, 失败=${failedCount}`);
      if (komgaBlockedCount > 0) {
        this.showToast(`Komga 内容需在服务器侧管理，已跳过 ${komgaBlockedCount} 项`);
      }
      if (failedCount > 0) {
        this.showToast(`删除完成，成功${successCount}项，失败${failedCount}项`);
      } else {
        this.showToast(`成功删除${successCount}项内容`);
      }

      this.exitAllLibraryMultiSelectModes();
      await this.silentRefreshLibrary(true);

    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : String(error);
      logger.error(TAG, `书库混合批量删除失败: ${errorMessage}`);
      this.showToast('删除失败，请稍后重试');
    } finally {
      this.isDeletingManga = false;
      this.isDeletingEBook = false;
      this.isDeletingNovel = false;
    }
  }

  /**
   * 批量删除漫画
   */
  private async batchDeleteManga(): Promise<void> {
    if (this.selectedMangaIds.size === 0) {
      return;
    }

    this.isDeletingManga = true;
    try {
      const mangaIds = Array.from(this.selectedMangaIds);
      logger.info(TAG, `开始批量删除漫画: ${mangaIds.length}个`);

      const localMangaIds: string[] = [];
      let successCount = 0;
      let failedCount = 0;
      let komgaBlockedCount = 0;
      for (let index = 0; index < mangaIds.length; index++) {
        const mangaId = mangaIds[index];
        let manga = this.findLibraryMangaById(mangaId);
        if (manga === null && mangaId.startsWith('provider:')) {
          manga = await this.remoteLibraryBridge.getCachedMangaById(mangaId);
        }

        if (manga !== null && this.isRemoteProviderManga(manga)) {
          if (manga.sourceInfo?.providerType === 'komga') {
            failedCount++;
            komgaBlockedCount++;
            continue;
          }

          const removed = await this.remoteLibraryBridge.removeFromLibrary(manga);
          if (removed) {
            successCount++;
          } else {
            failedCount++;
          }
          continue;
        }

        localMangaIds.push(mangaId);
      }

      if (localMangaIds.length > 0) {
        const result = await this.dataManager.deleteComics(localMangaIds);
        successCount += result.successCount;
        failedCount += result.failedCount;
      }

      logger.info(TAG, `批量删除完成: 成功=${successCount}, 失败=${failedCount}, blocked=${komgaBlockedCount}`);

      if (komgaBlockedCount > 0) {
        this.showToast(`Komga 内容需在服务器侧管理，已跳过 ${komgaBlockedCount} 项`);
      }

      if (failedCount > 0) {
        this.showToast(`删除完成，成功${successCount}个，失败${failedCount}个`);
      } else {
        this.showToast(`成功删除${successCount}个漫画`);
      }

      // 退出多选模式
      this.exitMultiSelectMode();

      // 静默刷新漫画列表（增量更新，避免闪烁）
      await this.silentRefreshLibrary(true);

    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : String(error);
      logger.error(TAG, `批量删除漫画失败: ${errorMessage}`);
      this.showToast('删除失败，请稍后重试');
    } finally {
      this.isDeletingManga = false;
    }
  }

