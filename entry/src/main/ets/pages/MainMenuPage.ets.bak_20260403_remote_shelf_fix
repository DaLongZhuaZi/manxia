  /**
   * 标准化封面路径（处理本地文件、网络URL、媒体资源等）
   */
  private normalizeCoverPath(coverPath: string): string {
    const normalized = typeof coverPath === 'string' ? coverPath.trim() : '';
    if (!normalized) {
      return '';
    }
    // 已带协议前缀的路径直接返回（http/file/datashare/resource 等）
    if (/^[a-zA-Z][a-zA-Z0-9+.-]*:\/\//.test(normalized)) {
      return normalized;
    }
    // 本地绝对路径添加 file:// 前缀
    if (normalized.startsWith('/')) {
      return `file://${normalized}`;
    }
    return normalized;
  }

  /**
   * 标准化小说封面路径（别名方法）
   */
  private normalizeNovelCoverPath(coverPath: string | undefined): string {
    if (!coverPath) {
      return '';
    }
    return this.normalizeCoverPath(coverPath);
  }

  private getNovelCoverPath(novel: NovelBook): string {
    const localPath = typeof novel.coverLocalPath === 'string' ? novel.coverLocalPath.trim() : '';
    const remotePath = typeof novel.coverUrl === 'string' ? novel.coverUrl.trim() : '';

    if (localPath.length > 0
      && (localPath.startsWith('app.media.') || localPath.startsWith('$r(') || this.isNetworkUrl(localPath))) {
      return localPath;
    }

    if (remotePath.length > 0
      && (remotePath.startsWith('app.media.') || remotePath.startsWith('$r(') || this.isNetworkUrl(remotePath))) {
      return remotePath;
    }

    const storedCoverPath = localPath || remotePath;
    const recoveredPath = this.findSiblingLocalLibraryCoverPath(novel.bookUrl || '', storedCoverPath);
    const normalizedStoredPath = this.getNormalizedLocalLibraryCoverPath(storedCoverPath).replace(/\\/g, '/');
    const normalizedLocalPath = this.getNormalizedLocalLibraryCoverPath(localPath).replace(/\\/g, '/');
    const normalizedRemotePath = this.getNormalizedLocalLibraryCoverPath(remotePath).replace(/\\/g, '/');

    const shouldPreferSiblingCover = recoveredPath.length > 0
      && normalizedStoredPath.includes('/library_covers/');

    if (shouldPreferSiblingCover) {
      logger.info(
        TAG,
        `[封面修复] 小说封面优先使用书籍同目录封面: id=${novel.id}, stored='${storedCoverPath}', recovered='${recoveredPath}'`
      );
      return recoveredPath;
    }

    if (localPath.length > 0
      && this.hasAccessibleLocalLibraryCover(localPath)
      && !normalizedLocalPath.includes('/library_covers/')) {
      return localPath;
    }

    if (remotePath.length > 0
      && this.hasAccessibleLocalLibraryCover(remotePath)
      && !normalizedRemotePath.includes('/library_covers/')) {
      return remotePath;
    }

    if (localPath.length > 0 && this.hasAccessibleLocalLibraryCover(localPath)) {
      return localPath;
    }

    if (remotePath.length > 0 && this.hasAccessibleLocalLibraryCover(remotePath)) {
      return remotePath;
    }

    if (recoveredPath) {
      return recoveredPath;
    }

    return localPath || remotePath;
  }


  private getNovelDisplayCoverPath(novel: NovelBook): string {
    return this.normalizeNovelCoverPath(this.getNovelCoverPath(novel));
  }

  private getParsedMangaSourceId(manga: Manga): number | undefined {
    const rawSourceId = typeof manga.sourceInfo?.sourceId === 'string' ? manga.sourceInfo.sourceId.trim() : '';
    if (!rawSourceId || rawSourceId === '0' || rawSourceId === 'local_import' || rawSourceId === 'local_pdf' || rawSourceId === 'download_import') {
      return undefined;
    }
    const parsedSourceId = Number(rawSourceId);
    return isNaN(parsedSourceId) ? undefined : parsedSourceId;
  }

  private getMangaSourceDisplayName(manga: Manga): string {
    const sourceName = typeof manga.sourceInfo?.sourceName === 'string' ? manga.sourceInfo.sourceName.trim() : '';
    if (sourceName.length > 0) {
      return sourceName;
    }
    return this.getParsedMangaSourceId(manga) !== undefined ? '网络漫画' : '本地内容';
  }

  private findLoadedMangaChapter(manga: Manga, chapterId: string): MangaChapter | undefined {
    if (!chapterId || !manga.chapters || manga.chapters.length <= 0) {
      return undefined;
    }
    return manga.chapters.find((chapter: MangaChapter) => chapter.id === chapterId);
  }

  private getFirstLoadedMangaChapter(manga: Manga): MangaChapter | undefined {
    if (!manga.chapters || manga.chapters.length <= 0) {
      return undefined;
    }
    let firstChapter = manga.chapters[0];
    for (let i = 1; i < manga.chapters.length; i++) {
      const currentChapter = manga.chapters[i];
      if (currentChapter.chapterNumber < firstChapter.chapterNumber) {
        firstChapter = currentChapter;
      }
    }
    return firstChapter;
  }

  private clampMangaPageIndex(manga: Manga, chapterId: string, pageIndex: number): number {
    const safePageIndex = pageIndex >= 0 ? pageIndex : 0;
    const chapter = this.findLoadedMangaChapter(manga, chapterId);
    if (!chapter) {
      return safePageIndex;
    }
    const totalPages = chapter.pages.length > 0 ? chapter.pages.length : (chapter.totalPages ?? 0);
    if (totalPages <= 0) {
      return safePageIndex;
    }
    return Math.min(safePageIndex, totalPages - 1);
  }

  private isRemoteProviderManga(manga: Manga): boolean {
    return this.remoteLibraryBridge.isRemoteProviderManga(manga);
  }

  private findLibraryMangaById(mangaId: string): Manga | null {
    for (let index = 0; index < this.filteredMangaList.length; index++) {
      const manga = this.filteredMangaList[index];
      if (manga.id === mangaId) {
        return manga;
      }
    }
    for (let index = 0; index < this.mangaList.length; index++) {
      const manga = this.mangaList[index];
      if (manga.id === mangaId) {
        return manga;
      }
    }
    return null;
  }

  private buildMergedRemoteLibraryMangaList(remoteMangaList: Manga[]): Manga[] {
    const mergedList: Manga[] = [];
    for (let index = 0; index < this.mangaList.length; index++) {
      const manga = this.mangaList[index];
      if (!this.isRemoteProviderManga(manga)) {
        mergedList.push(manga);
      }
    }
    for (let index = 0; index < remoteMangaList.length; index++) {
      const remoteManga = remoteMangaList[index];
      if (remoteManga.isFavorite) {
        mergedList.push(remoteManga);
      }
    }
    return mergedList;
  }

  private applyRemoteLibraryRefresh(remoteMangaList: Manga[], enableCollectionLayoutAnimation: boolean = false): void {
    const mergedList = this.buildMergedRemoteLibraryMangaList(remoteMangaList);
    const applyUpdates = () => {
      this.incrementalUpdateMangaList(this.mangaList, mergedList);
      void this.applyLibraryFilter();
      this.preloadNetworkCovers(this.mangaList);
    };

    if (enableCollectionLayoutAnimation) {
      this.animateLibraryCollectionLayout(applyUpdates);
    } else {
      applyUpdates();
    }
  }

  private refreshRemoteLibraryInBackground(enableCollectionLayoutAnimation: boolean = false): void {
    if (this.isPrivacyMode) {
      return;
    }
    if (this.isRefreshingRemoteLibrary) {
      this.pendingRemoteLibraryRefresh = true;
      return;
    }

    this.isRefreshingRemoteLibrary = true;
    void this.remoteLibraryBridge.refreshAllLibraryManga().then((remoteMangaList: Manga[]) => {
      this.applyRemoteLibraryRefresh(remoteMangaList, enableCollectionLayoutAnimation);
      logger.info(TAG, `远程书库后台刷新完成: count=${remoteMangaList.length}`);
    }).catch((error: Error) => {
      logger.warn(TAG, `远程书库后台刷新失败: ${error.message}`);
    }).finally(() => {
      this.isRefreshingRemoteLibrary = false;
      if (this.pendingRemoteLibraryRefresh) {
        this.pendingRemoteLibraryRefresh = false;
        this.refreshRemoteLibraryInBackground(enableCollectionLayoutAnimation);
      }
    });
  }

  private openRemoteProviderMangaDetail(manga: Manga): void {
    const parsed = RemoteLibraryMangaBridge.parseProviderMangaId(manga.id);
    const providerType = manga.sourceInfo?.providerType || parsed?.providerType;
    if (providerType === 'suwayomi') {
      const rawMangaId = manga.sourceInfo?.providerItemId || parsed?.rawMangaId || '';
      if (rawMangaId.length <= 0) {
        this.showToast('Suwayomi 内容缺少远程漫画 ID');
        return;
      }
      const params: SuwayomiMangaDetailParams = {
        mangaId: rawMangaId,
        title: manga.title
      };
      this.pathStack.pushPathByName('SuwayomiMangaDetailPage', params);
      return;
    }

    if (providerType === 'komga') {
      const rawMangaId = manga.sourceInfo?.providerItemId || parsed?.rawMangaId || '';
      const instanceId = manga.sourceInfo?.providerInstanceId || parsed?.instanceId || '';
      const contentType = manga.sourceInfo?.providerContentType || parsed?.contentType || 'SERIES';
      if (rawMangaId.length <= 0 || instanceId.length <= 0) {
        this.showToast('Komga 内容缺少实例或条目 ID');
        return;
      }
      const params: KomgaMangaDetailParams = {
        itemId: rawMangaId,
        contentType: contentType,
        instanceId: instanceId,
        title: manga.title
      };
      this.pathStack.pushPathByName('KomgaMangaDetailPage', params);
      return;
    }

    this.showToast('未识别的远程内容类型');
  }

  private getRemoteProviderReaderContentType(manga: Manga): MangaReaderContentType {
    if (manga.sourceInfo?.providerType === 'komga') {
      return MangaReaderContentType.Komga;
    }
    return MangaReaderContentType.Suwayomi;
  }

  private async buildRemoteProviderReaderParams(
    manga: Manga,
    target: ResumeTarget | null,
    fromPage: string,
    coverComponentId?: string
  ): Promise<MangaReaderPageParams | null> {
    let remoteManga = manga;
    const needsDetail = !remoteManga.chapters || remoteManga.chapters.length <= 0;
    if (needsDetail) {
      const detailManga = await this.remoteLibraryBridge.loadRemoteMangaDetail(manga, manga.id);
      if (detailManga === null) {
        this.showToast('加载远程漫画详情失败');
        return null;
      }
      remoteManga = detailManga;
    }

    let targetChapter: MangaChapter | undefined = undefined;
    if (target !== null && target.chapterId.length > 0) {
      targetChapter = remoteManga.chapters.find((chapter: MangaChapter) =>
        chapter.id === target.chapterId || chapter.externalId === target.chapterId
      );
    }
    if (!targetChapter) {
      targetChapter = this.getFirstLoadedMangaChapter(remoteManga);
    }
    if (!targetChapter) {
      this.showToast('未找到可阅读章节');
      return null;
    }

    const params: MangaReaderPageParams = {
      manga: remoteManga,
      mangaId: remoteManga.id,
      chapterId: targetChapter.id,
      pageIndex: target ? this.clampMangaPageIndex(remoteManga, targetChapter.id, target.pageIndex) : 0,
      fromPage: fromPage,
      contentType: this.getRemoteProviderReaderContentType(remoteManga),
      sourceName: remoteManga.sourceInfo?.sourceName || '',
      coverComponentId: coverComponentId
    };
    return params;
  }

  /**
   * 获取分类的封面图片列表（默认分类从实际内容获取）
   */
  private getCategoryCoverImages(category: BookshelfCategory): string[] {
    if (category.isDefault) {
      // 默认分类：从实际内容列表获取封面（使用已标准化的路径）
      const covers: string[] = [];
      // 从漫画获取封面
      for (const manga of this.mangaList) {
        if (covers.length >= 3) break;
        const normalizedPath = this.normalizeDisplayPathForManga(manga);
        if (normalizedPath) {
          covers.push(normalizedPath);
        }
      }
      // 从电子书获取封面
      for (const ebook of this.ebookList) {
        if (covers.length >= 3) break;
        const normalizedPath = this.getValidEBookCoverPath(ebook);
        if (normalizedPath) {
          covers.push(normalizedPath);
        }
      }
      // 从小说获取封面（优先使用本地缓存路径）
      for (const novel of this.novelList) {
        if (covers.length >= 3) break;
        const coverPath = this.getNovelDisplayCoverPath(novel);
        if (coverPath) {
          covers.push(coverPath);
        }
      }
      return covers;
    }
    // 其他分类：使用category中存储的封面
    return category.coverImages || [];
  }

