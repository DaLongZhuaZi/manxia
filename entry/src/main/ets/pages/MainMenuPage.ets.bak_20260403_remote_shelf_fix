  /**
   * 保存可见标签配置
   */
  private async saveVisibleTabs(indices: number[]): Promise<void> {
    try {
      // 确保必须显示的标签（书库、管理）始终存在
      const requiredIndices = this.tabConfigs
        .filter(cfg => cfg.required)
        .map(cfg => cfg.index);
      const allowedIndices = this.tabConfigs.map(cfg => cfg.index);
      const requestedIndices = indices.filter((idx: number) => idx !== TabIndex.HOME && allowedIndices.includes(idx));
      
      // 合并索引并去重
      const combined: number[] = [];
      for (const idx of requestedIndices) {
        if (!combined.includes(idx)) {
          combined.push(idx);
        }
      }
      for (const idx of requiredIndices) {
        if (!combined.includes(idx)) {
          combined.push(idx);
        }
      }
      
      const finalIndices = combined;
      // 不再排序，保持用户自定义顺序
      
      // 保存到持久化存储
      const settingsManager = SettingsManager.getInstance();
      await settingsManager.setVisibleTabs(finalIndices);
      // 同步到 AppStorage 以便 UI 响应
      AppStorage.setOrCreate('visible_tabs', finalIndices);
      
      this.visibleTabIndices = finalIndices;
      // 更新缓存
      this.updateCachedVisibleTabConfigs();
      
      logger.info(TAG, `已保存标签配置: ${JSON.stringify(finalIndices)}`);
    } catch (error) {
      logger.error(TAG, '保存可见标签配置失败', String(error));
    }
  }

  /**
   * 显示标签自定义对话框
