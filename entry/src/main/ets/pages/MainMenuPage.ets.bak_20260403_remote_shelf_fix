    this.initializeSystem();
    this.loadVersionInfo();
    this.initializeUserManualIfNeeded(); // 首次运行时添加使用手册
    this.checkAndShowChangelog(); // 新版本首次启动显示更新日志
    this.initializeContentData(); // 加载漫画、电子书并提取标签作者
    void this.loadLibraryViewMode();
    this.loadRecentReadingList();
    this.initializeRepositoryManager(); // 初始化仓库管理器（会在完成后自动加载图源列表）
    this.checkSourceUpdates(); // 检查图源更新

    // 初始化响应式布局
    this.initializeResponsiveLayout();

    // 处理引导跳转
    if (this.fromGuide) {
      this.handleGuideNavigation();
    }

    // 处理 Deep Link
    this.handleDeepLinkIfPresent();
    
    // 处理卡片跳转
    if (!this.startupRoutePending) {
      void this.handleWidgetNavigationIfPresent(false);
    }
  }

  /**
   * 处理卡片跳转（如果存在）
   */
  private async handleWidgetNavigationIfPresent(startupFastRoute: boolean = false): Promise<void> {
    if (startupFastRoute && this.startupRouteHandling) {
      return;
    }
    if (startupFastRoute) {
      this.startupRouteHandling = true;
    }
    try {
      const targetPage = AppStorage.get<string>('widgetTargetPage');
      if (!targetPage) {
        if (startupFastRoute) {
          this.startupRoutePending = false;
        }
        return;
      }

      logger.info(TAG, `📱 处理卡片跳转: targetPage=${targetPage}`);

      // 清除标记
      AppStorage.setOrCreate('widgetTargetPage', '');

      if (targetPage === 'readingAnalytics') {
        const targetView = AppStorage.get<string>('widgetTargetView') || 'daily';
        AppStorage.setOrCreate('widgetTargetView', '');
        if (startupFastRoute) {
          AppStorage.setOrCreate('analyticsViewMode', targetView);
          this.pathStack.pushPathByName('ReadingAnalyticsPage', undefined);
          logger.info(TAG, `✅ 已快捷跳转到阅读报告页面: viewMode=${targetView}`);
          return;
        }

        // 延迟跳转，确保页面已加载完成
        setTimeout(() => {
          AppStorage.setOrCreate('analyticsViewMode', targetView);
          this.pathStack.pushPathByName('ReadingAnalyticsPage', undefined);
          logger.info(TAG, `✅ 已跳转到阅读报告页面: viewMode=${targetView}`);
        }, 300);
        return;
      }

      if (targetPage === 'continueRead') {
        const contentType = AppStorage.get<string>('widgetContentType') || '';
        const contentId = AppStorage.get<string>('widgetContentId') || '';
        AppStorage.setOrCreate('widgetContentType', '');
        AppStorage.setOrCreate('widgetContentId', '');
        if (startupFastRoute) {
          await this.navigateFromWidgetContinueRead(contentType, contentId);
          return;
        }

        setTimeout(() => {
          void this.navigateFromWidgetContinueRead(contentType, contentId);
        }, 200);
        return;
      }

      if (targetPage === 'continueReadLatest' || targetPage === 'continue_read_latest' || targetPage === 'open_recent_read') {
        if (startupFastRoute) {
          await this.navigateFromShortcutLatestRecentRead();
          return;
        }
        setTimeout(() => {
          void this.navigateFromShortcutLatestRecentRead();
        }, 200);
        return;
      }

      if (targetPage === 'continueReadAloud' || targetPage === 'continue_read_aloud' || targetPage === 'open_recent_read_aloud') {
        if (startupFastRoute) {
          await this.navigateFromShortcutContinueReadAloud();
          return;
        }
        setTimeout(() => {
          void this.navigateFromShortcutContinueReadAloud();
        }, 200);
        return;
      }

      if (targetPage === 'inspiration' || targetPage === 'open_inspiration') {
        const params: AnnotationCenterPageParams = {
          contentTitle: '全部内容'
        };
        this.pathStack.pushPathByName('AnnotationCenterPage', params);
        return;
      }

      if (targetPage === 'search' || targetPage === 'open_search') {
        this.pathStack.pushPathByName('GlobalSearchPage', undefined);
        return;
      }

      if (targetPage === 'downloads' || targetPage === 'open_downloads') {
        this.pathStack.pushPathByName('DownloadManagerPage', undefined);
        return;
      }

      if (targetPage === 'library' || targetPage === 'open_library') {
        this.handleTabButtonClick(TabIndex.LIBRARY);
        return;
      }
    } catch (error) {
      logger.error(TAG, `❌ 处理卡片跳转失败: ${error}`);
    } finally {
      if (startupFastRoute) {
        this.startupRoutePending = false;
        this.startupRouteHandling = false;
      }
    }
  }

  private async navigateFromShortcutLatestRecentRead(): Promise<void> {
    try {
      let mangaList: Manga[] = this.recentReadingList;
      let ebookList: EBook[] = this.recentEBookList;
      let novelList: NovelBook[] = this.recentNovelList;

      // 首页缓存可能尚未准备好，主动从数据层拉取一次，确保快捷方式可用
      if (mangaList.length === 0 && ebookList.length === 0 && novelList.length === 0) {
        const results = await Promise.all([
          this.loadRecentMangaList(),
          this.loadRecentEBookList(),
          this.loadRecentNovelList()
        ]);
        mangaList = this.contentFilterManager.filterContentList(results[0] as Manga[]);
        ebookList = this.contentFilterManager.filterContentList(results[1] as EBook[]);
        novelList = this.contentFilterManager.filterContentList(results[2] as NovelBook[]);
      }

      const candidates: RecentShortcutCandidate[] = [];

      const latestManga = mangaList.length > 0 ? mangaList[0] : null;
      if (latestManga) {
        const mangaReadTime = latestManga.readingProgress?.lastReadAt || 0;
        if (mangaReadTime > 0 && latestManga.id) {
          const mangaCandidate: RecentShortcutCandidate = {
            type: 'manga',
            id: latestManga.id,
            lastReadTime: mangaReadTime
          };
          candidates.push(mangaCandidate);
        }
      }

      const latestEBook = ebookList.length > 0 ? ebookList[0] : null;
      if (latestEBook) {
        const ebookReadTime = latestEBook.readingProgress?.lastReadTime || 0;
        if (ebookReadTime > 0 && latestEBook.id) {
          const ebookCandidate: RecentShortcutCandidate = {
            type: 'ebook',
            id: latestEBook.id,
            lastReadTime: ebookReadTime
          };
          candidates.push(ebookCandidate);
        }
      }

      const latestNovel = novelList.length > 0 ? novelList[0] : null;
      if (latestNovel) {
        const novelReadTime = latestNovel.lastReadTime || 0;
        if (novelReadTime > 0 && latestNovel.id) {
          const novelCandidate: RecentShortcutCandidate = {
            type: 'novel',
            id: latestNovel.id,
            lastReadTime: novelReadTime
          };
          candidates.push(novelCandidate);
        }
      }

      if (candidates.length === 0) {
        logger.warn(TAG, '快捷方式继续阅读失败：没有可用的最近阅读记录');
        this.showToast('暂无最近阅读内容，已打开书库');
        this.fallbackWidgetContinueRead('');
        return;
      }

      candidates.sort((a, b) => b.lastReadTime - a.lastReadTime);
      const latest = candidates[0];
      logger.info(TAG, `快捷方式继续阅读命中: type=${latest.type}, id=${latest.id}, time=${latest.lastReadTime}`);
      await this.navigateFromWidgetContinueRead(latest.type, latest.id);
    } catch (error) {
      logger.error(TAG, `快捷方式继续阅读跳转失败: ${String(error)}`);
      this.showToast('打开最近阅读失败，已打开书库');
      this.fallbackWidgetContinueRead('');
    }
  }

  private async navigateFromShortcutContinueReadAloud(): Promise<void> {
    try {
      const readAloudController = ReadAloudController.getInstance();
      const snapshot = readAloudController.getSnapshot();
      const context = readAloudController.getContextSnapshot();

      if (snapshot.hasContext && context && context.content && context.content.length > 0) {
        if (snapshot.playbackState !== ReadAloudPlaybackState.PLAYING) {
          readAloudController.start('shortcut_continue_read_aloud');
        }
        readAloudController.refreshMediaSession();
        AppStorage.setOrCreate('ReadAloudPlayerOpeningAt', Date.now());
        this.pathStack.pushPathByName('ReadAloudPlayerPage', undefined);
        logger.info(TAG, `快捷方式继续听书命中当前会话: bookId=${context.bookId}, chapter=${context.chapterIndex}`);
        return;
      }

      let novelList: NovelBook[] = this.contentFilterManager.filterContentList(this.recentNovelList);
      if (novelList.length === 0) {
        const loadedNovels = await this.loadRecentNovelList();
        novelList = this.contentFilterManager.filterContentList(loadedNovels);
      }

      const candidates = novelList
        .filter((item: NovelBook) =>
          !!item &&
          !!item.bookUrl &&
          !!item.sourceId &&
          ((item.lastReadTime ?? 0) > 0 || (item.lastReadChapterIndex ?? -1) >= 0)
        )
        .sort((a: NovelBook, b: NovelBook) => (b.lastReadTime ?? 0) - (a.lastReadTime ?? 0));

      if (candidates.length <= 0) {
        logger.warn(TAG, '快捷方式继续听书失败：没有可恢复的听书或小说阅读记录');
        this.showToast('暂无可继续听书内容');
        this.pathStack.pushPathByName('ReadAloudPlayerPage', undefined);
        return;
      }

      await this.navigateNovelToReadAloud(candidates[0]);
    } catch (error) {
      logger.error(TAG, `快捷方式继续听书跳转失败: ${String(error)}`);
      this.showToast('继续听书失败');
      this.pathStack.pushPathByName('ReadAloudPlayerPage', undefined);
    }
  }

  private async navigateNovelToReadAloud(novel: NovelBook): Promise<void> {
    try {
      const sourceManager = getNovelSourceManager();
      const parsedBook = await sourceManager.getBookInfo(novel.sourceId, novel.bookUrl);
      const resolvedBook: LegadoBook = parsedBook ?? {
        id: `${novel.sourceId}_${encodeURIComponent(novel.bookUrl)}`,
        origin: novel.sourceId,
        originName: novel.sourceName || '',
        bookUrl: novel.bookUrl,
        name: novel.name,
        author: novel.author,
        kind: novel.kind,
        intro: novel.intro,
        coverUrl: novel.coverUrl,
        tocUrl: novel.tocUrl || novel.bookUrl,
        latestChapterTitle: novel.latestChapterTitle,
        wordCount: novel.wordCount,
        updateTime: novel.lastReadTime,
        type: LegadoBookSourceType.TEXT
      };
      const chapters = await sourceManager.getChapterList(novel.sourceId, resolvedBook);
      if (chapters.length <= 0) {
        logger.warn(TAG, `快捷方式继续听书失败：章节为空，回退详情页: ${novel.name}`);
        this.showToast('未找到章节，已打开小说详情');
        this.openNovelDetail(novel);
        return;
      }

      const lastReadChapterIndex = novel.lastReadChapterIndex ?? 0;
      const safeChapterIndex = Math.max(0, Math.min(lastReadChapterIndex, chapters.length - 1));
      const chapter = chapters[safeChapterIndex];
      const params: NovelReaderPageParams = {
        sourceId: novel.sourceId,
        bookUrl: novel.bookUrl,
        bookName: resolvedBook.name || novel.name,
        chapterUrl: chapter.url,
        chapterTitle: chapter.title || `第${safeChapterIndex + 1}章`,
        chapterIndex: safeChapterIndex,
        totalChapters: chapters.length,
        tocUrl: resolvedBook.tocUrl || novel.tocUrl || novel.bookUrl,
        author: resolvedBook.author || novel.author,
        coverUrl: resolvedBook.coverUrl || novel.coverUrl,
        sourceName: novel.sourceName || resolvedBook.originName || '',
        coverComponentId: `cover_novel_home_${novel.id}`,
        autoStartReadAloud: true,
        autoOpenReadAloudPlayer: true
      };
      this.pathStack.pushPathByName('NovelReaderPage', params);
      logger.info(TAG, `快捷方式继续听书命中最近小说: ${novel.name}, chapter=${safeChapterIndex + 1}/${chapters.length}`);
    } catch (error) {
      logger.error(TAG, `快捷方式继续听书恢复章节失败: ${String(error)}`);
      this.showToast('恢复听书失败，已打开小说详情');
      this.openNovelDetail(novel);
    }
  }

  private async navigateFromWidgetContinueRead(contentType: string, contentId: string): Promise<void> {
    if (!contentType || !contentId) {
      logger.warn(TAG, `卡片继续阅读参数缺失: type=${contentType}, id=${contentId}`);
      return;
    }

    try {
      if (contentType === 'manga') {
        const manga = await this.resolveWidgetManga(contentId);
        if (manga) {
          await this.openMangaDetail(manga);
          return;
        }
      } else if (contentType === 'ebook') {
        const ebook = await this.resolveWidgetEBook(contentId);
        if (ebook) {
          this.openEBookDetail(ebook);
          return;
        }
      } else if (contentType === 'novel') {
        const novel = await this.resolveWidgetNovel(contentId);
        if (novel) {
          this.openNovelDetail(novel);
          return;
        }
      }

      logger.warn(TAG, `卡片继续阅读目标未找到: type=${contentType}, id=${contentId}`);
      this.showToast('未找到对应内容，已打开书库');
      this.fallbackWidgetContinueRead(contentType);
    } catch (error) {
      logger.error(TAG, `卡片继续阅读跳转失败: ${String(error)}`);
      this.showToast('跳转失败，已打开书库');
      this.fallbackWidgetContinueRead(contentType);
    }
  }

  private async resolveWidgetManga(contentId: string): Promise<Manga | null> {
    const filteredManga = this.getMangaById(contentId);
    if (filteredManga) {
      return filteredManga;
    }
    const listManga = this.mangaList.find((item: Manga) => item.id === contentId);
    if (listManga) {
      return listManga;
    }

    try {
      const comicInfo = await this.dataManager.getComicById(contentId);
      if (comicInfo) {
        try {
          return await ComicConverter.convertComicInfoToMangaAsync(comicInfo);
        } catch (error) {
          logger.warn(TAG, `convertComicInfoToMangaAsync失败，使用同步转换: ${String(error)}`);
          return ComicConverter.convertComicInfoToManga(comicInfo);
        }
      }

      const onlineComic = await this.dataManager.getOnlineComicInfoById(contentId);
      if (onlineComic) {
        return await ComicConverter.convertOnlineComicInfoToMangaAsync(onlineComic);
      }
    } catch (error) {
      logger.warn(TAG, `resolveWidgetManga失败: ${String(error)}`);
    }

    return null;
  }

  private async resolveWidgetEBook(contentId: string): Promise<EBook | null> {
    const filteredEBook = this.getEBookById(contentId);
    if (filteredEBook) {
      return filteredEBook;
    }
    const listEBook = this.ebookList.find((item: EBook) => item.id === contentId) || null;
    if (listEBook) {
      return listEBook;
    }

    try {
      return await this.ebookDataManager.getEBookById(contentId);
    } catch (error) {
      logger.warn(TAG, `resolveWidgetEBook失败: ${String(error)}`);
      return null;
    }
  }

  private async resolveWidgetNovel(contentId: string): Promise<NovelBook | null> {
    const filteredNovel = this.getNovelById(contentId);
    if (filteredNovel) {
      return filteredNovel;
    }
    const listNovel = this.novelList.find((item: NovelBook) => item.id === contentId) || null;
    if (listNovel) {
      return listNovel;
    }

    try {
      if (!this.novelDataManager) {
        this.novelDataManager = getNovelDataManager();
      }
      if (!this.novelDataManager) {
        return null;
      }
      return await this.novelDataManager.getBook(contentId);
    } catch (error) {
      logger.warn(TAG, `resolveWidgetNovel失败: ${String(error)}`);
      return null;
    }
  }

  private fallbackWidgetContinueRead(_contentType: string): void {
    this.handleTabButtonClick(TabIndex.LIBRARY);
  }

  /**
   * 处理 Deep Link（如果存在）
   */
  private async handleDeepLinkIfPresent(): Promise<void> {
    try {
      const hasDeepLink = AppStorage.get<boolean>('hasDeepLink');
      if (!hasDeepLink) {
        return;
      }

      const source = AppStorage.get<string>('deepLinkSource');
      const type = AppStorage.get<string>('deepLinkType');
      const query = AppStorage.get<string>('deepLinkQuery');

      if (source && query) {
        logger.info(TAG, `🔗 处理 Deep Link: source=${source}, type=${type}, query=${query}`);

        // 清除 Deep Link 标记
        AppStorage.setOrCreate('hasDeepLink', false);

        // 等待图源列表加载完成
        await this.waitForSourceListLoaded();

        // 构造前缀格式并执行全局搜索
        const searchInput = `${source}//${type}//${query}`;
        const handled = await this.executeGlobalSourceSearch(searchInput);

        if (handled) {
          logger.info(TAG, `🔗 Deep Link 处理成功`);
        } else {
          logger.warn(TAG, `🔗 Deep Link 处理失败: 未找到匹配的图源或搜索类型`);
        }
      }
    } catch (error) {
      logger.error(TAG, `🔗 处理 Deep Link 失败: ${error}`);
    }
  }

  /**
   * 等待图源列表加载完成
   */
  private async waitForSourceListLoaded(): Promise<void> {
    const maxWaitTime = 5000; // 最多等待5秒
    const checkInterval = 100; // 每100ms检查一次
    let waitedTime = 0;

    while (this.sourceList.length === 0 && waitedTime < maxWaitTime) {
      await new Promise<void>(resolve => setTimeout(resolve, checkInterval));
      waitedTime += checkInterval;
    }

    if (this.sourceList.length === 0) {
      logger.warn(TAG, '等待图源列表加载超时');
    } else {
      logger.info(TAG, `图源列表已加载，共 ${this.sourceList.length} 个图源`);
    }
  }

  /**
   * 加载用户主题配置
   * 从 AppStorage 读取配置，仅在页面创建和从设置页面返回时调用
   * 避免使用 @StorageLink 实时监听导致的崩溃问题
   */
  private loadUserThemeConfig(): void {
    try {
      // 从 AppStorage 安全读取配置，使用默认值确保安全
      const cardOpacity = AppStorage.get<number>('userTheme_cardOpacity');
      const navBarOpacity = AppStorage.get<number>('userTheme_navBarOpacity');
      const tabBarOpacity = AppStorage.get<number>('userTheme_tabBarOpacity');
      const componentCornerRadius = AppStorage.get<number>('userTheme_componentCornerRadius');
      const coverCornerRadius = AppStorage.get<number>('userTheme_coverCornerRadius');
      const legacyCornerRadius = AppStorage.get<number>('userTheme_cornerRadius');
      const blurEnabled = AppStorage.get<boolean>('userTheme_blurEnabled');
      const shadowEnabled = AppStorage.get<boolean>('userTheme_shadowEnabled');

      // 使用默认值保护，避免 undefined 导致的问题
      this.userThemeCardOpacity = cardOpacity !== undefined ? cardOpacity : 1.0;
      this.userThemeNavBarOpacity = navBarOpacity !== undefined ? navBarOpacity : 1.0;
      this.userThemeTabBarOpacity = tabBarOpacity !== undefined ? tabBarOpacity : 1.0;
      this.userThemeCornerRadius = componentCornerRadius !== undefined
        ? componentCornerRadius
        : (legacyCornerRadius !== undefined ? legacyCornerRadius : 12);
      this.userThemeCoverCornerRadius = coverCornerRadius !== undefined
        ? coverCornerRadius
        : this.userThemeCornerRadius;
      this.userThemeBlurEnabled = blurEnabled !== undefined ? blurEnabled : true;
      this.userThemeShadowEnabled = shadowEnabled !== undefined ? shadowEnabled : true;

      logger.debug(TAG, `用户主题配置已加载: cardOpacity=${this.userThemeCardOpacity}, componentCornerRadius=${this.userThemeCornerRadius}, coverCornerRadius=${this.userThemeCoverCornerRadius}, blurEnabled=${this.userThemeBlurEnabled}`);
    } catch (error) {
      logger.error(TAG, '加载用户主题配置失败', String(error));
      // 保持默认值，不影响页面渲染
    }
  }

  /**
   * 初始化响应式布局
   */
  private initializeResponsiveLayout(): void {
    try {
      // 更新响应式参数
      this.applyOrientationPreference();
      this.updateResponsiveParams();

      // 创建并注册设备变化监听器
      this.deviceChangeListener = (deviceInfo: DeviceInfo) => {
        logger.info(TAG, `设备状态变化: 断点=${deviceInfo.breakpoint}, 方向=${deviceInfo.orientation}, 折叠状态=${this.getFoldStatusDescription(deviceInfo.foldStatus)}`);
        this.applyOrientationPreference();
        this.updateResponsiveParams();
        // 触发顶栏和底栏重新渲染
        this.barRenderKey++;
        logger.info(TAG, `顶栏/底栏重渲染触发: barRenderKey=${this.barRenderKey}`);
      };

      this.deviceManager.addListener(this.deviceChangeListener);

      logger.info(TAG, '✅ 响应式布局初始化完成');
    } catch (error) {
      logger.error(TAG, '响应式布局初始化失败', String(error));
    }
  }

  private applyOrientationPreference(): void {
    try {
      const ui = this.getUIContext();
      if (this.forceLandscapeMode) {
        WindowManager.setPreferredOrientationLandscape(ui);
      } else {
        WindowManager.setPreferredOrientationAuto(ui);
      }
    } catch (error) {
      logger.error(TAG, '应用横屏偏好失败', String(error));
    }
  }

  private normalizeTabletTopBarPosition(value: string): TabletTopBarPosition {
    switch (value) {
      case 'top':
      case 'bottom':
      case 'left':
      case 'right':
        return value;
      default:
        return 'top';
    }
  }

  private getEffectiveTabletTopBarPosition(): TabletTopBarPosition {
    if (!this.useTopTabsNavigation) {
      return 'top';
    }
    const deviceInfo = this.deviceManager.getDeviceInfo();
    if (this.shouldUsePhoneLandscapeSideNavigation(deviceInfo)) {
      return 'right';
    }
    return this.normalizeTabletTopBarPosition(this.tabletTopBarPosition);
  }

  private shouldReserveTopBarSpace(): boolean {
    return this.useTopTabsNavigation && this.getEffectiveTabletTopBarPosition() === 'top';
  }

  private onTabletTopBarPositionChanged(): void {
    const normalized = this.normalizeTabletTopBarPosition(this.tabletTopBarPosition);
    if (normalized !== this.tabletTopBarPosition) {
      this.tabletTopBarPosition = normalized;
      return;
    }
    this.barRenderKey++;
    logger.info(TAG, `平板顶栏位置已更新: ${normalized}, barRenderKey=${this.barRenderKey}`);
  }

  private getTabletTopNavigationLeftInset(): number {
    if (!this.useTopTabsNavigation || this.getEffectiveTabletTopBarPosition() !== 'left') {
      return 0;
    }
    return this.TABLET_SIDE_BAR_WIDTH + this.TABLET_TOP_BAR_HORIZONTAL_MARGIN * 2;
  }

  private getTabletTopNavigationRightInset(): number {
    if (!this.useTopTabsNavigation || this.getEffectiveTabletTopBarPosition() !== 'right') {
      return 0;
    }
    return this.TABLET_SIDE_BAR_WIDTH + this.TABLET_TOP_BAR_HORIZONTAL_MARGIN * 2;
  }

  private getTabletTopNavigationBottomInset(): number {
    if (!this.useTopTabsNavigation || this.getEffectiveTabletTopBarPosition() !== 'bottom') {
      return 0;
    }
    return this.BOTTOM_BAR_HEIGHT + this.BOTTOM_BAR_MARGIN_BOTTOM + 8;
  }

  /**
   * 更新响应式布局参数
   */
  private updateResponsiveParams(): void {
    const deviceInfo = this.deviceManager.getDeviceInfo();
    const shouldUseTabletLandscapeTopNavigation = this.shouldUseTabletLandscapeTopNavigation(deviceInfo);
    const shouldUsePhoneLandscapeSideNavigation = this.shouldUsePhoneLandscapeSideNavigation(deviceInfo);
    const shouldUseLandscapeStyleLayout = deviceInfo.isLandscape || shouldUseTabletLandscapeTopNavigation;
    const layoutParams = this.forceTabletMode
      ? ResponsiveLayoutHelper.getLayoutParamsForBreakpoint(Breakpoint.MD)
      : ResponsiveLayoutHelper.getLayoutParams();

    this.responsive_gridColumns = layoutParams.gridColumns;
    this.responsive_gridGap = layoutParams.gridGap;
    this.responsive_contentPadding = layoutParams.contentPadding;
    // 折叠屏展开态按“平板横屏逻辑”处理，保证布局与动画分支一致
    this.responsive_isLandscape = shouldUseLandscapeStyleLayout;

    // 根据断点和横屏状态设置各页面的网格列数

    const breakpoint = (this.forceTabletMode && !deviceInfo.isFoldable)
      ? Breakpoint.MD
      : deviceInfo.breakpoint;
    if (shouldUsePhoneLandscapeSideNavigation) {
      this.responsive_homeGridColumns = 3;
      this.responsive_libraryGridColumns = 4;
      this.responsive_discoverGridColumns = 4;
    } else if (shouldUseLandscapeStyleLayout) {
      // 横屏模式下的列数配置
      switch (breakpoint) {
        case Breakpoint.SM:
          this.responsive_homeGridColumns = 4;     // 首页：SM=4列
          this.responsive_libraryGridColumns = 5;  // 书库：SM=5列
          this.responsive_discoverGridColumns = 5; // 发现：SM=5列
          break;
        case Breakpoint.MD:
          this.responsive_homeGridColumns = 6;     // 首页：MD=6列
          this.responsive_libraryGridColumns = 7;  // 书库：MD=7列
          this.responsive_discoverGridColumns = 7; // 发现：MD=7列
          break;
        case Breakpoint.LG:
          this.responsive_homeGridColumns = 10;    // 首页：LG=10列
          this.responsive_libraryGridColumns = 10; // 书库：LG=10列
          this.responsive_discoverGridColumns = 10;// 发现：LG=10列
          break;
        default: // XS
          this.responsive_homeGridColumns = 4;
          this.responsive_libraryGridColumns = 5;
          this.responsive_discoverGridColumns = 5;
          break;
      }
    } else {
      // 竖屏模式下的列数配置
      this.responsive_homeGridColumns = 2;     // 首页：竖屏2列
      this.responsive_libraryGridColumns = 3;  // 书库：竖屏3列
      this.responsive_discoverGridColumns = 3; // 发现：竖屏3列
    }

    // 统一导航模式判定：顶部标签导航与底栏导航互斥
    const useTopTabsNavigation = shouldUseTabletLandscapeTopNavigation || shouldUsePhoneLandscapeSideNavigation;
    this.useTopTabsNavigation = useTopTabsNavigation;

    if (useTopTabsNavigation) {
      if (shouldUsePhoneLandscapeSideNavigation) {
        this.responsive_tabBarPosition = BarPosition.End;
        this.responsive_tabBarVertical = true;
      } else {
        const topBarPosition = this.normalizeTabletTopBarPosition(this.tabletTopBarPosition);
        const isVerticalTopBar = topBarPosition === 'left' || topBarPosition === 'right';
        this.responsive_tabBarPosition = (topBarPosition === 'bottom' || topBarPosition === 'right')
          ? BarPosition.End
          : BarPosition.Start;
        this.responsive_tabBarVertical = isVerticalTopBar;
      }
    } else {
      this.responsive_tabBarPosition = BarPosition.End;
      this.responsive_tabBarVertical = false;
    }

    this.scrollSideTabToCenter(this.currentTabIndex);

    logger.debug(TAG, `响应式参数更新: 列数=${this.responsive_gridColumns}, 首页列数=${this.responsive_homeGridColumns}, 书库列数=${this.responsive_libraryGridColumns}, 发现列数=${this.responsive_discoverGridColumns}, 间距=${this.responsive_gridGap}`);
  }

