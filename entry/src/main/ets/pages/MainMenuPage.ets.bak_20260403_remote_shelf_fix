  /**
   * 显示批量删除确认对话框
   */
  private showBatchDeleteConfirmDialog(): void {
    this.getUIContext().showAlertDialog({
      title: '确认删除',
      message: `您确定要删除选中的 ${this.selectedMangaIds.size} 部漫画吗？\n\n此操作将删除这些漫画的所有数据和文件，包括阅读进度、书签等，且不可恢复。`,
      autoCancel: true,
      alignment: DialogAlignment.Center,
      primaryButton: {
        value: '取消',
        action: () => {
          logger.info(TAG, '用户取消批量删除漫画');
        }
      },
      secondaryButton: {
        value: '确认删除',
        fontColor: ThemeAwareHelper.getTestManagementThemedColor('button_danger', this.themeState.currentTheme),
        action: async () => {
          try {
            await this.batchDeleteManga();
          } catch (error) {
            logger.error(TAG, '批量删除漫画失败', String(error));
            this.showToast('删除漫画失败');
          }
        }
      }
    });
  }

  /**
   * 构建书库内容
   */
  @Builder
  buildLibraryContent() {
    // 分类视图模式
    if (this.libraryViewMode === LibraryViewMode.CATEGORY) {
      Column() {
        // 内容区域：卡片视图或详情视图
        if (this.showCategoryDetail) {
          Stack({ alignContent: Alignment.TopStart }) {
            if (this.shelfDetailContentDeferred) {
              Column() {
                Blank()
                  .layoutWeight(1)
              }
              .width('100%')
              .layoutWeight(1)
            } else {
              // 分类详情视图（在同一Column内显示）
              this.buildCategoryDetailContent()
            }

            Column() {
              this.buildShelfDetailHeader()
            }
            .width('100%')
            .align(Alignment.TopStart)
            .zIndex(1)
          }
          .width('100%')
          .layoutWeight(1)
          .scale({ x: this.shelfDetailTransitionScale, y: this.shelfDetailTransitionScale })
          .opacity(this.shelfDetailTransitionOpacity)
          .animation({ duration: 280, curve: Curve.Linear })
        } else {
          // 分类卡片视图
          this.buildCategoryView()
        }
      }
      .width('100%')
      .height('100%')
      .transition(
        TransitionEffect.asymmetric(
          TransitionEffect.OPACITY.combine(TransitionEffect.scale({ x: 0.98, y: 0.98 }))
            .animation({ duration: 220, curve: Curve.Linear }),
          TransitionEffect.OPACITY.animation({ duration: 180, curve: Curve.Linear })
        )
