  /**
   * 构建图源内容
   */
  @Builder
  buildSourceContent() {
    Stack({ alignContent: Alignment.TopStart }) {
      Column({ space: 0 }) {
        // 顶部避让空间（为顶部导航栏留出空间）
        Blank().height(this.getInitialTopOverlaySpacerHeight())


      // 搜索栏
      Row({ space: 8 }) {
        Search({ value: this.sourceSearchKeyword, placeholder: '可使用前缀格式 pixiv//id//作品ID' })
          .searchButton('搜索')
          .layoutWeight(1)
          .onChange((value: string) => {
            this.searchSources(value);
          })
          .onSubmit(async (value: string) => {
            // 检查是否是全局前缀格式
            if (value.includes('//')) {
              const handled = await this.executeGlobalSourceSearch(value);
              if (handled) {
                // 清空搜索框
                this.sourceSearchKeyword = '';
                this.applySourceFilters();
              }
            }
          })
        
        // 快捷前缀选择按钮
        Button() {
          SymbolGlyph($r('sys.symbol.capture_smiles'))
            .fontSize(20)
            .fontColor([ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme)])
        }
        .width(40)
        .height(40)
        .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_secondary', this.themeState.currentTheme))
        .borderRadius(8)
        .bindMenu([
          {
            value: 'Pixiv - 作品ID',
            action: () => {
              this.sourceSearchKeyword = 'pixiv//id//';
              this.applySourceFilters();
            }
          },
          {
            value: 'Pixiv - 用户ID',
            action: () => {
              this.sourceSearchKeyword = 'pixiv//user//';
              this.applySourceFilters();
            }
          },
          {
            value: '禁漫天堂 - 作品ID',
            action: () => {
              this.sourceSearchKeyword = 'jm//id//';
              this.applySourceFilters();
            }
          },
          {
            value: '哔咔漫画 - 作品ID',
            action: () => {
              this.sourceSearchKeyword = 'pica//id//';
              this.applySourceFilters();
            }
          }
        ])
        
        // 代理设置按钮
        Button() {
          SymbolGlyph($r('sys.symbol.airplane_departure'))
            .fontSize(20)
            .fontColor([this.proxyConfig.enabled ? 
              ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme) :
              ThemeAwareHelper.getTestManagementThemedColor('text_secondary', this.themeState.currentTheme)])
        }
        .width(40)
        .height(40)
        .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_secondary', this.themeState.currentTheme))
        .borderRadius(8)
        .onClick(() => {
          // 加载需要代理的图源列表
          this.proxySourceList = this.sourceList.filter((s: SourceInfo) => s.requireProxy === true);
          // 初始化测试网站列表
          this.proxyTestSites = this.initProxyTestSites();
          this.showProxyDialog = true;
        })
      }
      .width('100%')
      .padding(16)
      .backgroundColor(Color.Transparent)

      // 功能按钮行
      Row({ space: 12 }) {
        // 图源管理按钮（带升级图标）
        Row({ space: 6 }) {
          // 图源管理入口按钮
          Button('图源管理')
            .fontSize(14)
            .fontFamily(this.appFontFamily)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('accent_primary', this.themeState.currentTheme))
            .onClick(() => {
              this.pathStack.pushPathByName('SourceManagementPage', null);
            })
          
          Button('图源导入')
            .fontSize(14)
            .fontFamily(this.appFontFamily)
            .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
            .onClick(() => {
              this.openSourceRepoDialog();
            })
          
          // 有更新时显示升级图标
          if (this.hasSourceUpdate) {
            Image($r('app.media.ic_upgrade'))
              .width(24)
              .height(24)
              .onClick(async () => {
                await this.quickSyncSourceRepository();
              })
          }
          
          // 类型筛选按钮
          Button() {
            Image(this.getSourceTypeFilterIcon())
              .width(24)
              .height(24)
              .fillColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          }
          .type(ButtonType.Circle)
          .width(36)
          .height(36)
          .backgroundColor(Color.Transparent)
