  /**
   * 获取可见的标签配置（根据用户自定义配置和高级模式过滤）
   */
  private getVisibleTabConfigs(): TabConfig[] {
    return this.tabConfigs.filter((cfg: TabConfig) => {
      // 必须显示的标签（书库、管理）始终显示
      if (cfg.required) {
        return true;
      }
      
      if (!this.shouldDisplayTabConfig(cfg)) {
        return false;
      }
      
      // 检查是否在用户自定义的可见列表中
      return this.visibleTabIndices.includes(cfg.index);
    });
  }

  /**
   * 根据 TabIndex 枚举值构建对应的 TabContent 内容
   * 用于动态渲染可见的标签页
   */
  @Builder
  buildTabContentForIndex(tabIndex: number) {
    if (tabIndex === TabIndex.HOME) {
      // 首页标签（支持下拉刷新）
      Refresh({ refreshing: $$this.isRefreshingHome }) {
        Scroll() {
          Column({ space: 0 }) {
            Blank().height(this.getInitialTopOverlaySpacerHeight())
            this.buildHomeContent()
            Blank().height(this.getMainTabBottomSpacerHeight())
          }
          .width('100%')
        }
          .width('100%').height('100%').scrollBar(BarState.Off).edgeEffect(EdgeEffect.Spring).backgroundColor(Color.Transparent)
          .onScrollFrameBegin((offset: number, _state: ScrollState) => {
            this.handleScrollForBottomBar(offset);
            return { offsetRemain: offset };
          })
          .onScrollStop(() => {
            this.handleScrollEndForBottomBar();
          })
      }
      .onRefreshing(async () => {
        await this.silentRefreshRecentReadingList();
        this.isRefreshingHome = false;
      })
      .width('100%')
      .height('100%')
      .backgroundColor(Color.Transparent)
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.LIBRARY) {
      // 书库标签
      Refresh({ refreshing: this.isRefreshing }) {
        Scroll() {
          Column({ space: 0 }) {
            Blank().height(this.getInitialTopOverlaySpacerHeight())
            this.buildLibraryContent()
          }
          .width('100%')
        }
        .width('100%').height('100%').scrollBar(BarState.Off).edgeEffect(EdgeEffect.Spring).backgroundColor(Color.Transparent)
        .onScrollFrameBegin((offset: number, _state: ScrollState) => {
            this.handleScrollForBottomBar(offset);
            return { offsetRemain: offset };
          })
          .onScrollStop(() => {
            this.handleScrollEndForBottomBar();
          })
      }
      .onRefreshing(async () => {
        logger.info(TAG, `[书库下拉刷新] onRefreshing已触发，当前模式=${this.libraryViewMode}`);
        this.showLibraryRefreshFloatingBarTemporarily();
        if (this.libraryViewMode === LibraryViewMode.CATEGORY) {
          logger.info(TAG, '[书库下拉刷新] 触发书架视图刷新');
          await this.refreshShelfViewContent();
        } else {
          logger.info(TAG, '[书库下拉刷新] 触发默认书库刷新');
          await this.refreshMangaList();
        }
      })
      .width('100%')
      .height('100%')
      .backgroundColor(Color.Transparent)
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.DISCOVER) {
      // 发现标签
      Refresh({ refreshing: $$this.isRefreshingDiscover }) {
        Scroll() { this.buildDiscoverContent() }
          .width('100%').height('100%').scrollBar(BarState.Off).edgeEffect(EdgeEffect.Spring).backgroundColor(Color.Transparent)
          .onScrollFrameBegin((offset: number, _state: ScrollState) => {
            this.handleScrollForBottomBar(offset);
            return { offsetRemain: offset };
          })
          .onScrollStop(() => {
            this.handleScrollEndForBottomBar();
          })
      }
      .onRefreshing(() => {
        this.refreshDiscoverData();
      })
      .width('100%')
      .height('100%')
      .backgroundColor(Color.Transparent)
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.SOURCE) {
      // 图源标签（高级模式）
      Column() {
        this.buildSourceContent()
      }
      .width('100%')
      .height('100%')
      .backgroundColor(Color.Transparent)
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.BOOK_SOURCE) {
      // 书源标签（小说源发现+搜索）
      Refresh({ refreshing: $$this.isRefreshingBookSource }) {
        this.buildBookSourceContent()
      }
      .onRefreshing(() => {
        this.refreshBookSourceContent();
      })
      .width('100%')
      .height('100%')
      .backgroundColor(Color.Transparent)
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.SUWAYOMI) {
      // Suwayomi标签
      Refresh({ refreshing: $$this.isRefreshingSuwayomi }) {
        this.buildSuwayomiContent()
      }
      .onRefreshing(() => {
        this.refreshSuwayomiContent();
      })
      .width('100%')
      .height('100%')
      .backgroundColor(Color.Transparent)
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.KOMGA) {
      MainMenuKomgaTabContent({
        topSpacerHeight: this.getInitialTopOverlaySpacerHeight(),
        bottomSpacerHeight: this.getKomgaBottomSpacerHeight(),
        refreshSignal: this.komgaTabRefreshSignal
      })
        .width('100%')
        .height('100%')
        .backgroundColor(Color.Transparent)
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    } else if (tabIndex === TabIndex.SETTINGS) {
      // 设置标签
      Column() { this.buildSettingsContent() }
        .width('100%').height('100%').backgroundColor(Color.Transparent)
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
    }
  }

