    switch (this.libraryDefaultSortType) {
      case 'name_asc':
        return '名称升序';
      case 'name_desc':
        return '名称降序';
      case 'recent':
        return '最近阅读';
      case 'add_asc':
        return '最早添加';
      case 'add_desc':
