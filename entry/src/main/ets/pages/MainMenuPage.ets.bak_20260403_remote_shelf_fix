  private getFloatingSearchButtonX(): number {
    return this.shouldAnchorFloatingSearchButtonToLeft()
      ? this.getFloatingSearchButtonLeftX()
      : this.getFloatingSearchButtonRightX();
  }

  private getFloatingSearchButtonY(): number {
    if (!this.useTopTabsNavigation) {
      if (this.isOverlayBottomNavTab(this.currentTabIndex)) {
        const deviceInfo = this.deviceManager.getDeviceInfo();
        const y: number = deviceInfo.screenHeight
          - this.getOverlayBottomNavSpacerHeight(this.currentTabIndex)
          - this.FLOAT_SEARCH_BUTTON_SIZE
          - this.FLOAT_SEARCH_BUTTON_MARGIN;
        return y > this.statusBarHeight ? y : this.statusBarHeight;
      }
      const baseY: number = this.getBottomBarY()
        - this.FLOAT_SEARCH_BUTTON_SIZE
        - this.FLOAT_SEARCH_BUTTON_MARGIN;
      const effectiveBottomBarOffset: number = this.getEffectiveBottomBarOffset();
      // 底栏隐藏时采用“部分跟随 + 隐藏态固定悬浮位”，避免搜索按钮下沉过低
      const bottomBarTravelDistance: number = this.getBottomBarTravelDistance();
      const hiddenRatio: number = bottomBarTravelDistance > 0
        ? effectiveBottomBarOffset / bottomBarTravelDistance
        : 0;
      let y: number;
      if (hiddenRatio >= 0.85) {
        y = baseY + bottomBarTravelDistance * 0.30;
      } else if (hiddenRatio > 0) {
        y = baseY + effectiveBottomBarOffset * 0.35;
      } else {
        y = baseY;
      }
      return y > this.statusBarHeight ? y : this.statusBarHeight;
    }

    const effectivePosition = this.getEffectiveTabletTopBarPosition();
    if (effectivePosition === 'left' || effectivePosition === 'right') {
      const y: number = this.statusBarHeight + this.TABLET_TOP_BAR_VERTICAL_MARGIN;
      return y > this.statusBarHeight ? y : this.statusBarHeight;
    }
    if (effectivePosition === 'bottom') {
      const y: number = this.getBottomBarY() - this.FLOAT_SEARCH_BUTTON_SIZE - this.FLOAT_SEARCH_BUTTON_MARGIN;
      return y > this.statusBarHeight ? y : this.statusBarHeight;
    }
    return this.getAdaptiveTopOperationBarY() + (this.BOTTOM_BAR_HEIGHT - this.FLOAT_SEARCH_BUTTON_SIZE) / 2;
  }

