  /**
   * 切换标签可见性
   */
  private toggleTabVisibility(index: number): void {
    // 使用数组重新赋值而不是splice/push，避免触发过多的UI更新
    const newIndices: number[] = [];
    const idx = this.tempVisibleTabIndices.indexOf(index);
    
    if (idx > -1) {
      // 移除该索引
      for (let i = 0; i < this.tempVisibleTabIndices.length; i++) {
        if (this.tempVisibleTabIndices[i] !== index) {
          newIndices.push(this.tempVisibleTabIndices[i]);
        }
      }
    } else {
      // 添加该索引
      for (let i = 0; i < this.tempVisibleTabIndices.length; i++) {
        newIndices.push(this.tempVisibleTabIndices[i]);
      }
      newIndices.push(index);
    }
    
    // 一次性赋值，只触发一次UI更新
    this.tempVisibleTabIndices = newIndices;
  }

  /**
   * 应用标签自定义配置
   */
  private async applyTabCustomization(): Promise<void> {
    await this.saveVisibleTabs(this.tempVisibleTabIndices);
    this.showTabCustomDialog = false;
    // 应用后切换到第一个可见标签（避免停留在被隐藏的标签）
    // 注意：saveVisibleTabs 已经更新了 cachedVisibleTabConfigs
    if (this.cachedVisibleTabConfigs.length > 0) {
      this.currentTabIndex = this.cachedVisibleTabConfigs[0].index;
      this.changeMainContentToActualIndex(0, false);
    }
    this.showToast('底栏配置已保存');
  }

  /**
   * 将 TabIndex 枚举值转换为实际 Tabs 组件中的位置索引
   * @param tabIndex TabIndex 枚举值（如 TabIndex.HOME = 0）
   * @returns 在可见标签列表中的位置（0, 1, 2...），如果不可见则返回 -1
   */
  private getActualTabsIndexForTabIndex(tabIndex: number): number {
    // 使用缓存的可见标签配置
    for (let i = 0; i < this.cachedVisibleTabConfigs.length; i++) {
      if (this.cachedVisibleTabConfigs[i].index === tabIndex) {
        return i;
      }
    }
    return -1;
  }

  /**
   * 将实际 Tabs 组件位置索引转换为 TabIndex 枚举值
   * @param actualIndex Tabs 组件中的位置索引（0, 1, 2...）
   * @returns TabIndex 枚举值，如果越界则返回第一个可见标签的索引
   */
  private getTabIndexForActualTabsIndex(actualIndex: number): number {
    // 使用缓存的可见标签配置
    if (actualIndex >= 0 && actualIndex < this.cachedVisibleTabConfigs.length) {
      return this.cachedVisibleTabConfigs[actualIndex].index;
    }
    // 越界时返回第一个可见标签
    return this.cachedVisibleTabConfigs.length > 0 ? this.cachedVisibleTabConfigs[0].index : TabIndex.LIBRARY;
  }

  private changeMainContentToActualIndex(actualIndex: number, animated: boolean = true): void {
    if (actualIndex < 0) {
      return;
    }
    if (!animated) {
      this.lastCommittedTabIndex = this.getTabIndexForActualTabsIndex(actualIndex);
      this.syncBottomBarVisualProgressFromActualIndex(actualIndex);
    }
    const currentActualIndex: number = this.getActualTabsIndexForTabIndex(this.lastCommittedTabIndex);
    const animationMode: SwiperAnimationMode = !animated
      ? SwiperAnimationMode.NO_ANIMATION
      : (Math.abs(actualIndex - currentActualIndex) > 1
        ? SwiperAnimationMode.FAST_ANIMATION
        : SwiperAnimationMode.DEFAULT_ANIMATION);
    this.tabsController.changeIndex(actualIndex, animationMode);
  }

  private changeMainContentToTabIndex(tabIndex: number, animated: boolean = true): void {
    const actualIndex = this.getActualTabsIndexForTabIndex(tabIndex);
    if (actualIndex < 0) {
      logger.warn(TAG, `标签 ${tabIndex} 当前不可见，无法切换`);
      return;
    }
    this.changeMainContentToActualIndex(actualIndex, animated);
  }

