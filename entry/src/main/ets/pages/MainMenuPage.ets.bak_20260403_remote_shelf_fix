  }

  private scheduleMainMenuWindowInsetsResync(
    delayMs: number = this.MAIN_MENU_WINDOW_INSETS_RESYNC_DELAY
  ): void {
    this.clearMainMenuWindowInsetsResyncTimer();
    this.mainMenuWindowInsetsResyncTimer = setTimeout(() => {
      this.mainMenuWindowInsetsResyncTimer = -1;
      if (this.pathStack.size() > 0) {
        return;
      }
      const uiContext = this.getUIContext();
      if (!uiContext) {
        return;
      }

      // Reader pages can return before avoid-area values finish settling.
      PageWindowCoordinator.reapplyPagePolicy('MainMenuPage', uiContext);
    }, Math.max(0, delayMs));
  }

  private prepareMainMenuReentryShield(): void {
    this.mainMenuRootRevealLocked = true;
    this.mainMenuReentryShieldVisible = true;
    this.mainMenuReentryShieldOpacity = 1;
    this.updateMainMenuGlobalBackgroundVisibility(this.pathStack.size());
  }

  private revealMainMenuAfterReturn(withAnimation: boolean): void {
    this.mainMenuRootRevealLocked = false;
    this.updateMainMenuGlobalBackgroundVisibility(0);
    if (!this.mainMenuReentryShieldVisible) {
      return;
    }
    if (!withAnimation) {
      this.mainMenuReentryShieldOpacity = 0;
      this.mainMenuReentryShieldVisible = false;
      return;
    }

    animateTo({
      duration: this.WINDOW_MODE_TRANSITION_FADE_OUT_DURATION,
      curve: Curve.EaseOut
    }, () => {
      this.mainMenuReentryShieldOpacity = 0;
    });
  }

  private restoreBottomBarAfterMainMenuReturn(): void {
    if (this.useTopTabsNavigation) {
      return;
    }
    this.resetBottomBarScrollState();
    this.bottomBarOffsetY = this.isOverlayBottomNavTab(this.currentTabIndex) ? this.getBottomBarTravelDistance() : 0;
    setTimeout(() => {
      if (this.useTopTabsNavigation) {
        return;
      }
      this.resetBottomBarScrollState();
      this.bottomBarOffsetY = this.isOverlayBottomNavTab(this.currentTabIndex) ? this.getBottomBarTravelDistance() : 0;
    }, this.WINDOW_MODE_TRANSITION_FADE_OUT_DURATION + 60);
  }

  private updateMainMenuGlobalBackgroundVisibility(stackSize?: number): void {
    const size = typeof stackSize === 'number' ? stackSize : this.pathStack.size();
    const shouldShow = size === 0 && !this.mainMenuRootRevealLocked;
    if (this.showMainMenuGlobalBackground !== shouldShow) {
      this.showMainMenuGlobalBackground = shouldShow;
    }
  }

  private applyMainMenuWindowModeWithTransition(): void {
    if (this.windowModeTransitionOverlayVisible || this.windowModeTransitionSwitchTimer >= 0 ||
      this.windowModeTransitionCleanupTimer >= 0) {
      return;
    }
    const uiContext = this.getUIContext();
    const previousMode = WindowManager.getCurrentMode();
    const needsVisualTransition = previousMode !== DisplayMode.DEFAULT || this.mainMenuReentryNeedsTransition;
    this.mainMenuReentryNeedsTransition = false;
    if (!needsVisualTransition) {
      this.clearWindowModeTransitionTimers();
      this.windowModeTransitionOverlayVisible = false;
      this.windowModeTransitionOverlayOpacity = 0;
      const shouldAnimateShield = this.mainMenuReentryShieldVisible;
      this.revealMainMenuAfterReturn(shouldAnimateShield);
      this.restoreBottomBarAfterMainMenuReturn();
      if (shouldAnimateShield) {
        this.windowModeTransitionCleanupTimer = setTimeout(() => {
          this.windowModeTransitionCleanupTimer = -1;
          this.mainMenuReentryShieldVisible = false;
        }, this.WINDOW_MODE_TRANSITION_FADE_OUT_DURATION + 40);
      }
      this.scheduleMainMenuWindowInsetsResync();
      return;
    }

    this.clearWindowModeTransitionTimers();
    this.prepareMainMenuReentryShield();
    this.windowModeTransitionOverlayVisible = true;
    this.windowModeTransitionOverlayOpacity = this.WINDOW_MODE_TRANSITION_PEAK_OPACITY;

    // Keep anti-flash priority: switch mode right after overlay is in place.
    this.windowModeTransitionSwitchTimer = setTimeout(() => {
      this.windowModeTransitionSwitchTimer = -1;
      PageWindowCoordinator.applyRootMainMenu(uiContext);
      this.scheduleMainMenuWindowInsetsResync();
      this.restoreBottomBarAfterMainMenuReturn();
      animateTo({
        duration: this.WINDOW_MODE_TRANSITION_FADE_OUT_DURATION,
        curve: Curve.EaseOut
      }, () => {
        this.windowModeTransitionOverlayOpacity = 0;
      });
      this.revealMainMenuAfterReturn(true);
      this.windowModeTransitionCleanupTimer = setTimeout(() => {
        this.windowModeTransitionCleanupTimer = -1;
        this.windowModeTransitionOverlayVisible = false;
        this.mainMenuReentryShieldVisible = false;
      }, this.WINDOW_MODE_TRANSITION_FADE_OUT_DURATION + 40);
    }, this.WINDOW_MODE_TRANSITION_SWITCH_DELAY);
  }

  private startNavStackReturnWatch(): void {
    this.stopNavStackReturnWatch();
    this.lastObservedNavStackSize = this.pathStack.size();
    if (this.lastObservedNavStackSize > 0) {
      this.prepareMainMenuReentryShield();
    } else {
      this.mainMenuRootRevealLocked = false;
      this.mainMenuReentryShieldVisible = false;
      this.mainMenuReentryShieldOpacity = 0;
    }
    this.updateMainMenuGlobalBackgroundVisibility(this.lastObservedNavStackSize);
    this.navStackReturnWatchTimer = setInterval(() => {
      const currentSize = this.pathStack.size();
      if (currentSize > 0) {
        this.prepareMainMenuReentryShield();
      }
      this.updateMainMenuGlobalBackgroundVisibility(currentSize);
      if (this.lastObservedNavStackSize > 0 && currentSize === 0) {
        this.mainMenuReentryNeedsTransition = true;
        this.applyMainMenuWindowModeWithTransition();
      }
      this.lastObservedNavStackSize = currentSize;
    }, this.WINDOW_MODE_TRANSITION_TRIGGER_RETRY_INTERVAL);
  }

  private stopNavStackReturnWatch(): void {
    if (this.navStackReturnWatchTimer >= 0) {
      clearInterval(this.navStackReturnWatchTimer);
      this.navStackReturnWatchTimer = -1;
    }
  }

  /**
   * 页面显示时静默刷新数据
   * 确保从任何页面返回时都能正确显示最新的阅读情况
   * 使用静默刷新避免闪屏
   */
  onPageShow(): void {
    logger.lifecycle(TAG, '📱 页面显示，静默刷新数据');
    void this.holdingAwarenessManager.resume();
    this.logHoldingAwareFloatingSearchDecision('页面显示');
    this.updateMainMenuGlobalBackgroundVisibility();
    this.applyMainMenuWindowModeWithTransition();
    this.scheduleMainMenuWindowInsetsResync();
    if (WindowManager.getCurrentMode() !== DisplayMode.DEFAULT || this.mainMenuReentryShieldVisible) {
      this.restoreBottomBarAfterMainMenuReturn();
    }
    void this.loadLibraryViewMode();
    if (this.fromGuide && this.guideTargetPageOpened && this.targetPage.length > 0) {
      try {
        if (this.pathStack.size() === 0 && !this.welcomeGuideManager.isGuideCompleted()) {
          logger.info(TAG, '页面重新显示时检测到引导目标页已返回，回到欢迎引导继续流程');
          this.returnToGuide();
          return;
        }
      } catch (error) {
        logger.error(TAG, '页面显示时检测引导返回失败', String(error));
      }
    }

    // 检查是否有待处理的文件打开请求（来自onNewWant）
    this.checkPendingFileImport();
    
    // 检查是否有卡片跳转请求（来自onNewWant或onCreate）
    void this.handleWidgetNavigationIfPresent(this.startupRoutePending);

    void widgetDataSync.syncAllDataThrottled();

    // 根据当前标签页静默刷新对应数据（不显示加载状态，避免闪屏）
    switch (this.currentTabIndex) {
      case TabIndex.HOME:
        // 首页：静默刷新最近阅读列表
        this.silentRefreshRecentReadingList();
        break;
      case TabIndex.LIBRARY:
        // 书库：静默刷新漫画和电子书列表
        this.silentRefreshLibrary();
        break;
      case TabIndex.DISCOVER:
        // 发现页：静默刷新发现页数据
        this.silentRefreshDiscoverData();
        break;
      case TabIndex.SOURCE:
        // 图源页：静默刷新图源列表
        this.silentRefreshSources();
        break;
      case TabIndex.BOOK_SOURCE:
        // 书源页：确保初始化并加载书源列表
        this.initializeAndLoadBookSources();
        break;
      case TabIndex.SUWAYOMI:
        this.silentInitializeSuwayomi();
        break;
      case TabIndex.KOMGA:
        this.komgaTabRefreshSignal = this.komgaTabRefreshSignal + 1;
        break;
      default:
        break;
    }

    if (!this.startupRoutePending) {
      void this.refreshMainMenuGuide('onPageShow');
    }
  }

