  private getBottomBarIndicatorVisualEffect() {
    const glowColor: ResourceColor = this.getBottomBarGlowColor(this.getBottomBarVisualTabIndex());
    const glowStrength: number = 0.52 + this.bottomBarIndicatorGlowStrength * 0.48;
    const builder: hdsEffect.HdsEffectBuilder = new hdsEffect.HdsEffectBuilder();

    builder.pointLight({
      illuminatedType: hdsEffect.PointLightIlluminatedType.DEFAULT_FEATHERING_BORDER,
      options: {
        color: glowColor,
        intensity: (this.themeState.currentTheme === ThemeType.DARK ? 0.36 : 0.24) * glowStrength,
        height: this.themeState.currentTheme === ThemeType.DARK ? 60 : 48,
        bloom: (this.themeState.currentTheme === ThemeType.DARK ? 0.28 : 0.14) * (0.68 + this.bottomBarIndicatorGlowStrength * 0.32)
      }
    });

    return builder.buildEffect();
  }

  private canStartBottomBarFakeDrag(): boolean {
    if (this.useTopTabsNavigation || this.cachedVisibleTabConfigs.length <= 1) {
      return false;
    }
    if (this.isOverlayBottomNavTab(this.currentTabIndex)) {
      return false;
    }
    return true;
  }

  private beginBottomBarFakeDrag(event: GestureEvent): void {
    if (!this.canStartBottomBarFakeDrag()) {
      return;
    }
    const pressProgress: number = this.getBottomBarIndicatorProgressFromLocalX(this.getBottomBarGestureLocalX(event));
    this.isBottomBarIndicatorDragging = true;
    this.bottomBarFakeDragLastProgress = pressProgress;
    this.bottomBarFakeDragLastOffsetX = event.offsetX;
    this.showBottomBarIndicator(pressProgress, true);
    try {
      this.tabsController.finishAnimation();
    } catch (error) {
      logger.debug(TAG, `底栏开始拖动前结束动画失败: ${String(error)}`);
    }
    this.isBottomBarFakeDragging = this.tabsController.startFakeDrag();
    this.suppressTabClickUntil = Date.now() + 180;
  }

  private updateBottomBarFakeDrag(event: GestureEvent): void {
    if (!this.isBottomBarIndicatorDragging && !this.isBottomBarFakeDragging) {
      return;
    }
    const progress: number = this.getBottomBarIndicatorProgressFromLocalX(this.getBottomBarGestureLocalX(event));
    this.bottomBarIndicatorInteractiveProgress = progress;
    this.bottomBarIndicatorGlowStrength = 1;
    this.bottomBarIndicatorLiftY = 0;
    this.bottomBarIndicatorOpacity = 1;
    this.bottomBarIndicatorScale = 1;
    const deltaProgress: number = progress - this.bottomBarFakeDragLastProgress;
    this.bottomBarFakeDragLastProgress = progress;
    const deltaX: number = event.offsetX - this.bottomBarFakeDragLastOffsetX;
    this.bottomBarFakeDragLastOffsetX = event.offsetX;
    if (!this.isBottomBarFakeDragging || Math.abs(deltaProgress) < 0.0001) {
      return;
    }
    const contentDeltaX: number = -deltaProgress * this.getBottomBarFakeDragAxisLength();
    if (Math.abs(contentDeltaX) < 0.01 && Math.abs(deltaX) < 0.01) {
      return;
    }
    this.tabsController.fakeDragBy(contentDeltaX);
  }

  private endBottomBarFakeDrag(): void {
    if (!this.isBottomBarIndicatorDragging && !this.isBottomBarFakeDragging) {
      return;
    }
    const currentActualIndex: number = this.getActualTabsIndexForTabIndex(this.lastCommittedTabIndex);
    const targetActualIndex: number = this.getBottomBarVisualActualIndex();
    const targetTabIndex: number = this.getTabIndexForActualTabsIndex(targetActualIndex);
    const wasFakeDragging: boolean = this.isBottomBarFakeDragging;
    this.isBottomBarIndicatorDragging = false;
    this.isBottomBarFakeDragging = false;
    this.bottomBarFakeDragLastOffsetX = 0;
    this.bottomBarFakeDragLastProgress = 0;
    this.suppressTabClickUntil = Date.now() + 180;
    let stopped: boolean = false;
    if (wasFakeDragging) {
      stopped = this.tabsController.stopFakeDrag();
    }
    this.pulseBottomBarIndicator(targetActualIndex);
    if (targetActualIndex === currentActualIndex) {
      this.triggerBottomBarSelectionBounce(targetTabIndex);
      this.hideBottomBarIndicator(240);
      return;
    }
    if (stopped || !wasFakeDragging) {
      this.changeMainContentToActualIndex(targetActualIndex, true);
      this.hideBottomBarIndicator(360);
      return;
    }
    this.syncBottomBarVisualProgressFromActualIndex(this.getActualTabsIndexForTabIndex(this.currentTabIndex));
    this.hideBottomBarIndicator(180);
  }

  private handleMainContentDidScroll(_selectedIndex: number, index: number, position: number, _mainAxisLength: number): void {
    if (index < 0) {
      return;
    }
    if (_mainAxisLength > 0) {
      this.bottomBarFakeDragMainAxisLength = _mainAxisLength;
    }
    this.bottomBarVisualProgress = this.clampBottomBarVisualProgress(index - position);
  }

  private getEffectiveBottomBarOffset(): number {
    if (this.isOverlayBottomNavTab(this.currentTabIndex)) {
      return this.getBottomBarTravelDistance();
    }
    if (!isMainPageBottomBarAnimationEnabled()) {
      return 0;
    }
    return this.bottomBarOffsetY;
  }

  private getBottomBarTravelDistance(): number {
    // 底栏是悬浮布局，隐藏时要连同底部留白一起移出屏幕，否则会始终露出半截。
    return this.BOTTOM_BAR_HEIGHT + this.BOTTOM_BAR_MARGIN_BOTTOM;
  }

  private clampBottomBarOffset(rawOffset: number): number {
    return Math.max(0, Math.min(this.getBottomBarTravelDistance(), rawOffset));
  }

  private animateBottomBarTo(targetOffset: number, duration: number, curve: Curve): void {
    if (Math.abs(this.bottomBarOffsetY - targetOffset) < 0.01) {
      this.bottomBarOffsetY = targetOffset;
      return;
    }
    animateTo({
      duration: duration,
      curve: curve
    }, () => {
      this.bottomBarOffsetY = targetOffset;
    });
  }

  private clearBottomBarSettleTimer(): void {
    if (this.bottomBarSettleTimer >= 0) {
      clearTimeout(this.bottomBarSettleTimer);
      this.bottomBarSettleTimer = -1;
    }
  }

  private triggerBottomBarSelectionBounce(tabIndex: number): void {
    if (this.bottomBarBounceTimer >= 0) {
      clearTimeout(this.bottomBarBounceTimer);
      this.bottomBarBounceTimer = -1;
    }

    this.bottomBarBounceTabIndex = tabIndex;
    this.bottomBarBounceScale = 0.92;
    animateTo({
      duration: 110,
      curve: Curve.EaseOut
    }, () => {
      this.bottomBarBounceScale = 1.08;
    });

    this.bottomBarBounceTimer = setTimeout(() => {
      animateTo({
        duration: 180,
        curve: Curve.EaseOut
      }, () => {
        this.bottomBarBounceScale = 1;
      });
      this.bottomBarBounceTimer = -1;
    }, 110);
  }

  /**
   * 处理滚动事件，实现底栏跟手滑动隐藏/显示
   * @param deltaY Y轴滚动偏移量变化值（正值=向下滚动，负值=向上滚动）
   */
  private handleScrollForBottomBar(deltaY: number): void {
    if (!isMainPageBottomBarAnimationEnabled() || this.useTopTabsNavigation || this.isOverlayBottomNavTab(this.currentTabIndex)) {
      return;
    }
    this.clearBottomBarSettleTimer();

    if (Math.abs(deltaY) <= 0.01) {
      return;
    }

    this.bottomBarLastScrollDirection = deltaY > 0 ? 1 : -1;
    this.bottomBarScrollAccumulator = Math.min(this.getBottomBarTravelDistance(), Math.abs(deltaY));

    const nextOffset = this.clampBottomBarOffset(this.bottomBarOffsetY + deltaY);
    if (Math.abs(nextOffset - this.bottomBarOffsetY) < 0.01) {
      return;
    }
    this.bottomBarOffsetY = nextOffset;
  }

  private settleBottomBarAfterScrollStop(): void {
    this.clearBottomBarSettleTimer();
    this.bottomBarSettleTimer = setTimeout(() => {
      this.bottomBarSettleTimer = -1;

      if (!isMainPageBottomBarAnimationEnabled()) {
        this.resetBottomBarScrollState();
        return;
      }

      if (this.useTopTabsNavigation || this.isOverlayBottomNavTab(this.currentTabIndex)) {
        this.resetBottomBarScrollState();
        return;
      }

      const projectedOffset = this.clampBottomBarOffset(
        this.bottomBarOffsetY + this.bottomBarLastScrollDirection * Math.min(this.BOTTOM_BAR_SETTLE_DIRECTION_BIAS, this.bottomBarScrollAccumulator)
      );
      const shouldHide = projectedOffset >= this.BOTTOM_BAR_HEIGHT * this.BOTTOM_BAR_SETTLE_SNAP_RATIO;
      const targetOffset = shouldHide ? this.getBottomBarTravelDistance() : 0;
      const duration = targetOffset === 0 ? this.BOTTOM_BAR_SHOW_SETTLE_DURATION : this.BOTTOM_BAR_HIDE_SETTLE_DURATION;
      const curve = targetOffset === 0 ? Curve.EaseOut : Curve.EaseInOut;
      this.resetBottomBarScrollState();
      this.animateBottomBarTo(targetOffset, duration, curve);
    }, this.BOTTOM_BAR_STOP_SETTLE_DELAY);
  }

  /**
   * 处理滚动结束事件，自动完成底栏的显示/隐藏
   */
  private handleScrollEndForBottomBar(): void {
    if (!isMainPageBottomBarAnimationEnabled()) {
      this.resetBottomBarScrollState();
      return;
    }

    if (this.useTopTabsNavigation || this.isOverlayBottomNavTab(this.currentTabIndex)) {
      this.resetBottomBarScrollState();
      return;
    }
    this.settleBottomBarAfterScrollStop();
  }

  /**
   * 重置底栏滚动状态（用于切换标签页时）
   */
  private resetBottomBarScrollState(): void {
    this.clearBottomBarSettleTimer();
    this.bottomBarScrollAccumulator = 0;
    this.bottomBarLastScrollDirection = 0;
  }

  private handleMainContentIndexChanged(actualIndex: number): void {
    const previousTabIndex = this.lastCommittedTabIndex;
    const tabIndex = this.getTabIndexForActualTabsIndex(actualIndex);
    this.isBottomBarFakeDragging = false;
    this.isBottomBarIndicatorDragging = false;
    this.bottomBarFakeDragLastOffsetX = 0;
    this.bottomBarFakeDragLastProgress = 0;
    this.lastCommittedTabIndex = tabIndex;
    this.currentTabIndex = tabIndex;
    this.syncBottomBarVisualProgressFromActualIndex(actualIndex);
    if (this.bottomBarIndicatorVisible) {
      this.bottomBarIndicatorInteractiveProgress = this.clampBottomBarVisualProgress(actualIndex);
      this.hideBottomBarIndicator(this.BOTTOM_BAR_INDICATOR_HIDE_DELAY);
    }
    this.scrollSideTabToCenter(tabIndex);
    logger.info(TAG, `标签页切换: 实际位置=${actualIndex}, TabIndex=${tabIndex}`);
    if (previousTabIndex !== tabIndex) {
      this.triggerBottomBarSelectionBounce(tabIndex);
    }

    this.resetBottomBarScrollState();
    if (this.isOverlayBottomNavTab(tabIndex)) {
      animateTo({
        duration: 200,
        curve: Curve.EaseOut
      }, () => {
        this.bottomBarOffsetY = this.getBottomBarTravelDistance();
      });
    } else {
      animateTo({
        duration: 200,
        curve: Curve.EaseOut
      }, () => {
        this.bottomBarOffsetY = 0;
      });
    }

    if (previousTabIndex === TabIndex.SETTINGS && tabIndex !== TabIndex.SETTINGS) {
      logger.info(TAG, '从设置页返回，重新加载用户配置');
      this.loadUserThemeConfig();
      this.loadVisibleTabs();
      void this.loadLibraryViewMode();
      if (tabIndex === TabIndex.KOMGA) {
        this.komgaTabRefreshSignal = this.komgaTabRefreshSignal + 1;
      }
    }

    switch (tabIndex) {
      case TabIndex.HOME:
        this.silentRefreshRecentReadingList();
        break;
      case TabIndex.LIBRARY:
        this.silentRefreshLibrary();
        break;
      case TabIndex.DISCOVER:
        this.silentRefreshDiscoverData();
        break;
      case TabIndex.SOURCE:
        this.silentRefreshSources();
        break;
      case TabIndex.BOOK_SOURCE:
        this.initializeAndLoadBookSources();
        break;
      case TabIndex.SUWAYOMI:
        this.silentInitializeSuwayomi();
        break;
      case TabIndex.KOMGA:
      default:
        break;
    }
  }

  build() {
    Stack() {
    // 仅在 MainMenu 根页面显示全局背景，避免子页面状态栏透出 MainMenu 背景层
    if (this.showMainMenuGlobalBackground) {
      GlobalBackgroundLayer({
        defaultBackgroundColor: ThemeAwareHelper.getTestManagementThemedColor('background_primary', this.themeState.currentTheme)
      })
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
    } else {
      SharedPageBackgroundLayer({
        defaultBackgroundColor: ThemeAwareHelper.getTestManagementThemedColor('background_primary', this.themeState.currentTheme),
        mode: GlobalBackgroundLayerMode.IMMERSIVE,
        renderFallbackLayer: false
      })
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
    }

    Navigation(this.pathStack) {
      Stack({ alignContent: Alignment.TopStart }) {
        // 主内容区域（透明背景以显示自定义主题）
        Column() {
          // 顶部标题栏：平板横屏显示专用顶栏，其他设备显示默认顶栏
          // 使用barRenderKey触发重新渲染（屏幕方向或折叠状态变化时）
          // 主要内容区域包装器 - 包含底部导航栏避让
          Column() {
            // 主要内容区域 - 使用Tabs动态渲染可见标签页
            Swiper(this.tabsController) {
              // 动态渲染可见的标签页（使用缓存数组避免ForEach无限渲染）
              ForEach(this.cachedVisibleTabConfigs, (cfg: TabConfig) => {
                Stack() {
                  this.buildTabContentForIndex(cfg.index)
                }
                .width('100%')
                .height('100%')
                .backgroundColor(Color.Transparent)
                .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
                .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.BOTTOM])
              }, (cfg: TabConfig) => `tab_${cfg.index}`)
            }
            .layoutWeight(1)
            .backgroundColor(Color.Transparent)
            .indicator(false)
            .loop(false)
            .cachedCount(3)
            .duration(260)
            .curve(Curve.EaseOut)
            .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
            .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.BOTTOM])
            .onAppear(() => {
              this.changeMainContentToActualIndex(this.getActualTabsIndexForTabIndex(this.currentTabIndex), false);
            })
            .onContentDidScroll((selectedIndex: number, index: number, position: number, mainAxisLength: number) => {
              this.handleMainContentDidScroll(selectedIndex, index, position, mainAxisLength);
            })
            .onChange((actualIndex: number) => {
              this.handleMainContentIndexChanged(actualIndex);
            })
          }
          .layoutWeight(1)
          .width('100%')
          .padding({
            top: this.getMainContentTopInset(),
            left: this.getTabletTopNavigationLeftInset(),
            right: this.getTabletTopNavigationRightInset(),
            bottom: this.getTabletTopNavigationBottomInset()
          })
          .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
          .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.BOTTOM])

        }
        .width('100%')
        .height('100%')
        .backgroundColor(Color.Transparent) // 透明背景以显示全局背景层
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.BOTTOM])
        .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.BOTTOM])

        if (this.shouldShowPrivacyExitButton()) {
          Column() {
            this.buildFloatingPrivacyExitButton()
          }
          .width(this.FLOAT_SEARCH_BUTTON_SIZE)
          .height(this.FLOAT_SEARCH_BUTTON_SIZE)
          .position({ x: this.getFloatingPrivacyExitButtonX(), y: this.getFloatingSearchButtonY() })
          .animation({ duration: 220, curve: Curve.EaseInOut })
          .zIndex(20)
          .key(`floatingPrivacyExit_${this.barRenderKey}`)
        }

        if (this.shouldShowShelfPreviewSlider()) {
          Column() {
            this.buildShelfDetailDisplayFloatingBar()
          }
          .position({
            x: this.getShelfPreviewSliderX(),
            y: this.getShelfDetailDisplayFloatingBarY()
          })
          .zIndex(20)
          .key(`shelfDetailDisplay_${this.barRenderKey}`)

          Column() {
            this.buildShelfPreviewSliderFloatingBar()
          }
          .position({ x: this.getShelfPreviewSliderX(), y: this.getShelfPreviewSliderY() })
          .zIndex(20)
          .key(`shelfPreviewSlider_${this.barRenderKey}`)
        }

        Column() {
          this.buildFloatingSearchButton()
        }
        .width(this.FLOAT_SEARCH_BUTTON_SIZE)
        .height(this.FLOAT_SEARCH_BUTTON_SIZE)
        .position({ x: this.getFloatingSearchButtonX(), y: this.getFloatingSearchButtonY() })
        .animation({ duration: 220, curve: Curve.EaseInOut })
        .zIndex(20)
        .key(`floatingSearch_${this.barRenderKey}`)

        if (this.shouldAttachLibraryFloatingBar()) {
          Column() {
            this.buildLibraryRefreshFloatingBar()
          }
          .width(this.getLibraryFloatingBarWidth())
          .position({ x: this.getLibraryFloatingBarX(), y: this.getLibraryFloatingBarY() })
          .translate({ y: this.showLibraryRefreshFloatingBar ? 0 : -14 })
          .opacity(this.showLibraryRefreshFloatingBar ? 1 : 0)
          .animation({
            duration: 260,
            curve: Curve.EaseInOut
          })
          .hitTestBehavior(this.showLibraryRefreshFloatingBar ? HitTestMode.Default : HitTestMode.None)
          .zIndex(19)
        }

        // 底栏：使用barRenderKey触发重新渲染（屏幕方向或折叠状态变化时）
        // 支持跟手滑动隐藏/显示
        if (!this.useTopTabsNavigation) {
          Column() {
            this.buildHorizontalTabBar()
          }
          .id('guide_main_bottom_bar_horizontal')
          .width(this.getBottomBarWidth())
          .height(this.BOTTOM_BAR_HEIGHT)
          .borderRadius(this.getGlassRadius())
          .clip(true)
          .backgroundColor(this.getBottomBarContainerBackground())
          .backgroundBlurStyle(this.getBottomBarContainerBlurStyle(), this.getBottomBarContainerBlurOptions())
          .backgroundEffect(this.getBottomBarContainerBackgroundEffect())
          .border({
            width: 1,
            color: this.getBottomBarContainerBorderColor()
          })
          .shadow({
            radius: 22,
            color: this.getBottomBarContainerShadowColor(),
            offsetX: 0,
            offsetY: 8
          })
          .gesture(
            PanGesture({ fingers: 1, direction: PanDirection.Horizontal, distance: 1 })
              .onActionStart((event: GestureEvent) => {
                this.beginBottomBarFakeDrag(event);
              })
              .onActionUpdate((event: GestureEvent) => {
                this.updateBottomBarFakeDrag(event);
              })
              .onActionEnd(() => {
                this.endBottomBarFakeDrag();
              })
          )
          .position({ x: this.getBottomBarX(), y: this.getBottomBarY() })
          .translate({ y: this.getEffectiveBottomBarOffset() })
          .opacity(1 - this.getEffectiveBottomBarOffset() / this.getBottomBarTravelDistance() * 0.3)
          .key(`bottomBar_${this.barRenderKey}`)
        }

        if (this.useTopTabsNavigation && this.getEffectiveTabletTopBarPosition() === 'top') {
          Column() {
            this.buildAdaptiveTopOperationBar()
          }
          .id('guide_main_bottom_bar_top')
          .position({ x: this.getBottomBarX(), y: this.getAdaptiveTopOperationBarY() })
          .zIndex(15)
          .key(`adaptiveTopOperationBar_${this.barRenderKey}`)
        }

        if (this.useTopTabsNavigation && this.getEffectiveTabletTopBarPosition() === 'bottom') {
          Column() {
            this.buildAdaptiveTopOperationBar()
          }
          .id('guide_main_bottom_bar_top')
          .position({ x: this.getBottomBarX(), y: this.getBottomBarY() })
          .zIndex(15)
          .key(`adaptiveBottomOperationBar_${this.barRenderKey}`)
        }

        if (this.useTopTabsNavigation && this.getEffectiveTabletTopBarPosition() === 'left') {
          Column() {
            this.buildAdaptiveSideOperationBar()
          }
          .id('guide_main_bottom_bar_side')
          .position({ x: this.getAdaptiveLeftOperationBarX(), y: this.getAdaptiveSideOperationBarY() })
          .zIndex(15)
          .key(`adaptiveLeftOperationBar_${this.barRenderKey}`)
        }

        if (this.useTopTabsNavigation && this.getEffectiveTabletTopBarPosition() === 'right') {
          Column() {
            this.buildAdaptiveSideOperationBar()
          }
          .id('guide_main_bottom_bar_side')
          .position({ x: this.getAdaptiveRightOperationBarX(), y: this.getAdaptiveSideOperationBarY() })
          .zIndex(15)
          .key(`adaptiveRightOperationBar_${this.barRenderKey}`)
        }


        // 筛选对话框
        if (this.showLibraryFilterDialog) {
          this.buildLibraryFilterDialog()
        }

        // 创建分类对话框
        if (this.showCreateCategoryDialog) {
          this.buildCreateCategoryDialog()
        }

        // 编辑分类对话框
        if (this.showEditCategoryDialog) {
          this.buildEditCategoryDialog()
        }

        // 新增书架对话框
        if (this.showAddShelfDialog) {
          this.buildAddShelfDialog()
        }

        // 删除书架确认对话框
        if (this.showDeleteShelfDialog) {
          this.buildDeleteShelfDialog()
        }

        // 重命名书架对话框
        if (this.showRenameShelfDialog) {
          this.buildRenameShelfDialog()
        }

        // 移动到分类对话框
        if (this.showMoveToCategoryDialog) {
          Column() {
            this.buildMoveToCategoryDialog()
          }
          .width('100%')
          .height('100%')
          .zIndex(2000)
          .transition(TransitionEffect.OPACITY.animation({ duration: 200, curve: Curve.EaseOut }))
        }

        // 移动到书架对话框
        if (this.showMoveToShelfDialog) {
          Column() {
            this.buildMoveToShelfDialog()
          }
          .width('100%')
          .height('100%')
          .zIndex(2001)
          .transition(TransitionEffect.OPACITY.animation({ duration: 200, curve: Curve.EaseOut }))
        }

        // 标签自定义对话框（从底部滑入）
        Column() {
          this.buildTabCustomizationDialog()
        }
        .width('100%')
        .position({ x: 0, y: '100%' })
        .translate({ y: this.showTabCustomDialog ? '-100%' : '0%' })
        .animation({ 
          duration: 300, 
          curve: Curve.EaseInOut 
        })
        .zIndex(1000)
        .visibility(this.showTabCustomDialog ? Visibility.Visible : Visibility.None)



        // 日志悬浮窗口
        if (this.enableLogFloatingWindow) {
          LogFloatingWindow()
        }

        // 后台任务悬浮球
        TaskFloatingBall()

        // 全局WebView容器（隐藏，用于后台WebView操作）
        WebViewContainer()
          .width(0)
          .height(0)
          .visibility(Visibility.None)

        if (this.mainMenuReentryShieldVisible) {
          Stack() {
            Column()
              .width('100%')
              .height('100%')
              .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_primary', this.themeState.currentTheme))
              .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
          }
          .width('100%')
          .height('100%')
          .opacity(this.mainMenuReentryShieldOpacity)
          .animation({ duration: this.WINDOW_MODE_TRANSITION_FADE_OUT_DURATION, curve: Curve.EaseOut })
          .zIndex(9500)
          .hitTestBehavior(HitTestMode.None)
        }
      }
    }
    .navDestination(this.buildNavDestination)
    .mode(NavigationMode.Stack)
    .width('100%')
    .height('100%')
    .hideTitleBar(true)
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
    .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.BOTTOM])
    .onAppear(() => {
      // 注册全局WebView容器
      // 注意：由于组件引用限制，这里暂时无法直接获取WebViewContainer实例
      // 需要通过GlobalWebViewContainer的静态方法来管理
      logger.info(TAG, '全局WebView容器已创建');
    })
      
    // 书籍翻开/关闭过渡动画覆盖层（放在Navigation外部的最顶层）
    WindowModeTransitionOverlay()

    BookTransitionOverlay()
    
    // 全局帮助面板覆盖层
    HelpPanelOverlayV2({
      themeState: this.themeState,
      onNavigateToHelpCenter: () => {
        try {
          this.pathStack.pushPathByName('HelpCenterPage', undefined);
          logger.info(TAG, '从内容面板导航到帮助中心');
        } catch (error) {
          logger.error(TAG, '从内容面板导航到帮助中心失败', String(error));
        }
      }
    })

    // 后台模糊遮罩层（当应用进入后台且启用了模糊遮罩时显示）
    BackgroundBlurOverlay({
      isVisible: this.isInBackground && this.backgroundBlurEnabled,
      bgType: this.backgroundBlurBgType,
      customBgImage: this.backgroundBlurBgImage,
      iconType: this.backgroundBlurIconType,
      currentTheme: this.themeState.currentTheme
    })

    // 听书悬浮球（放在最顶层，避免被导航目的页或后台模糊遮罩覆盖）
    ReadAloudFloatingBall()

    if (this.appGuideStep) {
      AppGuideOverlay({
        visible: this.appGuideStep !== null,
        title: this.appGuideStep.title,
        message: this.appGuideStep.message,
        progressText: this.appGuideManager.getCurrentProgressText(),
        nextButtonText: this.appGuideStep.nextButtonText ?? '下一步',
        cardPosition: this.appGuideStep.cardPosition,
        highlightRect: this.appGuideHighlightRect,
        highlightVerticalOffsetRatio: 0,
        showSkip: this.appGuideStep.showSkip !== false,
        themeState: this.themeState,
        onNext: () => {
          this.handleMainGuideNext();
        },
        onSkip: () => {
          this.handleMainGuideSkip();
        }
      })
    }

    if (this.windowModeTransitionOverlayVisible) {
      Column()
        .width('100%')
        .height('100%')
        .backgroundColor(this.themeState.currentTheme === ThemeType.DARK ? '#66000000' : '#4A000000')
        .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
        .opacity(this.windowModeTransitionOverlayOpacity)
        .zIndex(99998)
    }

    // 冷启动快捷路由遮罩：在目标页解析完成前屏蔽 MainMenu，避免闪现
    if (this.startupRoutePending) {
      Column({ space: 16 }) {
        Image($r('app.media.icon'))
          .width(88)
          .height(88)
          .objectFit(ImageFit.Contain)

        LoadingProgress()
          .width(30)
          .height(30)
          .color(ThemeAwareHelper.getTestManagementThemedColor('accent_primary', this.themeState.currentTheme))

        Text('正在打开快捷入口...')
          .fontSize(15)
          .fontFamily(this.appFontFamily)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
          .opacity(0.88)
      }
      .justifyContent(FlexAlign.Center)
      .alignItems(HorizontalAlign.Center)
      .width('100%')
      .height('100%')
      .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('background_primary', this.themeState.currentTheme))
      .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
      .zIndex(99999)
    }
    }
    .id(MAIN_MENU_GUIDE_ROOT_ID)
    .width('100%')
    .height('100%')
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP, SafeAreaEdge.BOTTOM])
    .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.BOTTOM])
  }

  // 页面过渡动画：从 SplashPage 进入时淡入
  pageTransition() {
    // MainMenuPage 从透明淡入，视觉上等同于 SplashPage 淡出
    PageTransitionEnter({ duration: 350, curve: Curve.EaseOut })
      .opacity(0) // 从透明开始淡入
  }
}

export { MainMenuPage };


