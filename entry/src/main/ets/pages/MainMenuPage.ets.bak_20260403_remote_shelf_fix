  /**
   * 规范化封面显示路径：本地文件统一补充 file:// 前缀，便于 Image 组件正确解析
   */
  private normalizeDisplayPathForManga(mg: Manga): string {
    if (!mg || !mg.coverImagePath) {
      return '';
    }
    const raw: string = mg.coverImagePath;

    // [修复] 检查是否为资源引用字符串（如 'app.media.mangabook'），这种情况返回空字符串让调用方使用 $r() 资源引用
    if (raw.indexOf('app.media.') === 0 || raw.indexOf('$r(') === 0) {
      logger.debug('MainMenuPage', `检测到资源引用字符串，返回空字符串使用默认资源: raw='${raw}'`);
      return '';
    }

    const type: ImageSourceType = mg.coverSourceType !== undefined ? mg.coverSourceType as ImageSourceType : ImageSourceType.LOCAL;
    if (type === ImageSourceType.LOCAL) {
      const hasScheme: boolean = raw.indexOf('file://') === 0;
      const normalized: string = hasScheme ? raw : 'file://' + raw;
      logger.debug('MainMenuPage', `封面路径规范化: raw='${raw}', display='${normalized}', source=${type}`);
      return normalized;
    }
    return raw;
  }

  private buildLibraryResolvedCoverAsset(
    rawPath: string | undefined,
    fallbackSource: ResourceStr,
    cachedNetworkPixelMap?: image.PixelMap | null
  ): LibraryResolvedCoverAsset {
    this.localLibraryCoverRenderVersion;

    const raw = typeof rawPath === 'string' ? rawPath.trim() : '';
    if (raw.length === 0) {
      return {
        source: fallbackSource,
        rawPath: '',
        displayPath: '',
        isNetwork: false,
        useAvifRenderer: false,
        hasRealCover: false,
        fallbackSource: fallbackSource
      };
    }

    if (raw.startsWith('app.media.')) {
      return {
        source: this.resolveAppMediaCoverResource(raw, fallbackSource),
        rawPath: raw,
        displayPath: '',
        isNetwork: false,
        useAvifRenderer: false,
        hasRealCover: true,
        fallbackSource: fallbackSource
      };
    }

    if (raw.startsWith('$r(')) {
      return {
        source: fallbackSource,
        rawPath: raw,
        displayPath: '',
        isNetwork: false,
        useAvifRenderer: false,
        hasRealCover: false,
        fallbackSource: fallbackSource
      };
    }

    if (this.isNetworkUrl(raw)) {
      if (cachedNetworkPixelMap) {
        return {
          source: cachedNetworkPixelMap,
          rawPath: raw,
          displayPath: raw,
          isNetwork: true,
          useAvifRenderer: false,
          hasRealCover: true,
          fallbackSource: fallbackSource
        };
      }
      return {
        source: raw,
        rawPath: raw,
        displayPath: raw,
        isNetwork: true,
        useAvifRenderer: true,
        hasRealCover: true,
        fallbackSource: fallbackSource
      };
    }

    const normalizedLocalPath = this.getNormalizedLocalLibraryCoverPath(raw);
    if (normalizedLocalPath.length > 0) {
      const displayPath = `file://${normalizedLocalPath}`;
      const cachedPixelMap = this.getCachedLocalLibraryCoverPixelMap(normalizedLocalPath);
      if (cachedPixelMap) {
        return {
          source: cachedPixelMap,
          rawPath: normalizedLocalPath,
          displayPath: displayPath,
          isNetwork: false,
          useAvifRenderer: false,
          hasRealCover: true,
          fallbackSource: fallbackSource
        };
      }
      this.ensureLocalLibraryCoverPrepared(normalizedLocalPath);
      return {
        source: displayPath,
        rawPath: normalizedLocalPath,
        displayPath: displayPath,
        isNetwork: false,
        useAvifRenderer: false,
        hasRealCover: true,
        fallbackSource: fallbackSource
      };
    }

    if (raw.startsWith('file://')) {
      return {
        source: raw,
        rawPath: raw.substring('file://'.length),
        displayPath: raw,
        isNetwork: false,
        useAvifRenderer: false,
        hasRealCover: true,
        fallbackSource: fallbackSource
      };
    }

    const displayPath = raw.startsWith('/') ? `file://${raw}` : raw;
    return {
      source: displayPath,
      rawPath: raw,
      displayPath: displayPath,
      isNetwork: false,
      useAvifRenderer: false,
      hasRealCover: true,
      fallbackSource: fallbackSource
    };
  }

