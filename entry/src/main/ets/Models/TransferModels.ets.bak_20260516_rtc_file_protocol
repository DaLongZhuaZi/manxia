export function buildTransferNativeRtcSdpSignalPayload(sdpType: string, sdp: string): string {
  const payload: TransferNativeRtcSdpSignalPayload = {
    sdpType: sdpType,
    sdp: sdp
  };
  return JSON.stringify(payload);
}

export function buildTransferNativeRtcCandidateSignalPayload(
  candidate: string,
  sdpMid: string,
  sdpMLineIndex: number
): string {
  const payload: TransferNativeRtcCandidateSignalPayload = {
    candidate: candidate,
    sdpMid: sdpMid,
    sdpMLineIndex: sdpMLineIndex
  };
  return JSON.stringify(payload);
}

export function parseTransferNativeRtcSdpSignalPayload(text: string): TransferNativeRtcSdpSignalPayload | null {
  try {
    const parsed = JSON.parse(text) as TransferNativeRtcSdpSignalPayload;
    const sdpType = typeof parsed.sdpType === 'string' ? parsed.sdpType : '';
    const sdp = typeof parsed.sdp === 'string' ? parsed.sdp : '';
    if (sdp.length <= 0) {
      return null;
    }
    const payload: TransferNativeRtcSdpSignalPayload = {
      sdpType: sdpType,
      sdp: sdp
    };
    return payload;
  } catch (_error) {
    return null;
  }
}

export function parseTransferNativeRtcCandidateSignalPayload(
  text: string
): TransferNativeRtcCandidateSignalPayload | null {
  try {
    const parsed = JSON.parse(text) as TransferNativeRtcCandidateSignalPayload;
    const candidate = typeof parsed.candidate === 'string' ? parsed.candidate : '';
    const sdpMid = typeof parsed.sdpMid === 'string' ? parsed.sdpMid : '';
    const sdpMLineIndex = typeof parsed.sdpMLineIndex === 'number' && Number.isFinite(parsed.sdpMLineIndex) ?
      parsed.sdpMLineIndex : 0;
    if (candidate.length <= 0 || sdpMid.length <= 0) {
      return null;
    }
    const payload: TransferNativeRtcCandidateSignalPayload = {
      candidate: candidate,
      sdpMid: sdpMid,
      sdpMLineIndex: sdpMLineIndex
    };
    return payload;
  } catch (_error) {
    return null;
  }
}

export function buildTransferLanAccessSignalPayload(
  url: string,
  pairCode: string,
  serviceStatus: TransferServerStatus,
  roomCode: string
): string {
  const payload: TransferLanAccessSignalPayload = {
    url: url,
    pairCode: pairCode,
    serviceStatus: serviceStatus,
    roomCode: roomCode,
    sentAt: Date.now()
  };
  return JSON.stringify(payload);
}

export function buildTransferLanAccessDataChannelMessage(payloadText: string): string {
  const payload = parseTransferLanAccessSignalPayload(payloadText);
  if (payload === null) {
    return payloadText;
  }
  const message: TransferLanAccessDataChannelMessage = {
    type: 'lan_url',
    payload: payload
  };
  return JSON.stringify(message);
}

export function parseTransferLanAccessSignalPayload(text: string): TransferLanAccessSignalPayload | null {
  try {
    const parsed = JSON.parse(text) as TransferLanAccessSignalPayload;
    const url = typeof parsed.url === 'string' ? parsed.url.trim() : '';
    const pairCode = typeof parsed.pairCode === 'string' ? parsed.pairCode.trim() : '';
    const serviceStatus = normalizeTransferServerStatus(
      typeof parsed.serviceStatus === 'string' ? parsed.serviceStatus : ''
    );
    const roomCode = typeof parsed.roomCode === 'string' ? parsed.roomCode.trim().toUpperCase() : '';
    const sentAt = typeof parsed.sentAt === 'number' && Number.isFinite(parsed.sentAt) ? parsed.sentAt : 0;
    if (url.length <= 0 || pairCode.length <= 0) {
      return null;
    }
    const payload: TransferLanAccessSignalPayload = {
      url: url,
      pairCode: pairCode,
      serviceStatus: serviceStatus,
      roomCode: roomCode,
      sentAt: sentAt
    };
    return payload;
  } catch (_error) {
    return null;
  }
}

export function normalizeTransferNativeRtcBackend(backend: string): TransferNativeRtcBackend {
  if (backend === 'stub') {
    return 'stub';
  }
  if (backend === 'libdatachannel') {
    return 'libdatachannel';
  }
  return 'none';
}

export function normalizeTransferServerStatus(status: string): TransferServerStatus {
  if (status === 'starting') {
    return 'starting';
  }
  if (status === 'running') {
    return 'running';
  }
  if (status === 'stopping') {
    return 'stopping';
  }
  if (status === 'error') {
    return 'error';
  }
  return 'stopped';
}

export function buildTransferSignalPublicPageUrl(origin: string, roomCode: string): string {
  const normalizedOrigin = normalizeTransferSignalOrigin(origin);
  if (roomCode.trim().length <= 0) {
    return `${normalizedOrigin}/transfer`;
  }
  return `${normalizedOrigin}/transfer?room=${encodeURIComponent(roomCode.trim().toUpperCase())}`;
}

export function normalizeTransferSignalOrigin(origin: string): string {
  let normalizedOrigin = origin.trim();
  while (normalizedOrigin.endsWith('/')) {
    normalizedOrigin = normalizedOrigin.substring(0, normalizedOrigin.length - 1);
  }
  if (normalizedOrigin.length <= 0) {
    return 'https://manxia.top';
  }
  return normalizedOrigin;
}

export function sanitizeTransferConfig(source: TransferConfig): TransferConfig {
  const sanitized: TransferConfig = {
    port: sanitizeTransferPort(source.port),
    autoStopMinutes: sanitizeTransferAutoStopMinutes(source.autoStopMinutes),
    maxFileSizeMb: sanitizeTransferMaxFileSizeMb(source.maxFileSizeMb),
    allowBackgroundTransfer: source.allowBackgroundTransfer,
    wsEnabled: source.wsEnabled
  };
  return sanitized;
}

export function buildTransferInfoResponse(
  runtime: TransferServerRuntime,
  config: TransferConfig
): TransferInfoResponse {
  const addressList: TransferLocalAddress[] = [];
  for (const address of runtime.localAddresses) {
    addressList.push(cloneTransferLocalAddress(address));
  }
  const response: TransferInfoResponse = {
    ok: runtime.status === 'running',
    phase: runtime.phase,
    serviceStatus: runtime.status,
    appName: '漫匣',
    protocolVersion: TRANSFER_PROTOCOL_VERSION,
    message: runtime.infoMessage,
    pairCode: runtime.session !== null ? runtime.session.pairCode : '',
    sessionStatus: runtime.session !== null ? runtime.session.status : 'idle',
    sessionExpiresAt: runtime.session !== null ? runtime.session.expiresAt : 0,
    sessionClientName: runtime.session !== null ? runtime.session.clientName : '',
    sessionClientIp: runtime.session !== null ? runtime.session.clientIp : '',
    port: runtime.activePort,
    webSocketPort: runtime.webSocketPort,
    backgroundRunning: runtime.backgroundRunning,
    uploadEnabled: true,
    maxFileSizeMb: config.maxFileSizeMb,
    addressList: addressList,
    supportedFileTypes: cloneTransferSupportedFileTypes()
  };
  return response;
}

export function cloneTransferSupportedFileTypes(): string[] {
  const result: string[] = [];
  for (const fileType of TRANSFER_SUPPORTED_FILE_TYPES) {
    result.push(fileType);
  }
  return result;
}

export function isSupportedTransferFileName(fileName: string): boolean {
  const extension = getTransferFileExtension(fileName);
  if (extension.length <= 0) {
    return false;
  }
  for (const fileType of TRANSFER_SUPPORTED_FILE_TYPES) {
    if (fileType === extension) {
      return true;
    }
  }
  return false;
}

export function getTransferFileExtension(fileName: string): string {
  const normalizedName = fileName.trim().toLowerCase();
  const lastDot = normalizedName.lastIndexOf('.');
  if (lastDot < 0 || lastDot >= normalizedName.length - 1) {
    return '';
  }
  return normalizedName.substring(lastDot + 1);
}

export function isTransferAcceptedImportCategory(category: NetworkFolderImportCategory): boolean {
  return category === 'comic' ||
    category === 'ebook' ||
    category === 'pdf' ||
    category === 'backup' ||
    category === 'json' ||
    category === 'font' ||
    category === 'code' ||
    category === 'avif';
}

export function sanitizeTransferPort(port: number): number {
  if (!Number.isFinite(port)) {
    return 15124;
  }
  const normalized = Math.floor(port);
  if (normalized < 1024) {
    return 1024;
  }
  if (normalized > 65535) {
    return 65535;
  }
  return normalized;
}

export function sanitizeTransferAutoStopMinutes(minutes: number): number {
  if (!Number.isFinite(minutes)) {
    return 15;
  }
  const normalized = Math.floor(minutes);
  if (normalized < 1) {
    return 1;
  }
  if (normalized > 180) {
    return 180;
  }
  return normalized;
}

export function sanitizeTransferMaxFileSizeMb(sizeMb: number): number {
  if (!Number.isFinite(sizeMb)) {
    return 2048;
  }
  const normalized = Math.floor(sizeMb);
  if (normalized < 50) {
    return 50;
  }
  if (normalized > 10240) {
    return 10240;
  }
  return normalized;
}
