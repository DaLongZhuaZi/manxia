/**
 * 创建使用手册章节列表
 */
function createUserManualChapters(): EBookChapter[] {
  const chapterTitles: string[] = [
    '欢迎使用漫匣',
    '首页、书库与搜索',
    '导入与整理本地内容',
    '分类、书架与整理',
    '统一详情页与封面管理',
    '阅读器、目录与朗读',
    '缓存、备份与设置',
    '常见问题'
  ];

  const chapters: EBookChapter[] = [];
  let position = 0;

  for (let i = 0; i < chapterTitles.length; i++) {
    const content = CHAPTER_CONTENTS[i];
    const chapter: EBookChapter = {
      id: `${USER_MANUAL_ID}_chapter_${i + 1}`,
      bookId: USER_MANUAL_ID,
      chapterNumber: i + 1,
      title: chapterTitles[i],
      content: content,
      startPosition: position,
      endPosition: position + content.length,
      wordCount: content.length,
      createTime: Date.now()
    };
    chapters.push(chapter);
    position += content.length;
  }

  return chapters;
}

/**
 * 创建使用手册元数据
 */
function createUserManualMetadata(): EBookMetadata {
  return {
    title: '漫匣使用手册',
    author: '漫匣项目组',
    publisher: '漫匣项目组',
    publishDate: '2026-03-25',
    isbn: '',
    language: 'zh-CN',
    description: '面向当前版本漫匣的内置使用说明，覆盖本地导入、书库整理、统一详情页、阅读器、缓存同步与常见问题。',
    coverImagePath: 'app.media.mangabook',
    tags: ['使用手册', '帮助', '教程', '内置指南'],
    rating: 5
  };
}

/**
 * 创建使用手册电子书对象
 */
export function createUserManualEBook(): EBook {
  const chapters = createUserManualChapters();
  const metadata = createUserManualMetadata();

  let totalWordCount = 0;
  for (const chapter of chapters) {
    totalWordCount += chapter.wordCount;
  }

  const now = Date.now();

  return new EBook(
    USER_MANUAL_ID,
    EBookFormat.TXT,
    '',
    0,
    metadata,
    chapters,
    EBookStatus.UNREAD,
    {
      bookId: USER_MANUAL_ID,
      currentChapterId: chapters[0].id,
      currentChapterIndex: 0,
      currentPosition: 0,
      domPos: '',
      progress: 0,
      lastReadTime: 0,
      totalReadingTime: 0
    },
    DEFAULT_EBOOK_READING_SETTINGS,
    now,
    now,
    true,
    totalWordCount
  );
}

/**
 * 获取使用手册ID
 */
export function getUserManualId(): string {
  return USER_MANUAL_ID;
}
