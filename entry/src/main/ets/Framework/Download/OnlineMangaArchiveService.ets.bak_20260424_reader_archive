import { common } from '@kit.AbilityKit';
import { util } from '@kit.ArkTS';
import fs from '@ohos.file.fs';
import { logger } from '../../Utils/Logger';
import { MetadataXmlGenerator, MangaMetadata } from '../../Utils/MetadataXmlGenerator';
import { DataManager, OnlineChapterInfo, OnlineComicInfo, OnlinePageInfo } from '../Data/DataManager';
import { DatabaseManager } from '../Database/DatabaseManager';
import { GenericQueryRecord } from '../Database/DatabaseTypes';
import { DownloadDirManager } from '../Storage/DownloadDirManager';
import { PermanentImageCacheManager } from '../Cache/PermanentImageCacheManager';
import { generateDbId } from '../Utils/UUIDGenerator';

const TAG = 'OnlineMangaArchiveService';

export enum OnlineArchiveMigrationStatus {
  MIGRATED = 'migrated',
  SKIPPED = 'skipped',
  FAILED = 'failed'
}

export interface OnlineArchivePageFile {
  pageIndex: number;
  imageUrl: string;
  sourcePath: string;
  width: number;
  height: number;
  fileSize: number;
}

export interface OnlineArchiveMetadata {
  sourceId: string;
  sourceName: string;
  sourcePkg: string;
  mangaId: string;
  mangaTitle: string;
  chapterId: string;
  chapterTitle: string;
  chapterUrl: string;
  author: string;
  description: string;
  coverUrl: string;
  tags: string[];
  lastUpdateTime: number;
  isPrivate: boolean;
  isNSFW: boolean;
}

export interface OnlineArchiveCreateRequest {
  sourceName: string;
  sourcePkg: string;
  mangaTitle: string;
  chapterTitle: string;
  mangaId: string;
  chapterId: string;
  pageFiles: OnlineArchivePageFile[];
  metadata: OnlineArchiveMetadata;
  preferPublicDownloadDir: boolean;
}

export interface OnlineArchiveCreateResult {
  archivePath: string;
  archiveSize: number;
  pageCount: number;
}

export interface OnlineArchiveExtractRequest {
  archivePath: string;
  chapterId: string;
  pages: OnlinePageInfo[];
}

export interface OnlineArchiveExtractedPage {
  pageId: string;
  pageIndex: number;
  imageUrl: string;
  localPath: string;
  width: number;
  height: number;
  fileSize: number;
}

export interface OnlineArchiveExtractResult {
  extractDir: string;
  pages: OnlineArchiveExtractedPage[];
}

export interface OnlineArchiveMigrationItem {
  chapterId: string;
  mangaTitle: string;
  chapterTitle: string;
  sourceName: string;
  status: OnlineArchiveMigrationStatus;
  message: string;
  archivePath: string;
  pageCount: number;
  archiveSize: number;
  migratedTime: number;
}

export interface OnlineArchiveMigrationSummary {
  totalCandidates: number;
  migratedCount: number;
  skippedCount: number;
  failedCount: number;
  totalArchiveSize: number;
  startedAt: number;
  completedAt: number;
  items: OnlineArchiveMigrationItem[];
}

interface LegacyPageFileBuildResult {
  pageFiles: OnlineArchivePageFile[];
  expectedPageCount: number;
  localPathRecordCount: number;
  missingLocalFileCount: number;
  recoveredCachePathCount: number;
  downloadPathImageCount: number;
}

interface OnlineArchiveSourceRecord {
  id: string;
  name: string;
  pkg: string;
  isNSFW: number;
}

interface FilesystemImageDirectory {
  directoryPath: string;
  imageFiles: string[];
}

interface FilesystemOrphanCandidate {
  scanKey: string;
  rootType: string;
  directoryPath: string;
  sourceId: string;
  sourceName: string;
  sourcePkg: string;
  mangaExternalId: string;
  chapterExternalId: string;
  preferredMangaId: string;
  preferredChapterId: string;
  mangaTitle: string;
  chapterTitle: string;
  chapterUrl: string;
  chapterNumber: number;
  pageFiles: OnlineArchivePageFile[];
  preferPublicDownloadDir: boolean;
  isPrivate: boolean;
  isNSFW: boolean;
}

interface ExistingOrphanChapterRecord {
  comicId: string;
  chapterId: string;
  pageCount: number;
  pageRecordCount: number;
