    extraLines.push(`  <PageCount>${pageCount}</PageCount>`);
    extraLines.push(`  <MangaId>${this.escapeXml(metadata.mangaId)}</MangaId>`);
    extraLines.push(`  <ChapterId>${this.escapeXml(metadata.chapterId)}</ChapterId>`);
