          phaseText.textContent = String(payload.phase || '');
        }
        if (serviceMessageText) {
          serviceMessageText.textContent = String(payload.message || '');
        }
        if (pairInput && typeof payload.pairCode === 'string' && payload.pairCode.length > 0) {
          if (sessionToken && currentPairCode.length > 0 && currentPairCode !== payload.pairCode) {
            sessionToken = '';
            setUploadReady(false);
            setPairState('warn', '等待重新验证');
            setStatus('APP 侧配对码已刷新，请重新验证配对。', true);
          }
          currentPairCode = payload.pairCode;
          pairInput.value = payload.pairCode;
        }
        if (pairCodeText && typeof payload.pairCode === 'string' && payload.pairCode.length > 0) {
          pairCodeText.textContent = payload.pairCode;
        }
        if (addressText && Array.isArray(payload.addressList) && payload.addressList.length > 0) {
          const firstAddress = payload.addressList[0];
          if (firstAddress && typeof firstAddress.url === 'string') {
            addressText.innerHTML = '<code>' + escapeHtml(firstAddress.url) + '</code>';
          }
        }
        if (pairedClientText) {
          const clientName = String(payload.sessionClientName || '').trim();
          const clientIp = String(payload.sessionClientIp || '').trim();
          if (clientName.length > 0) {
            pairedClientText.textContent = clientIp.length > 0 ? (clientName + ' (' + clientIp + ')') : clientName;
          } else {
            pairedClientText.textContent = '尚未配对';
          }
        }
      }

      function handleWsPayload(payload) {
        if (!payload || typeof payload !== 'object') {
          return;
        }
        if (Array.isArray(payload.records)) {
          renderUploads(payload.records);
          return;
        }
        if (typeof payload.serviceStatus === 'string') {
          updateRuntimeInfo(payload);
        }
      }

      async function verifyPair() {
        const pairCode = String(pairInput.value || '').trim();
        if (!pairCode) {
          setUploadReady(false);
          setPairState('warn', '缺少配对码');
          setStatus('请先输入配对码', true);
          return false;
        }
        pairButton.disabled = true;
        setUploadReady(false);
        setPairState('', '验证中');
        setStatus('正在验证配对...', false);
        try {
          const result = await requestJson('/api/pair/verify', {
            method: 'POST',
            headers: {
              'X-Pair-Code': pairCode,
              'X-Client-Name': getHeaderSafeClientName()
            }
          }, 10000);
          const response = result.response;
          const payload = result.payload || {};
          if (!response.ok || !payload.ok) {
            sessionToken = '';
            setUploadReady(false);
            setPairState('warn', '配对失败');
            setStatus(String(payload.message || '配对失败'), true);
            return false;
          }
          sessionToken = String(payload.token || '');
          currentPairCode = String(payload.pairCode || pairCode);
          setUploadReady(true);
          setPairState('ok', '已配对');
          updateRuntimeInfo({
            pairCode: payload.pairCode || pairCode,
            sessionClientName: getClientName()
          });
          setStatus('配对成功，可以开始上传', false);
          return true;
        } catch (error) {
          sessionToken = '';
          setUploadReady(false);
          setPairState('warn', '请求超时');
          const message = String(error && error.name === 'AbortError'
            ? '配对请求超时，请检查 APP 是否仍保持在传书页并重试。'
            : (error && error.message ? error.message : error));
          setStatus(message, true);
          return false;
        } finally {
          pairButton.disabled = false;
        }
      }

      async function refreshUploads() {
        try {
          const result = await requestJson('/api/uploads', { cache: 'no-store' }, 6000);
          const response = result.response;
          const payload = result.payload;
          if (!response.ok || !payload.ok || !Array.isArray(payload.records)) {
            return;
          }
          renderUploads(payload.records);
        } catch (_error) {
        }
      }

      async function refreshInfo() {
        try {
          const result = await requestJson('/api/info', { cache: 'no-store' }, 6000);
          const response = result.response;
          const payload = result.payload;
          if (!response.ok || !payload.ok) {
            return;
          }
          updateRuntimeInfo(payload);
        } catch (_error) {
        }
      }

      function scheduleWsReconnect() {
        if (wsReconnectTimer > 0) {
          return;
        }
        wsReconnectTimer = window.setTimeout(() => {
          wsReconnectTimer = 0;
          setupWebSocket();
        }, 4000);
      }

      function setupWebSocket() {
        if (!(wsPort > 0) || typeof window.WebSocket !== 'function') {
          return;
        }
        if (wsClient && (wsClient.readyState === window.WebSocket.OPEN || wsClient.readyState === window.WebSocket.CONNECTING)) {
          return;
        }
        const scheme = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const targetUrl = scheme + '://' + window.location.hostname + ':' + wsPort;
        try {
          wsClient = new window.WebSocket(targetUrl);
        } catch (_error) {
          scheduleWsReconnect();
          return;
        }

        wsClient.onopen = () => {
          if (wsChannelText) {
            wsChannelText.textContent = '已连接';
          }
          try {
            wsClient.send('info');
            wsClient.send('uploads');
          } catch (_error) {
          }
        };

        wsClient.onmessage = (event) => {
          try {
            const payload = JSON.parse(String(event.data || '{}'));
            handleWsPayload(payload);
          } catch (_error) {
          }
        };

        wsClient.onerror = () => {
          if (wsChannelText) {
            wsChannelText.textContent = '连接异常，将自动重试';
          }
        };

        wsClient.onclose = () => {
          if (wsChannelText) {
            wsChannelText.textContent = '已断开，正在重连';
          }
          scheduleWsReconnect();
        };
      }

      pairButton.addEventListener('click', () => {
        verifyPair().catch((error) => {
          setStatus(String(error && error.message ? error.message : error), true);
        });
      });

      uploadButton.addEventListener('click', async () => {
        const file = fileInput.files && fileInput.files[0];
        if (!file) {
          setStatus('请先选择文件', true);
          return;
        }
        if (!sessionToken) {
          const paired = await verifyPair();
          if (!paired) {
            return;
          }
        }
        setStatus('正在上传，请不要关闭当前页面...', false);
        setPairState('ok', '已配对');
        setProgress(0, '0%');
        uploadButton.disabled = true;
        try {
          const payload = await new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/api/upload', true);
            xhr.responseType = 'json';
            xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');
            xhr.setRequestHeader('X-File-Name', encodeURIComponent(file.name));
            xhr.setRequestHeader('X-Client-Name', getHeaderSafeClientName());
            xhr.setRequestHeader('X-Transfer-Token', sessionToken);

            xhr.upload.onprogress = (event) => {
              if (event.lengthComputable) {
                const percent = event.total > 0 ? (event.loaded / event.total) * 100 : 0;
                setProgress(percent, percent.toFixed(1) + '%');
              }
            };

            xhr.onload = () => {
              const responsePayload = xhr.response || {};
              if (xhr.status < 200 || xhr.status >= 300 || !responsePayload.ok) {
                if (xhr.status === 403) {
                  sessionToken = '';
                  setUploadReady(false);
                  setPairState('warn', '会话失效');
                }
                reject(new Error(String(responsePayload.message || '上传失败')));
                return;
              }
              resolve(responsePayload);
            };
            xhr.onerror = () => {
              reject(new Error('网络异常，上传失败'));
            };
            xhr.timeout = 30000;
            xhr.ontimeout = () => {
              reject(new Error('上传请求超时，请检查 APP 是否仍在前台运行'));
            };
            xhr.send(file);
          });

          setProgress(100, '100%');
          setStatus('上传成功：' + String(payload.fileName || file.name) + '\\n请回到 APP 的局域网传书页，点击“继续导入”。本页会继续自动刷新状态。', false);
          fileInput.value = '';
          await refreshUploads();
        } catch (error) {
          setStatus(String(error && error.message ? error.message : error), true);
        } finally {
          setUploadReady(sessionToken.length > 0);
        }
      });

      pairInput.addEventListener('input', () => {
        sessionToken = '';
        setUploadReady(false);
        currentPairCode = String(pairInput.value || '').trim();
        setPairState('', '未验证');
      });

      refreshInfo();
      refreshUploads();
      setupWebSocket();
      setUploadReady(false);
      setPairState('', '未验证');
      window.setInterval(() => {
        refreshInfo().catch(() => {
        });
        refreshUploads().catch(() => {
        });
      }, 5000);
    })();
  </script>
</body>
</html>`.trim();
  }

  private buildRecentUploadsHtml(): string {
    const records = this.uploadStoreService.getCachedRecords(6);
    if (records.length <= 0) {
      return '<div class="upload-item">暂无上传记录</div>';
    }

    const htmlParts: string[] = [];
    for (const record of records) {
      const sizeText = this.escapeHtml(record.fileSizeBytes.toString());
      const timeText = this.escapeHtml(this.formatTimestamp(record.receivedAt));
      const safeName = this.escapeHtml(record.fileName);
      const safeCategory = this.escapeHtml(record.importCategory);
      const safeStatus = this.escapeHtml(this.describeUploadStatus(record.status));
      const safeClient = this.escapeHtml(record.clientName.length > 0 ? record.clientName : '未命名设备');
      htmlParts.push(
        `<div class="upload-item"><div class="upload-name">${safeName}</div><div>分类：${safeCategory}</div><div>大小：${sizeText} 字节</div><div>来源设备：${safeClient}</div><div>状态：${safeStatus}</div><div>接收时间：${timeText}</div></div>`
      );
    }
    return htmlParts.join('');
  }

  private buildWsConnectionKey(clientConnection: webSocket.WebSocketConnection): string {
    return `${clientConnection.clientIP}:${clientConnection.clientPort}`;
  }

  private async broadcastRuntimeUpdate(): Promise<void> {
    if (this.wsServer === null || this.wsConnections.size <= 0) {
      return;
    }
    const payload = this.buildInfoJsonPayload();
    for (const clientConnection of this.wsConnections.values()) {
      try {
        await this.wsServer.send(payload, clientConnection);
      } catch (error) {
        logger.warn(TAG, `广播WebSocket运行态失败: ${this.stringifyError(error)}`);
      }
    }
  }

  private async broadcastUploadsUpdate(): Promise<void> {
    if (this.wsServer === null || this.wsConnections.size <= 0) {
      return;
    }
    const payload = this.buildUploadsJsonPayload();
    for (const clientConnection of this.wsConnections.values()) {
      try {
        await this.wsServer.send(payload, clientConnection);
      } catch (error) {
        logger.warn(TAG, `广播WebSocket上传列表失败: ${this.stringifyError(error)}`);
      }
    }
  }

  private async sendWebSocketInfo(clientConnection: webSocket.WebSocketConnection): Promise<void> {
    if (this.wsServer === null) {
      return;
    }
    const payload = this.buildInfoJsonPayload();
    try {
      await this.wsServer.send(payload, clientConnection);
    } catch (error) {
      logger.warn(TAG, `发送WebSocket状态失败: ${this.stringifyError(error)}`);
    }
  }

  private async handleWebSocketMessage(message: webSocket.WebSocketMessage): Promise<void> {
    if (this.wsServer === null) {
      return;
    }
    this.markActivity();
    let messageText = '';
    if (typeof message.data === 'string') {
      messageText = message.data;
    } else {
      messageText = this.decoder.decodeToString(new Uint8Array(message.data));
    }
    const normalizedMessage = messageText.trim().toLowerCase();
    if (normalizedMessage === 'info' || normalizedMessage.length <= 0) {
      await this.sendWebSocketInfo(message.clientConnection);
      return;
    }
    if (normalizedMessage === 'uploads') {
      try {
        await this.wsServer.send(this.buildUploadsJsonPayload(), message.clientConnection);
      } catch (error) {
        logger.warn(TAG, `发送WebSocket上传列表失败: ${this.stringifyError(error)}`);
      }
      return;
    }
    const fallbackPayload: TransferBasicResponse = {
      ok: true,
      message: '当前 WebSocket 通道支持 info 和 uploads 两种查询。'
    };
    try {
      await this.wsServer.send(JSON.stringify(fallbackPayload), message.clientConnection);
    } catch (error) {
      logger.warn(TAG, `发送WebSocket回退消息失败: ${this.stringifyError(error)}`);
    }
  }

  private resolveLocalAddresses(port: number): TransferLocalAddress[] {
    const addresses: TransferLocalAddress[] = [];
    try {
      const netHandle = connection.getDefaultNetSync();
      const properties = connection.getConnectionPropertiesSync(netHandle);
      for (const linkAddress of properties.linkAddresses) {
        const host = linkAddress.address.address;
        if (host.indexOf(':') >= 0) {
          continue;
        }
        this.pushAddressIfMissing(addresses, host, port);
      }
    } catch (error) {
      logger.warn(TAG, `获取本地网络地址失败: ${this.stringifyError(error)}`);
    }

    if (addresses.length <= 0) {
      this.pushAddressIfMissing(addresses, '127.0.0.1', port);
    }

    for (let index = 0; index < addresses.length; index++) {
      addresses[index].label = index === 0 ? '主地址' : `备用地址 ${index}`;
      addresses[index].isPrimary = index === 0;
    }
    return addresses;
  }

  private pushAddressIfMissing(addresses: TransferLocalAddress[], host: string, port: number): void {
    const normalizedHost = host.trim();
    if (normalizedHost.length <= 0) {
      return;
    }
    for (const item of addresses) {
      if (item.host === normalizedHost) {
        return;
      }
    }
    const address: TransferLocalAddress = {
      label: '地址',
      host: normalizedHost,
      port: port,
      url: `http://${normalizedHost}:${port}`,
      isPrimary: false
    };
    addresses.push(address);
  }

  private refreshRuntimePresentation(): void {
    if (this.runtime.status !== 'running') {
      return;
    }

    const session = this.sessionManager.getSessionSnapshot();
    let effectiveSession: TransferSessionInfo | null = session;
    if (effectiveSession === null || effectiveSession.status === 'expired') {
      effectiveSession = this.sessionManager.createOrRefreshSession(DEFAULT_SESSION_TTL_MINUTES);
    }

    const localAddresses: TransferLocalAddress[] = this.resolveLocalAddresses(this.runtime.activePort);
    const clonedAddresses: TransferLocalAddress[] = [];
    for (const address of localAddresses) {
      clonedAddresses.push(cloneTransferLocalAddress(address));
    }
    this.runtime.localAddresses = clonedAddresses;
    this.runtime.session = effectiveSession;
    this.runtime.phase = this.resolveRuntimePhase();
    this.runtime.backgroundRunning = BackgroundTaskHelper.isRunning();
  }

  private resolveRuntimePhase(): 'scaffold' | 'upload_pending' | 'active' {
    const records = this.uploadStoreService.getCachedRecords(8);
    for (const record of records) {
      if (record.status === 'received') {
        return 'upload_pending';
      }
    }
    return 'active';
  }

  private markActivity(): void {
    this.sessionManager.touchSession();
    if (this.runtime.status === 'running') {
      this.armAutoStopTimer(this.configManager.getConfig());
    }
  }

  private armAutoStopTimer(config: TransferConfig): void {
    this.clearAutoStopTimer();
    const delayMs = config.autoStopMinutes * 60 * 1000;
    if (delayMs <= 0) {
      return;
    }
    this.autoStopTimer = setTimeout(() => {
      logger.info(TAG, `触发自动停服，空闲时长达到 ${config.autoStopMinutes} 分钟`);
      void this.stop('空闲超时，服务已自动停止。');
    }, delayMs);
  }

  private clearAutoStopTimer(): void {
    if (this.autoStopTimer >= 0) {
      clearTimeout(this.autoStopTimer);
      this.autoStopTimer = -1;
    }
  }

  private async cleanupTcpConnection(clientId: number): Promise<void> {
    const state = this.connectionStates.get(clientId);
    if (state !== null && state !== undefined && state.uploadSession !== null) {
      await this.uploadStoreService.abortUpload(state.uploadSession);
    }
    this.connectionStates.delete(clientId);
    this.tcpConnections.delete(clientId);
  }

  private async closeAllTcpConnections(): Promise<void> {
    const connections: socket.TCPSocketConnection[] = [];
    for (const connectionItem of this.tcpConnections.values()) {
      connections.push(connectionItem);
    }
    for (const connectionItem of connections) {
      try {
        await connectionItem.close();
      } catch (error) {
        logger.warn(TAG, `关闭TCP客户端连接失败: ${this.stringifyError(error)}`);
      }
    }
  }

  private createConnectionState(): TransferConnectionState {
    const state: TransferConnectionState = {
      bufferChunks: [],
      bufferedBytes: 0,
      parsedRequest: null,
      uploadSession: null,
      uploadBodyReceivedBytes: 0,
      remoteAddress: '',
      requestHandled: false,
      closeScheduled: false
    };
    return state;
  }

  private appendBufferedChunk(state: TransferConnectionState, chunk: Uint8Array): void {
    if (chunk.byteLength <= 0) {
      return;
    }
    state.bufferChunks.push(chunk);
    state.bufferedBytes += chunk.byteLength;
  }

  private tryParseHttpRequest(state: TransferConnectionState): TransferParsedHttpRequest | null {
    if (state.bufferedBytes <= 0) {
      return null;
    }

    const prefixBytes = this.collectPrefixBytes(state.bufferChunks, state.bufferedBytes, MAX_HEADER_SIZE_BYTES);
    const headerMarkerIndex = this.findHeaderBoundary(prefixBytes);
    if (headerMarkerIndex < 0) {
      return null;
    }

    const headerBytesLength = headerMarkerIndex + 4;
    const headerText = this.decoder.decodeToString(this.sliceUint8Array(prefixBytes, 0, headerBytesLength));
    const headerLines = headerText.split('\r\n');
    if (headerLines.length <= 0 || headerLines[0].trim().length <= 0) {
      throw new Error('无效的 HTTP 请求行');
    }

    const requestLine = headerLines[0].trim();
    const requestLineParts = requestLine.split(' ');
    if (requestLineParts.length < 2) {
      throw new Error('无效的 HTTP 请求行');
    }

    const method = requestLineParts[0].toUpperCase();
    const rawPath = requestLineParts[1];
    const path = this.normalizeHttpPath(rawPath);
    const headers: TransferHttpHeaderItem[] = [];
    for (let index = 1; index < headerLines.length; index++) {
      const line = headerLines[index];
      if (line.trim().length <= 0) {
        continue;
      }
      const colonIndex = line.indexOf(':');
      if (colonIndex <= 0) {
        continue;
      }
      const header: TransferHttpHeaderItem = {
        name: line.substring(0, colonIndex).trim().toLowerCase(),
        value: line.substring(colonIndex + 1).trim()
      };
      headers.push(header);
    }

    const contentLengthValue = this.getHeaderValue(headers, 'content-length');
    let contentLength = 0;
    if (contentLengthValue.length > 0) {
      if (!/^\d+$/.test(contentLengthValue)) {
        throw new Error('Content-Length 非法');
      }
      contentLength = parseInt(contentLengthValue, 10);
      if (!Number.isFinite(contentLength) || contentLength < 0) {
        throw new Error('Content-Length 非法');
      }
    }

    const parsedRequest: TransferParsedHttpRequest = {
      method: method,
      rawPath: rawPath,
      path: path,
      headers: headers,
      contentLength: contentLength,
      headerBytesLength: headerBytesLength,
      route: this.resolveRequestRoute(path)
    };
    return parsedRequest;
  }

  private resolveRequestRoute(path: string): TransferHttpRoute {
    if (path === '/') {
      return 'landing';
    }
    if (path === '/api/info') {
      return 'info';
    }
    if (path === '/api/uploads') {
      return 'uploads';
    }
    if (path === '/health') {
      return 'health';
    }
    if (path === '/api/pair/verify') {
      return 'pair_verify';
    }
    if (path === '/api/upload') {
      return 'upload';
    }
    return 'unknown';
  }

  private validateRequestAuthorization(request: TransferParsedHttpRequest, remoteAddress: string): boolean {
    const token = this.getHeaderValue(request.headers, 'x-transfer-token').trim();
    if (token.length > 0 && this.sessionManager.validateTokenForClient(token, remoteAddress)) {
      return true;
    }

    const pairCode = this.getHeaderValue(request.headers, 'x-pair-code').trim();
    if (pairCode.length > 0 && this.sessionManager.validatePairCode(pairCode)) {
      if (!this.sessionManager.canPairClient(remoteAddress)) {
        return false;
      }
      const clientName = this.resolveClientName(request);
      const session = this.sessionManager.markPaired(clientName, remoteAddress);
      if (session === null) {
        return false;
      }
      this.runtime.session = session;
      this.runtime.phase = this.resolveRuntimePhase();
      return true;
    }
    return false;
  }

  private resolveUploadFileName(request: TransferParsedHttpRequest): string {
    const rawValue = this.getHeaderValue(request.headers, 'x-file-name').trim();
    if (rawValue.length <= 0) {
      return '';
    }
    try {
      return decodeURIComponent(rawValue);
    } catch (_error) {
      return rawValue;
    }
  }

  private resolveClientName(request: TransferParsedHttpRequest): string {
    const clientName = this.getHeaderValue(request.headers, 'x-client-name').trim();
    if (clientName.length > 0) {
      try {
        return decodeURIComponent(clientName);
      } catch (_error) {
        return clientName;
      }
    }

    const userAgent = this.getHeaderValue(request.headers, 'user-agent').trim();
    if (userAgent.length > 0) {
      if (userAgent.length > 40) {
        return userAgent.substring(0, 40);
      }
      return userAgent;
    }
    return '浏览器';
  }

  private resolveContentType(request: TransferParsedHttpRequest): string {
    const contentType = this.getHeaderValue(request.headers, 'content-type').trim();
    if (contentType.length > 0) {
      return contentType;
    }
    return 'application/octet-stream';
  }

  private getHeaderValue(headers: TransferHttpHeaderItem[], name: string): string {
    const normalizedName = name.trim().toLowerCase();
    for (const header of headers) {
      if (header.name === normalizedName) {
        return header.value;
      }
    }
    return '';
  }

  private collectPrefixBytes(chunks: Uint8Array[], totalBytes: number, maxBytes: number): Uint8Array {
    const targetLength = totalBytes < maxBytes ? totalBytes : maxBytes;
    const result = new Uint8Array(targetLength);
    let offset = 0;
    for (const chunk of chunks) {
      if (offset >= targetLength) {
        break;
      }
      const writableLength = Math.min(chunk.byteLength, targetLength - offset);
      result.set(chunk.subarray(0, writableLength), offset);
      offset += writableLength;
    }
    return result;
  }

  private flattenChunks(chunks: Uint8Array[], totalBytes: number): Uint8Array {
    const result = new Uint8Array(totalBytes);
    let offset = 0;
    for (const chunk of chunks) {
      if (offset >= totalBytes) {
        break;
      }
      const writableLength = Math.min(chunk.byteLength, totalBytes - offset);
      result.set(chunk.subarray(0, writableLength), offset);
      offset += writableLength;
    }
    return result;
  }

  private findHeaderBoundary(buffer: Uint8Array): number {
    for (let index = 0; index <= buffer.byteLength - 4; index++) {
      if (
        buffer[index] === 13 &&
        buffer[index + 1] === 10 &&
        buffer[index + 2] === 13 &&
        buffer[index + 3] === 10
      ) {
        return index;
      }
    }
    return -1;
  }

  private sliceUint8Array(source: Uint8Array, start: number, end: number): Uint8Array {
    const normalizedStart = start >= 0 ? start : 0;
    const normalizedEnd = end >= normalizedStart ? end : normalizedStart;
    const length = normalizedEnd - normalizedStart;
    const result = new Uint8Array(length);
    if (length > 0) {
      result.set(source.subarray(normalizedStart, normalizedEnd), 0);
    }
    return result;
  }

  private copyArrayBufferToUint8Array(buffer: ArrayBuffer): Uint8Array {
    const source = new Uint8Array(buffer);
    const copy = new Uint8Array(source.byteLength);
    copy.set(source);
    return copy;
  }

  private concatUint8Arrays(parts: Uint8Array[]): Uint8Array {
    let totalLength = 0;
    for (const part of parts) {
      totalLength += part.byteLength;
    }
    const result = new Uint8Array(totalLength);
    let offset = 0;
    for (const part of parts) {
      result.set(part, offset);
      offset += part.byteLength;
    }
    return result;
  }

  private normalizeHttpPath(path: string): string {
    const trimmedPath = path.trim();
    const queryIndex = trimmedPath.indexOf('?');
    if (queryIndex >= 0) {
      return trimmedPath.substring(0, queryIndex);
    }
    return trimmedPath;
  }

  private logParsedRequest(request: TransferParsedHttpRequest, remoteAddress: string): void {
    const summary = `${request.method} ${request.path} from ${remoteAddress}, contentLength=${request.contentLength}`;
    if (request.route === 'pair_verify' || request.route === 'upload') {
      logger.info(TAG, `HTTP请求: ${summary}`);
      return;
    }
    logger.debug(TAG, `HTTP请求: ${summary}`);
  }

  private scheduleConnectionClose(clientConnection: socket.TCPSocketConnection): void {
    const state = this.connectionStates.get(clientConnection.clientId);
    if (state !== null && state !== undefined) {
      if (state.closeScheduled) {
        return;
      }
      state.closeScheduled = true;
    }
    setTimeout(() => {
      void this.closeConnectionAfterResponse(clientConnection);
    }, 40);
  }

  private async closeConnectionAfterResponse(clientConnection: socket.TCPSocketConnection): Promise<void> {
    try {
      await clientConnection.close();
    } catch (error) {
      logger.debug(TAG, `响应后关闭TCP连接失败: ${this.stringifyError(error)}`);
    }
  }

  private getHttpStatusReason(statusCode: number): string {
    if (statusCode === 200) {
      return 'OK';
    }
    if (statusCode === 400) {
      return 'Bad Request';
    }
    if (statusCode === 403) {
      return 'Forbidden';
    }
    if (statusCode === 404) {
      return 'Not Found';
    }
    if (statusCode === 405) {
      return 'Method Not Allowed';
    }
    if (statusCode === 413) {
      return 'Payload Too Large';
    }
    if (statusCode === 431) {
      return 'Request Header Fields Too Large';
    }
    if (statusCode === 500) {
      return 'Internal Server Error';
    }
    return 'OK';
  }

  private formatTimestamp(timestamp: number): string {
    const date = new Date(timestamp);
    const year = String(date.getFullYear());
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    const seconds = String(date.getSeconds()).padStart(2, '0');
    return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;
  }

  private describeUploadStatus(status: string): string {
    if (status === 'handoff_sent') {
      return '已转交导入';
    }
    if (status === 'imported') {
      return '已导入完成';
    }
    if (status === 'import_failed') {
      return '导入失败';
    }
    if (status === 'import_cancelled') {
      return '已取消导入';
    }
    return '待继续导入';
  }

  private stringifyError(error: Object): string {
    if (error instanceof Error) {
      return error.message;
    }
    try {
      return JSON.stringify(error);
    } catch (_jsonError) {
      return String(error);
    }
  }

  private escapeHtml(value: string): string {
    let result = value;
    result = result.replace(/&/g, '&amp;');
    result = result.replace(/</g, '&lt;');
    result = result.replace(/>/g, '&gt;');
    result = result.replace(/"/g, '&quot;');
    result = result.replace(/'/g, '&#39;');
    return result;
  }
}

export function getLocalTransferServerService(): LocalTransferServerService {
  return LocalTransferServerService.getInstance();
}
