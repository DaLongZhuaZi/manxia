/**
 * 局域网传书本地服务
 *
 * 当前阶段能力：
 * 1. 启动 / 停止本地 TCP 服务
 * 2. 提供 GET /、GET /api/info、GET /api/uploads、GET /health
 * 3. 提供 POST /api/pair/verify、POST /api/upload
 * 4. 基于请求头先解析、文件体分段落盘的首版上传链路
 */

import socket from '@ohos.net.socket';
import webSocket from '@ohos.net.webSocket';
import { util } from '@kit.ArkTS';
import { common } from '@kit.AbilityKit';
import { connection } from '@kit.NetworkKit';
import { logger } from '../../Utils/Logger';
import {
  TransferConfig,
  TransferInfoResponse,
  TransferLocalAddress,
  TransferServerRuntime,
  TransferSessionInfo,
  TransferUploadRecord,
  buildTransferInfoResponse,
  cloneTransferLocalAddress,
  cloneTransferServerRuntime,
  createEmptyTransferServerRuntime
} from '../../Models/TransferModels';
import { getTransferConfigManager, TransferConfigManager } from '../Managers/TransferConfigManager';
import { getTransferSessionManager, TransferSessionManager } from '../Managers/TransferSessionManager';
import { BackgroundTaskHelper } from '../Task/BackgroundTaskHelper';
import {
  getTransferUploadStoreService,
  TransferStagedUploadSession,
  TransferUploadStoreService
} from './TransferUploadStoreService';

const TAG = 'LocalTransferServer';
const BACKGROUND_OWNER = 'local_transfer_server';
const DEFAULT_SESSION_TTL_MINUTES = 10;
const MAX_HEADER_SIZE_BYTES = 32 * 1024;
const MAX_RECENT_UPLOADS_RESPONSE = 12;

type TransferHttpRoute = 'landing' | 'info' | 'health' | 'pair_verify' | 'upload' | 'uploads' | 'unknown';

interface TransferHttpHeaderItem {
  name: string;
  value: string;
}

interface TransferParsedHttpRequest {
  method: string;
  rawPath: string;
  path: string;
  headers: TransferHttpHeaderItem[];
  contentLength: number;
  headerBytesLength: number;
  route: TransferHttpRoute;
}

interface TransferConnectionState {
  bufferChunks: Uint8Array[];
  bufferedBytes: number;
  parsedRequest: TransferParsedHttpRequest | null;
  uploadSession: TransferStagedUploadSession | null;
  uploadBodyReceivedBytes: number;
  remoteAddress: string;
  requestHandled: boolean;
  closeScheduled: boolean;
}

interface TransferUploadResultResponse {
  ok: boolean;
  message: string;
  recordId: string;
  fileName: string;
  importCategory: string;
  fileSizeBytes: number;
  receivedAt: number;
}

interface TransferPairVerifyResponse {
  ok: boolean;
  message: string;
  token: string;
  sessionId: string;
  expiresAt: number;
  pairCode: string;
}

interface TransferRecentUploadsResponseItem {
  id: string;
  fileName: string;
  importCategory: string;
  fileSizeBytes: number;
  receivedAt: number;
  status: string;
  statusLabel: string;
  clientName: string;
}

interface TransferRecentUploadsResponse {
  ok: boolean;
  count: number;
  records: TransferRecentUploadsResponseItem[];
}

interface TransferBasicResponse {
  ok: boolean;
  message: string;
}

export class LocalTransferServerService {
  private static instance: LocalTransferServerService;

  private tcpServer: socket.TCPSocketServer | null = null;
  private wsServer: webSocket.WebSocketServer | null = null;
  private runtime: TransferServerRuntime = createEmptyTransferServerRuntime();
  private readonly decoder: util.TextDecoder = new util.TextDecoder('utf-8');
  private readonly encoder: util.TextEncoder = new util.TextEncoder();
  private readonly connectionStates: Map<number, TransferConnectionState> = new Map<number, TransferConnectionState>();
  private readonly tcpConnections: Map<number, socket.TCPSocketConnection> = new Map<number, socket.TCPSocketConnection>();
  private readonly wsConnections: Map<string, webSocket.WebSocketConnection> = new Map<string, webSocket.WebSocketConnection>();
  private readonly configManager: TransferConfigManager = getTransferConfigManager();
  private readonly sessionManager: TransferSessionManager = getTransferSessionManager();
  private readonly uploadStoreService: TransferUploadStoreService = getTransferUploadStoreService();
  private lastAbilityContext: common.UIAbilityContext | null = null;
  private autoStopTimer: number = -1;

  private constructor() {}

  public static getInstance(): LocalTransferServerService {
    if (!LocalTransferServerService.instance) {
      LocalTransferServerService.instance = new LocalTransferServerService();
    }
    return LocalTransferServerService.instance;
  }

  public getRuntimeState(): TransferServerRuntime {
    this.refreshRuntimePresentation();
    return cloneTransferServerRuntime(this.runtime);
  }

  public isRunning(): boolean {
    return this.runtime.status === 'running';
  }

  public refreshSession(): TransferServerRuntime {
    if (this.runtime.status === 'running') {
      this.sessionManager.refreshSession(DEFAULT_SESSION_TTL_MINUTES);
      this.refreshRuntimePresentation();
      this.markActivity();
      void this.broadcastRuntimeUpdate();
    }
    return this.getRuntimeState();
  }

  public async start(context: common.UIAbilityContext): Promise<TransferServerRuntime> {
    if (this.runtime.status === 'running') {
      this.lastAbilityContext = context;
      this.refreshRuntimePresentation();
      return this.getRuntimeState();
    }
    if (this.runtime.status === 'starting') {
      return this.getRuntimeState();
    }

    this.runtime.status = 'starting';
    this.runtime.infoMessage = '正在启动本地传书服务...';
    this.runtime.lastError = '';
    this.lastAbilityContext = context;

    const config = this.configManager.getConfig();
    const session = this.sessionManager.createOrRefreshSession(DEFAULT_SESSION_TTL_MINUTES);
    logger.info(TAG, `准备启动局域网传书服务: 端口=${config.port}, 配对码=${session.pairCode}`);

    try {
      await this.uploadStoreService.initialize();
      await this.startTcpServer(config);

      const activePort = this.runtime.activePort;
      let wsPort = 0;
      if (config.wsEnabled) {
        wsPort = await this.startOptionalWebSocketServer(activePort + 1);
      }

      if (config.allowBackgroundTransfer) {
        await BackgroundTaskHelper.startDataTransferTask(context, BACKGROUND_OWNER);
      }

      const addresses = this.resolveLocalAddresses(activePort);
      this.runtime.status = 'running';
      this.runtime.phase = this.resolveRuntimePhase();
      this.runtime.webSocketPort = wsPort;
      this.runtime.startedAt = Date.now();
      this.runtime.lastError = '';
      this.runtime.infoMessage = '服务已启动，可在同一局域网浏览器中完成配对和上传。';
      this.runtime.backgroundRunning = BackgroundTaskHelper.isRunning();
      this.runtime.localAddresses = addresses;
      this.runtime.session = session;

      this.armAutoStopTimer(config);
      logger.info(TAG, `局域网传书服务已启动: 端口=${activePort}, 地址数=${addresses.length}`);
      return this.getRuntimeState();
    } catch (error) {
      const errorMessage = this.stringifyError(error);
      logger.error(TAG, `启动局域网传书服务失败: ${errorMessage}`);
      await this.stopInternal('启动失败，服务未运行。');
      this.runtime.status = 'error';
      this.runtime.lastError = errorMessage;
      this.runtime.infoMessage = `启动失败: ${errorMessage}`;
      return this.getRuntimeState();
    }
  }

  public async stop(reason: string = '服务已停止。'): Promise<TransferServerRuntime> {
    await this.stopInternal(reason);
    return this.getRuntimeState();
  }

  private async stopInternal(reason: string): Promise<void> {
    if (this.runtime.status === 'stopping') {
      return;
    }
    this.runtime.status = 'stopping';
    this.clearAutoStopTimer();

    await this.stopWebSocketServer();
    await this.closeAllTcpConnections();
    await this.stopTcpServer();

    if (this.lastAbilityContext !== null && BackgroundTaskHelper.getOwnerCount() > 0) {
      try {
        await BackgroundTaskHelper.stopDataTransferTask(this.lastAbilityContext, BACKGROUND_OWNER);
      } catch (error) {
        logger.warn(TAG, `停止后台长时任务失败: ${this.stringifyError(error)}`);
      }
    }

    this.sessionManager.clearSession();
    this.connectionStates.clear();
    this.tcpConnections.clear();
    this.wsConnections.clear();

    this.runtime = createEmptyTransferServerRuntime();
    this.runtime.infoMessage = reason;
  }

  private async startTcpServer(config: TransferConfig): Promise<void> {
    const server = socket.constructTCPSocketServerInstance();
    server.on('connect', (clientConnection: socket.TCPSocketConnection) => {
      this.handleTcpConnect(clientConnection);
    });
    server.on('error', (error: Error) => {
      const errorMessage = this.stringifyError(error);
      logger.error(TAG, `TCP服务异常: ${errorMessage}`);
      this.runtime.lastError = errorMessage;
    });

    const listenAddress: connection.NetAddress = {
      address: '0.0.0.0',
      family: 1,
      port: config.port
    };
    await server.listen(listenAddress);
    const localAddress = await server.getLocalAddress();

    this.tcpServer = server;
    this.runtime.activePort = localAddress.port !== undefined ? localAddress.port : config.port;
    logger.info(TAG, `TCP服务监听成功: 0.0.0.0:${this.runtime.activePort}`);
  }

  private async stopTcpServer(): Promise<void> {
    if (this.tcpServer === null) {
      return;
    }
    try {
      this.tcpServer.off('connect');
      this.tcpServer.off('error');
      await this.tcpServer.close();
      logger.info(TAG, 'TCP服务已关闭');
    } catch (error) {
      logger.warn(TAG, `关闭TCP服务失败: ${this.stringifyError(error)}`);
    } finally {
      this.tcpServer = null;
    }
  }

  private async startOptionalWebSocketServer(targetPort: number): Promise<number> {
    try {
      const server = webSocket.createWebSocketServer();
      server.on('connect', (clientConnection: webSocket.WebSocketConnection) => {
        this.wsConnections.set(this.buildWsConnectionKey(clientConnection), clientConnection);
        logger.info(TAG, `WebSocket客户端已连接: ${clientConnection.clientIP}:${clientConnection.clientPort}`);
        void this.sendWebSocketInfo(clientConnection);
      });
      server.on('messageReceive', (message: webSocket.WebSocketMessage) => {
        void this.handleWebSocketMessage(message);
      });
      server.on('close', (clientConnection: webSocket.WebSocketConnection) => {
        this.wsConnections.delete(this.buildWsConnectionKey(clientConnection));
        logger.info(TAG, `WebSocket客户端已断开: ${clientConnection.clientIP}:${clientConnection.clientPort}`);
      });
      server.on('error', (error: Error) => {
        logger.warn(TAG, `WebSocket状态通道异常: ${this.stringifyError(error)}`);
      });

      const serverConfig: webSocket.WebSocketServerConfig = {
        serverIP: '0.0.0.0',
        serverPort: targetPort,
        maxConcurrentClientsNumber: 8,
        maxConnectionsForOneClient: 2
      };
      const started = await server.start(serverConfig);
      if (!started) {
        logger.warn(TAG, 'WebSocket状态通道启动返回 false，将忽略该通道');
        return 0;
      }

      this.wsServer = server;
      this.wsConnections.clear();
      logger.info(TAG, `WebSocket状态通道已启动: 0.0.0.0:${targetPort}`);
      return targetPort;
    } catch (error) {
      logger.warn(TAG, `WebSocket状态通道启动失败，将继续使用纯HTTP链路: ${this.stringifyError(error)}`);
      return 0;
    }
  }

  private async stopWebSocketServer(): Promise<void> {
    if (this.wsServer === null) {
      return;
    }
    try {
      this.wsServer.off('connect');
      this.wsServer.off('messageReceive');
      this.wsServer.off('close');
      this.wsServer.off('error');
      await this.wsServer.stop();
      logger.info(TAG, 'WebSocket状态通道已关闭');
    } catch (error) {
      logger.warn(TAG, `关闭WebSocket状态通道失败: ${this.stringifyError(error)}`);
    } finally {
      this.wsConnections.clear();
      this.wsServer = null;
    }
  }

  private handleTcpConnect(clientConnection: socket.TCPSocketConnection): void {
    logger.debug(TAG, `收到TCP连接: clientId=${clientConnection.clientId}`);
    this.tcpConnections.set(clientConnection.clientId, clientConnection);
    this.connectionStates.set(clientConnection.clientId, this.createConnectionState());
    this.markActivity();

    clientConnection.on('message', (messageInfo: socket.SocketMessageInfo) => {
      void this.handleTcpMessage(clientConnection, messageInfo);
    });
    clientConnection.on('close', () => {
      void this.cleanupTcpConnection(clientConnection.clientId);
      logger.debug(TAG, `TCP连接已关闭: clientId=${clientConnection.clientId}`);
    });
    clientConnection.on('error', (error: Error) => {
      logger.warn(TAG, `TCP连接异常: clientId=${clientConnection.clientId}, ${this.stringifyError(error)}`);
      void this.cleanupTcpConnection(clientConnection.clientId);
    });
  }

  private async handleTcpMessage(
    clientConnection: socket.TCPSocketConnection,
    messageInfo: socket.SocketMessageInfo
  ): Promise<void> {
    const state = this.connectionStates.get(clientConnection.clientId);
    if (state === null || state === undefined) {
      return;
    }

    state.remoteAddress = messageInfo.remoteInfo.address;
    this.markActivity();
    if (state.requestHandled) {
      return;
    }
    const chunk = this.copyArrayBufferToUint8Array(messageInfo.message);

    if (state.parsedRequest !== null && state.uploadSession !== null) {
      await this.handleActiveUploadChunk(clientConnection, state, chunk);
      return;
    }

    this.appendBufferedChunk(state, chunk);
    await this.processBufferedConnectionState(clientConnection, state);
  }

  private async processBufferedConnectionState(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState
  ): Promise<void> {
    if (state.parsedRequest === null) {
      try {
        const parsedRequest = this.tryParseHttpRequest(state);
        if (parsedRequest === null) {
          if (state.bufferedBytes > MAX_HEADER_SIZE_BYTES) {
            logger.warn(TAG, `请求头过大: client=${state.remoteAddress}, bytes=${state.bufferedBytes}`);
            state.requestHandled = true;
            await this.sendJsonError(clientConnection, 431, '请求头过大');
          }
          return;
        }
        state.parsedRequest = parsedRequest;
        this.logParsedRequest(parsedRequest, state.remoteAddress);
      } catch (error) {
        const errorMessage = this.stringifyError(error);
        logger.warn(TAG, `解析HTTP请求失败: client=${state.remoteAddress}, ${errorMessage}`);
        state.requestHandled = true;
        await this.sendJsonError(clientConnection, 400, errorMessage);
        return;
      }
    }

    if (state.parsedRequest.route === 'upload') {
      await this.prepareUploadRequest(clientConnection, state);
      return;
    }

    const totalExpectedBytes = state.parsedRequest.headerBytesLength + state.parsedRequest.contentLength;
    if (state.bufferedBytes < totalExpectedBytes) {
      return;
    }

    const requestBytes = this.flattenChunks(state.bufferChunks, totalExpectedBytes);
    const bodyBytes = this.sliceUint8Array(
      requestBytes,
      state.parsedRequest.headerBytesLength,
      totalExpectedBytes
    );
    await this.dispatchHttpRequest(clientConnection, state, state.parsedRequest, bodyBytes);
    state.requestHandled = true;
  }

  private async prepareUploadRequest(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState
  ): Promise<void> {
    const request = state.parsedRequest;
    if (request === null) {
      return;
    }
    if (state.uploadSession !== null) {
      return;
    }

    if (request.method !== 'POST') {
      await this.rejectUploadRequest(clientConnection, state, 405, '上传接口仅支持 POST');
      return;
    }
    if (request.contentLength <= 0) {
      await this.rejectUploadRequest(clientConnection, state, 400, '上传请求缺少有效文件体');
      return;
    }

    const config = this.configManager.getConfig();
    const maxFileSizeBytes = config.maxFileSizeMb * 1024 * 1024;
    if (request.contentLength > maxFileSizeBytes) {
      await this.rejectUploadRequest(
        clientConnection,
        state,
        413,
        `文件超出上限，当前最多支持 ${config.maxFileSizeMb} MB`
      );
      return;
    }

    const pairCheckPassed = this.validateRequestAuthorization(request, state.remoteAddress);
    if (!pairCheckPassed) {
      logger.info(TAG, `上传鉴权失败: client=${state.remoteAddress}, file=${this.resolveUploadFileName(request)}`);
      await this.rejectUploadRequest(clientConnection, state, 403, '配对码或会话令牌无效，请先重新配对');
      return;
    }

    const fileName = this.resolveUploadFileName(request);
    if (fileName.length <= 0) {
      await this.rejectUploadRequest(clientConnection, state, 400, '缺少 X-File-Name 请求头');
      return;
    }

    const clientName = this.resolveClientName(request);
    const contentType = this.resolveContentType(request);
    const pairedSession = this.sessionManager.markPaired(clientName, state.remoteAddress);
    if (pairedSession !== null) {
      this.runtime.session = pairedSession;
    }

    try {
      logger.info(
        TAG,
        `准备接收上传文件: client=${state.remoteAddress}, name=${fileName}, size=${request.contentLength} 字节`
      );
      const uploadSession = await this.uploadStoreService.beginUpload(
        fileName,
        contentType,
        clientName,
        state.remoteAddress,
        request.contentLength
      );
      state.uploadSession = uploadSession;
      state.uploadBodyReceivedBytes = 0;

      const bufferedRequestBytes = this.flattenChunks(state.bufferChunks, state.bufferedBytes);
      const availableBodyBytes = bufferedRequestBytes.byteLength - request.headerBytesLength;
      const initialBodyLength = availableBodyBytes > 0
        ? Math.min(availableBodyBytes, request.contentLength)
        : 0;

      state.bufferChunks = [];
      state.bufferedBytes = 0;

      if (initialBodyLength > 0) {
        const initialBody = this.sliceUint8Array(
          bufferedRequestBytes,
          request.headerBytesLength,
          request.headerBytesLength + initialBodyLength
        );
        await this.uploadStoreService.appendUploadChunk(uploadSession, initialBody);
        state.uploadBodyReceivedBytes += initialBody.byteLength;
      }

      if (state.uploadBodyReceivedBytes >= request.contentLength) {
        await this.completeUploadRequest(clientConnection, state);
      }
    } catch (error) {
      if (state.uploadSession !== null) {
        try {
          await this.uploadStoreService.abortUpload(state.uploadSession);
        } catch (_abortError) {
        }
        state.uploadSession = null;
        state.uploadBodyReceivedBytes = 0;
      }
      const errorMessage = this.stringifyError(error);
      logger.warn(TAG, `初始化上传会话失败: ${errorMessage}`);
      await this.rejectUploadRequest(clientConnection, state, 400, errorMessage);
    }
  }

  private async rejectUploadRequest(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState,
    statusCode: number,
    message: string
  ): Promise<void> {
    if (state.uploadSession !== null) {
      try {
        await this.uploadStoreService.abortUpload(state.uploadSession);
      } catch (_abortError) {
      }
    }
    state.uploadSession = null;
    state.uploadBodyReceivedBytes = 0;
    state.bufferChunks = [];
    state.bufferedBytes = 0;
    state.requestHandled = true;
    await this.sendJsonError(clientConnection, statusCode, message);
  }

  private async handleActiveUploadChunk(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState,
    chunk: Uint8Array
  ): Promise<void> {
    const request = state.parsedRequest;
    const uploadSession = state.uploadSession;
    if (request === null || uploadSession === null) {
      return;
    }

    const remainingBytes = request.contentLength - state.uploadBodyReceivedBytes;
    if (remainingBytes <= 0) {
      await this.completeUploadRequest(clientConnection, state);
      return;
    }

    const writeLength = Math.min(chunk.byteLength, remainingBytes);
    if (writeLength > 0) {
      const bodyChunk = this.sliceUint8Array(chunk, 0, writeLength);
      try {
        await this.uploadStoreService.appendUploadChunk(uploadSession, bodyChunk);
      } catch (error) {
        logger.warn(TAG, `写入上传数据失败: ${this.stringifyError(error)}`);
        await this.abortUploadConnection(clientConnection, state, '写入上传数据失败');
        return;
      }
      state.uploadBodyReceivedBytes += bodyChunk.byteLength;
    }

    if (state.uploadBodyReceivedBytes >= request.contentLength) {
      await this.completeUploadRequest(clientConnection, state);
    }
  }

  private async completeUploadRequest(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState
  ): Promise<void> {
    const uploadSession = state.uploadSession;
    if (uploadSession === null) {
      await this.sendJsonError(clientConnection, 500, '上传会话不存在');
      return;
    }

    try {
      const record = await this.uploadStoreService.finalizeUpload(uploadSession);
      logger.info(
        TAG,
        `上传完成并已写入收件箱: client=${record.clientIp}, file=${record.fileName}, record=${record.id}`
      );
      state.uploadSession = null;
      state.uploadBodyReceivedBytes = 0;
      this.runtime.phase = 'upload_pending';
      this.runtime.infoMessage = `已接收文件：${record.fileName}，可在应用内继续导入。`;
      this.runtime.lastError = '';
      this.refreshRuntimePresentation();
      await this.broadcastRuntimeUpdate();
      await this.broadcastUploadsUpdate();
      state.requestHandled = true;
      await this.sendUploadSuccess(clientConnection, record);
    } catch (error) {
      const errorMessage = this.stringifyError(error);
      logger.warn(TAG, `完成上传失败: ${errorMessage}`);
      state.uploadSession = null;
      state.uploadBodyReceivedBytes = 0;
      state.requestHandled = true;
      this.runtime.lastError = errorMessage;
      await this.sendJsonError(clientConnection, 500, `完成上传失败: ${errorMessage}`);
    }
  }

  private async abortUploadConnection(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState,
    message: string
  ): Promise<void> {
    if (state.uploadSession !== null) {
      await this.uploadStoreService.abortUpload(state.uploadSession);
      state.uploadSession = null;
      state.uploadBodyReceivedBytes = 0;
    }
    state.requestHandled = true;
    await this.sendJsonError(clientConnection, 500, message);
  }

  private async dispatchHttpRequest(
    clientConnection: socket.TCPSocketConnection,
    state: TransferConnectionState,
    request: TransferParsedHttpRequest,
    _bodyBytes: Uint8Array
  ): Promise<void> {
    if (request.route === 'landing') {
      if (request.method !== 'GET') {
        await this.sendJsonError(clientConnection, 405, '当前接口仅支持 GET');
        return;
      }
      await this.uploadStoreService.consumePendingImportResult();
      this.refreshRuntimePresentation();
      await this.sendHttpResponse(clientConnection, 200, 'text/html; charset=utf-8', this.buildLandingHtml());
      return;
    }

    if (request.route === 'info') {
      if (request.method !== 'GET') {
        await this.sendJsonError(clientConnection, 405, '当前接口仅支持 GET');
        return;
      }
      await this.uploadStoreService.consumePendingImportResult();
      this.refreshRuntimePresentation();
      await this.sendHttpResponse(clientConnection, 200, 'application/json; charset=utf-8', this.buildInfoJsonPayload());
      return;
    }

    if (request.route === 'uploads') {
      if (request.method !== 'GET') {
        await this.sendJsonError(clientConnection, 405, '当前接口仅支持 GET');
        return;
      }
      await this.uploadStoreService.consumePendingImportResult();
      await this.sendHttpResponse(
        clientConnection,
        200,
        'application/json; charset=utf-8',
        this.buildUploadsJsonPayload()
      );
      return;
    }

    if (request.route === 'health') {
      if (request.method !== 'GET') {
        await this.sendJsonError(clientConnection, 405, '当前接口仅支持 GET');
        return;
      }
      await this.sendHttpResponse(clientConnection, 200, 'text/plain; charset=utf-8', 'ok');
      return;
    }

    if (request.route === 'pair_verify') {
      if (request.method !== 'POST') {
        await this.sendJsonError(clientConnection, 405, '配对接口仅支持 POST');
        return;
      }
      await this.handlePairVerifyRequest(clientConnection, request, state.remoteAddress);
      return;
    }

    if (request.route === 'upload') {
      if (request.method !== 'POST') {
        await this.sendJsonError(clientConnection, 405, '上传接口仅支持 POST');
        return;
      }
      await this.sendJsonError(clientConnection, 400, '上传请求尚未完成');
      return;
    }

    await this.sendJsonError(clientConnection, 404, 'Not Found');
  }

  private async handlePairVerifyRequest(
    clientConnection: socket.TCPSocketConnection,
    request: TransferParsedHttpRequest,
    remoteAddress: string
  ): Promise<void> {
    const pairCode = this.getHeaderValue(request.headers, 'x-pair-code').trim();
    const clientName = this.resolveClientName(request);
    logger.info(TAG, `收到配对请求: client=${remoteAddress}, device=${clientName}, pairCode=${pairCode}`);
    if (pairCode.length <= 0) {
      await this.sendJsonError(clientConnection, 400, '缺少 X-Pair-Code 请求头');
      return;
    }
    if (!this.sessionManager.validatePairCode(pairCode)) {
      await this.sendJsonError(clientConnection, 403, '配对码无效或已过期');
      return;
    }

    if (!this.sessionManager.canPairClient(remoteAddress)) {
      await this.sendJsonError(clientConnection, 403, '当前配对码已绑定其他设备，请在 APP 中刷新配对码后重试');
      return;
    }
    const session = this.sessionManager.markPaired(clientName, remoteAddress);
    if (session === null) {
      await this.sendJsonError(clientConnection, 403, '配对会话已失效，请刷新配对码后重试');
      return;
    }

    this.runtime.session = session;
    this.runtime.phase = this.resolveRuntimePhase();
    this.runtime.infoMessage = `已与 ${clientName} 完成配对，可开始上传。`;
    this.runtime.lastError = '';

    const payload: TransferPairVerifyResponse = {
      ok: true,
      message: '配对成功',
      token: session.token,
      sessionId: session.sessionId,
      expiresAt: session.expiresAt,
      pairCode: session.pairCode
    };
    logger.info(TAG, `配对成功: client=${remoteAddress}, device=${clientName}, session=${session.sessionId}`);
    await this.broadcastRuntimeUpdate();
    await this.sendHttpResponse(
      clientConnection,
      200,
      'application/json; charset=utf-8',
      JSON.stringify(payload)
    );
  }

  private async sendUploadSuccess(
    clientConnection: socket.TCPSocketConnection,
    record: TransferUploadRecord
  ): Promise<void> {
    const payload: TransferUploadResultResponse = {
      ok: true,
      message: '上传成功，已保存到应用收件箱',
      recordId: record.id,
      fileName: record.fileName,
      importCategory: record.importCategory,
      fileSizeBytes: record.fileSizeBytes,
      receivedAt: record.receivedAt
    };
    await this.sendHttpResponse(
      clientConnection,
      200,
      'application/json; charset=utf-8',
      JSON.stringify(payload)
    );
  }

  private async sendJsonError(
    clientConnection: socket.TCPSocketConnection,
    statusCode: number,
    message: string
  ): Promise<void> {
    const payload: TransferBasicResponse = {
      ok: false,
      message: message
    };
    await this.sendHttpResponse(
      clientConnection,
      statusCode,
      'application/json; charset=utf-8',
      JSON.stringify(payload)
    );
  }

  private async sendHttpResponse(
    clientConnection: socket.TCPSocketConnection,
    statusCode: number,
    contentType: string,
    body: string
  ): Promise<void> {
    const bodyBuffer = this.encoder.encodeInto(body);
    const reason = this.getHttpStatusReason(statusCode);
    const headers = [
      `HTTP/1.1 ${statusCode} ${reason}`,
      `Content-Type: ${contentType}`,
      `Content-Length: ${bodyBuffer.byteLength}`,
      'Connection: close',
      'Cache-Control: no-store',
      'Access-Control-Allow-Origin: *',
      'Access-Control-Allow-Headers: Content-Type, X-Pair-Code, X-Client-Name, X-File-Name, X-Transfer-Token',
      'Access-Control-Allow-Methods: GET, POST',
      '',
      ''
    ].join('\r\n');
    const headerBuffer = this.encoder.encodeInto(headers);
    const responseBuffer = this.concatUint8Arrays([headerBuffer, bodyBuffer]);

    try {
      await clientConnection.send({
        data: responseBuffer.buffer
      });
    } catch (error) {
      logger.warn(TAG, `发送HTTP响应失败: ${this.stringifyError(error)}`);
    }

    this.scheduleConnectionClose(clientConnection);
  }

  private buildInfoJsonPayload(): string {
    const runtime = this.getRuntimeState();
    const config = this.configManager.getConfig();
    const response: TransferInfoResponse = buildTransferInfoResponse(runtime, config);
    response.uploadEnabled = true;
    return JSON.stringify(response);
  }

  private buildUploadsJsonPayload(): string {
    const records = this.uploadStoreService.getCachedRecords(MAX_RECENT_UPLOADS_RESPONSE);
    const responseItems: TransferRecentUploadsResponseItem[] = [];
    for (const record of records) {
      const item: TransferRecentUploadsResponseItem = {
        id: record.id,
        fileName: record.fileName,
        importCategory: record.importCategory,
        fileSizeBytes: record.fileSizeBytes,
        receivedAt: record.receivedAt,
        status: record.status,
        statusLabel: this.describeUploadStatus(record.status),
        clientName: record.clientName
      };
      responseItems.push(item);
    }
    const payload: TransferRecentUploadsResponse = {
      ok: true,
      count: responseItems.length,
      records: responseItems
    };
    return JSON.stringify(payload);
  }

