/**
 * Compile-time catalog for the system resources used by the debug preview page.
 * Dynamic $r() expressions are intentionally avoided because $r() is compile-time syntax.
 */

const symbolResources: Map<string, Resource> = new Map<string, Resource>();
const mediaResources: Map<string, Resource> = new Map<string, Resource>();
const colorResources: Map<string, Resource> = new Map<string, Resource>();
const warnedKeys: Set<string> = new Set<string>();

function registerSymbol(name: string, resource: Resource): void {
  symbolResources.set(name, resource);
}

function registerMedia(name: string, resource: Resource): void {
  mediaResources.set(name, resource);
}

function registerColor(name: string, resource: Resource): void {
  colorResources.set(name, resource);
}

const fallbackSymbol: Resource = $r('sys.symbol.magnifyingglass');
const fallbackMedia: Resource = $r('sys.media.ohos_ic_public_cancel');
const fallbackColor: Resource = $r('sys.color.ohos_id_color_background');

export function resolveSystemSymbol(name: string): Resource {
  const resource = symbolResources.get(name);
  if (resource === undefined) {
    warnUnknown(name, 'symbol');
    return fallbackSymbol;
  }
  return resource;
}

export function resolveSystemMedia(name: string): Resource {
  const resource = mediaResources.get(name);
  if (resource === undefined) {
    warnUnknown(name, 'media');
    return fallbackMedia;
  }
  return resource;
}

export function resolveSystemColor(name: string): Resource {
  const resource = colorResources.get(name);
  if (resource === undefined) {
    warnUnknown(name, 'color');
    return fallbackColor;
  }
  return resource;
}

function warnUnknown(name: string, kind: string): void {
  const key = `${kind}:${name}`;
  if (!warnedKeys.has(key)) {
    warnedKeys.add(key);
    console.warn(`[SystemResourceCatalog] 未找到系统${kind}资源: ${name}`);
  }
}
