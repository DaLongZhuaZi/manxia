import { ThemeAwareHelper, ThemeAwareState } from '../Framework/Components/ThemeAware';
import { SubscriptionExecutionStatus } from '../Framework/Subscription';

export interface ContentTrackingCardState {
  isLoading: boolean;
  isBusy: boolean;
  supported: boolean;
  unsupportedReason: string;
  hasRule: boolean;
  enabled: boolean;
  ruleName: string;
  providerText: string;
  conditionSummary: string;
  actionSummary: string;
  statusText: string;
  lastCheckText: string;
  latestItemTitle: string;
  lastStatus: SubscriptionExecutionStatus;
}

export interface ContentTrackingCardCallbacks {
  onConfigure: () => void;
  onRunNow: () => void;
  onToggleEnabled: () => void;
  onOpenManagement: () => void;
}

const DEFAULT_CONTENT_TRACKING_CARD_STATE: ContentTrackingCardState = {
  isLoading: false,
  isBusy: false,
  supported: false,
  unsupportedReason: '',
  hasRule: false,
  enabled: false,
  ruleName: '',
  providerText: '',
  conditionSummary: '',
  actionSummary: '',
  statusText: '',
  lastCheckText: '',
  latestItemTitle: '',
  lastStatus: SubscriptionExecutionStatus.NO_UPDATE
};

const DEFAULT_CONTENT_TRACKING_CARD_CALLBACKS: ContentTrackingCardCallbacks = {
  onConfigure: () => {},
  onRunNow: () => {},
  onToggleEnabled: () => {},
  onOpenManagement: () => {}
};

@Component
export struct ContentTrackingStatusCard {
  @Prop state: ContentTrackingCardState = DEFAULT_CONTENT_TRACKING_CARD_STATE;
  @Prop themeState: ThemeAwareState = new ThemeAwareState();
  @Prop appFontFamily: string = 'HarmonyOS Sans';
  @Prop callbacks: ContentTrackingCardCallbacks = DEFAULT_CONTENT_TRACKING_CARD_CALLBACKS;

  private getStatusPillText(): string {
    if (this.state.isLoading) {
      return '读取中';
    }
    if (!this.state.supported) {
      return '暂不支持';
    }
    if (!this.state.hasRule) {
      return '未跟踪';
    }
    return this.state.enabled ? '已启用' : '已停用';
  }

  private getStatusPillColor(): string {
    if (this.state.isLoading) {
      return ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme);
    }
    if (!this.state.supported) {
      return '#C62828';
    }
    if (!this.state.hasRule) {
      return ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme);
    }
    if (!this.state.enabled) {
      return '#EF6C00';
    }
    return ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme);
  }

  private getExecutionColor(): string {
    if (this.state.lastStatus === SubscriptionExecutionStatus.SUCCESS) {
      return ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme);
    }
    if (this.state.lastStatus === SubscriptionExecutionStatus.NO_UPDATE) {
      return ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme);
    }
    if (this.state.lastStatus === SubscriptionExecutionStatus.SKIPPED) {
      return '#8D6E63';
    }
    if (this.state.lastStatus === SubscriptionExecutionStatus.FAILED) {
      return '#C62828';
    }
    if (this.state.lastStatus === SubscriptionExecutionStatus.UNSUPPORTED) {
      return '#8E24AA';
    }
    return ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme);
  }

  private getHeadlineText(): string {
    if (this.state.isLoading) {
      return '正在读取当前内容的跟踪状态';
    }
    if (!this.state.supported) {
      return this.state.unsupportedReason.length > 0
        ? this.state.unsupportedReason
        : '当前内容暂不支持自动跟踪';
    }
    if (!this.state.hasRule) {
      return '当前内容尚未建立跟踪规则';
    }
    if (this.state.statusText.length > 0) {
      return this.state.statusText;
    }
    return this.state.enabled ? '当前规则已启用' : '当前规则已停用';
  }

  @Builder
  private buildActionButton(
    label: string,
    symbol: Resource,
    fontColor: string,
    enabled: boolean,
    onClick: () => void
  ) {
    Button() {
      Row({ space: 6 }) {
        SymbolGlyph(symbol)
          .fontSize(14)
          .fontColor([enabled ? fontColor : ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme)])
        Text(label)
          .fontSize(13)
          .fontFamily(this.appFontFamily)
          .fontColor(enabled ? fontColor : ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
      }
    }
    .height(34)
    .padding({ left: 14, right: 14 })
    .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('comp_background_tertiary', this.themeState.currentTheme))
    .borderRadius(17)
    .margin({ right: 8, bottom: 8 })
    .enabled(enabled)
    .onClick(() => onClick())
  }

  build() {
    Column({ space: 12 }) {
      Row() {
        Row({ space: 8 }) {
          SymbolGlyph($r('sys.symbol.arrow_clockwise'))
            .fontSize(16)
            .fontColor([ThemeAwareHelper.getTestManagementThemedColor('accent_primary', this.themeState.currentTheme)])
          Text('内容跟踪')
            .fontSize(16)
            .fontWeight(FontWeight.Bold)
            .fontFamily(this.appFontFamily)
            .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
        }

        Blank()

        Text(this.getStatusPillText())
          .fontSize(11)
          .fontFamily(this.appFontFamily)
          .fontColor(this.getStatusPillColor())
          .padding({ left: 10, right: 10, top: 5, bottom: 5 })
          .backgroundColor(this.getStatusPillColor() + '18')
          .borderRadius(12)
      }
      .width('100%')

      Text(this.getHeadlineText())
        .fontSize(14)
        .lineHeight(21)
        .fontFamily(this.appFontFamily)
        .fontColor(this.state.supported
          ? ThemeAwareHelper.getTestManagementThemedColor('text_secondary', this.themeState.currentTheme)
          : '#C62828')
        .width('100%')

      if (this.state.providerText.length > 0) {
        Text(this.state.providerText)
          .fontSize(12)
          .fontFamily(this.appFontFamily)
          .fontColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme))
          .padding({ left: 10, right: 10, top: 5, bottom: 5 })
          .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme) + '14')
          .borderRadius(12)
      }

      if (this.state.hasRule) {
        Column({ space: 10 }) {
          if (this.state.ruleName.length > 0) {
            Column({ space: 4 }) {
              Text('规则名称')
                .fontSize(11)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              Text(this.state.ruleName)
                .fontSize(14)
                .fontWeight(FontWeight.Medium)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
            }
            .width('100%')
          }

          Row({ space: 12 }) {
            Column({ space: 4 }) {
              Text('检查条件')
                .fontSize(11)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              Text(this.state.conditionSummary.length > 0 ? this.state.conditionSummary : '未配置')
                .fontSize(13)
                .lineHeight(19)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
            }
            .layoutWeight(1)

            Column({ space: 4 }) {
              Text('更新动作')
                .fontSize(11)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              Text(this.state.actionSummary.length > 0 ? this.state.actionSummary : '仅检查更新')
                .fontSize(13)
                .lineHeight(19)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
            }
            .layoutWeight(1)
          }
          .width('100%')

          Row({ space: 12 }) {
            Column({ space: 4 }) {
              Text('最近检查')
                .fontSize(11)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              Text(this.state.lastCheckText.length > 0 ? this.state.lastCheckText : '尚未执行')
                .fontSize(13)
                .lineHeight(19)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
            }
            .layoutWeight(1)

            Column({ space: 4 }) {
              Text('最近结果')
                .fontSize(11)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              Text(this.state.statusText.length > 0 ? this.state.statusText : '尚无记录')
                .fontSize(13)
                .lineHeight(19)
                .fontFamily(this.appFontFamily)
                .fontColor(this.getExecutionColor())
            }
            .layoutWeight(1)
          }
          .width('100%')

          if (this.state.latestItemTitle.length > 0) {
            Column({ space: 4 }) {
              Text('最新条目')
                .fontSize(11)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_muted', this.themeState.currentTheme))
              Text(this.state.latestItemTitle)
                .fontSize(13)
                .lineHeight(19)
                .fontFamily(this.appFontFamily)
                .fontColor(ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme))
            }
            .width('100%')
          }
        }
        .width('100%')
        .padding(12)
        .alignItems(HorizontalAlign.Start)
        .backgroundColor(ThemeAwareHelper.getTestManagementThemedColor('comp_background_secondary', this.themeState.currentTheme))
        .borderRadius(16)
      }

      Flex({ wrap: FlexWrap.Wrap, alignItems: ItemAlign.Start, justifyContent: FlexAlign.Start }) {
        if (this.state.supported) {
          this.buildActionButton(
            this.state.hasRule ? '编辑跟踪' : '创建跟踪',
            $r('sys.symbol.gearshape'),
            ThemeAwareHelper.getTestManagementThemedColor('accent_primary', this.themeState.currentTheme),
            !this.state.isBusy,
            this.callbacks.onConfigure
          )

          if (this.state.hasRule) {
            this.buildActionButton(
              this.state.isBusy ? '检查中...' : '立即检查',
              $r('sys.symbol.arrow_clockwise'),
              ThemeAwareHelper.getTestManagementThemedColor('accent_blue', this.themeState.currentTheme),
              !this.state.isBusy,
              this.callbacks.onRunNow
            )

            this.buildActionButton(
              this.state.enabled ? '暂停跟踪' : '启用跟踪',
              this.state.enabled ? $r('sys.symbol.pause_fill') : $r('sys.symbol.play_fill'),
              this.state.enabled ? '#EF6C00' : ThemeAwareHelper.getTestManagementThemedColor('accent_green', this.themeState.currentTheme),
              !this.state.isBusy,
              this.callbacks.onToggleEnabled
            )
          }
        }

        this.buildActionButton(
          '管理页',
          $r('sys.symbol.rectangle_stack'),
          ThemeAwareHelper.getTestManagementThemedColor('text_primary', this.themeState.currentTheme),
          !this.state.isBusy,
          this.callbacks.onOpenManagement
        )
      }
      .width('100%')
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
  }
}
