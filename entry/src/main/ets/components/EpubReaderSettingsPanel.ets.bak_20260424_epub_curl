  private uiCtx: UIContext | undefined = undefined;

  aboutToAppear(): void {
    this.uiCtx = this.getUIContext();
    this.syncSettings();
    this.syncPageSettings();
    this.detectOrientation();
    if (this.isVisible) {
      setTimeout(() => {
        this.showPanel();
      }, 50);
    }
  }

