            .fontSize(18)
            .fontColor([$r('app.color.text_primary')])
        }
        .width(40)
        .height(40)
        .backgroundColor($r('app.color.background_secondary'))
        .borderRadius(8)
        .onClick(() => {
          this.current.fontSize = Math.min(36, this.current.fontSize + 1);
          this.notifyTextSettings();
        })
      }
      .width('100%')
    }
    .width('100%')
    .margin({ bottom: 20 })
