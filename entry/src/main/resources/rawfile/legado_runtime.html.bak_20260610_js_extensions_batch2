<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Legado Runtime V2</title>
</head>
<body>
<script>
(function () {
  var RUNTIME_MARKER = 'manxia-legado-runtime-v2';
  var sharedScopes = {};

  function emptyObject(source) {
    var target = {};
    if (!source || typeof source !== 'object') return target;
    Object.keys(source).forEach(function (key) {
      target[key] = source[key] === undefined || source[key] === null ? '' : String(source[key]);
    });
    return target;
  }

  function buildResponse(status, extra) {
    var result = { marker: RUNTIME_MARKER, status: status };
    if (extra && typeof extra === 'object') {
      Object.keys(extra).forEach(function (key) {
        result[key] = extra[key];
      });
    }
    return JSON.stringify(result);
  }

  function normalizeCode(code) {
    var text = code === undefined || code === null ? '' : String(code).trim();
    text = text.replace(/^(?:@|＠)\s*js(?:\:|：)\s*/i, '');
    if (text.indexOf('<js>') === 0 && text.lastIndexOf('</js>') === text.length - 5) {
      text = text.substring(4, text.length - 5).trim();
    }
    return text;
  }

  function createRandom(seed) {
    var current = (Number(seed) || 1) >>> 0;
    return function () {
      current = (Math.imul(current, 1664525) + 1013904223) >>> 0;
      return current / 4294967296;
    };
  }

  function toText(value) {
    if (value === undefined || value === null) return '';
    if (typeof value === 'string') return value;
    if (typeof value === 'number' && isFinite(value) && Math.floor(value) === value) return String(value);
    if (typeof value === 'object') {
      try { return JSON.stringify(value); } catch (e) { return String(value); }
    }
    return String(value);
  }

  function textHash(text) {
    var hash = 2166136261;
    var value = String(text || '');
    for (var i = 0; i < value.length; i++) {
      hash ^= value.charCodeAt(i);
      hash = Math.imul(hash, 16777619) >>> 0;
    }
    return String(hash >>> 0);
  }

  function buildSourceFromContext(context, variables, sourceUrl) {
    var source = context && context.source && typeof context.source === 'object' ? context.source : {};
    return {
      bookSourceUrl: source.bookSourceUrl || sourceUrl,
      bookSourceName: source.bookSourceName || variables.__source_bookSourceName || '',
      bookSourceType: source.bookSourceType || variables.__source_bookSourceType || variables.type || '',
      bookSourceGroup: source.bookSourceGroup || variables.__source_bookSourceGroup || '',
      bookSourceComment: source.bookSourceComment || variables.__source_bookSourceComment || '',
      header: source.header || variables.__source_header || '',
      loginUrl: source.loginUrl || variables.__source_loginUrl || '',
      loginUi: source.loginUi || variables.__source_loginUi || '',
      loginCheckJs: source.loginCheckJs || variables.__source_loginCheckJs || '',
      variableComment: source.variableComment || variables.__source_variableComment || '',
      enabledCookieJar: source.enabledCookieJar !== undefined ? !!source.enabledCookieJar : true
    };
  }

  function createJavaMap(object) {
    var data = object || {};
    return {
      get: function (key) { return data[String(key)] || ''; },
      put: function (key, value) { data[String(key)] = toText(value); return value; },
      containsKey: function (key) { return data[String(key)] !== undefined; },
      keys: function () { return Object.keys(data); },
      keySet: function () { return Object.keys(data); },
      toJSON: function () { return data; },
      toString: function () { return JSON.stringify(data); }
    };
  }

  function stableHexHash(value, salt, length) {
    var text = String(salt || '') + '|' + String(value || '');
    var h1 = 0x811c9dc5;
    var h2 = 0x9e3779b9;
    var hex = '';
    for (var i = 0; i < text.length; i++) {
      var c = text.charCodeAt(i);
      h1 ^= c;
      h1 = Math.imul(h1, 0x01000193) >>> 0;
      h2 ^= c + i;
      h2 = Math.imul(h2, 0x85ebca6b) >>> 0;
    }
    while (hex.length < length) {
      h1 = (Math.imul(h1 ^ (h1 >>> 16), 0x7feb352d) + h2) >>> 0;
      h2 = (Math.imul(h2 ^ (h2 >>> 13), 0x846ca68b) + h1) >>> 0;
      hex += ('00000000' + h1.toString(16)).slice(-8);
      if (hex.length < length) hex += ('00000000' + h2.toString(16)).slice(-8);
    }
    return hex.substring(0, length);
  }

  function digestHexLength(algorithm) {
    var upper = String(algorithm || '').toUpperCase().replace(/-/g, '');
    if (upper.indexOf('SHA512') >= 0) return 128;
    if (upper.indexOf('SHA384') >= 0) return 96;
    if (upper.indexOf('SHA256') >= 0) return 64;
    if (upper.indexOf('SHA1') >= 0) return 40;
    return 32;
  }

  function parseHeaderText(text) {
    var headers = {};
    if (!text) return headers;
    String(text).split(/\r?\n/).forEach(function (line) {
      var index = line.indexOf(':');
      if (index > 0) {
        headers[line.substring(0, index).trim()] = line.substring(index + 1).trim();
      }
    });
    return headers;
  }

  function normalizeHeaders(headers) {
    var result = {};
    if (!headers) return result;
    if (typeof headers === 'string') {
      try {
        headers = JSON.parse(headers);
      } catch (e) {
        return result;
      }
    }
    if (headers && typeof headers === 'object') {
      Object.keys(headers).forEach(function (key) {
        result[key] = String(headers[key]);
      });
    }
    return result;
  }

  function normalizeOption(option) {
    if (!option) return { method: 'GET', body: '', headers: {} };
    if (typeof option === 'string') {
      try {
        option = JSON.parse(option);
      } catch (e) {
        return { method: 'GET', body: '', headers: {} };
      }
    }
    var headers = {};
    var rawHeaders = option.headers || option.header;
    if (rawHeaders && typeof rawHeaders === 'object') {
      Object.keys(rawHeaders).forEach(function (key) {
        headers[key] = String(rawHeaders[key]);
      });
    } else if (!option.method && option.body === undefined && option.header === undefined && option.headers === undefined) {
      headers = normalizeHeaders(option);
    }
    return {
      method: String(option.method || 'GET').toUpperCase(),
      body: option.body === undefined || option.body === null ? '' : String(option.body),
      headers: headers
    };
  }

  function splitUrlOption(url) {
    var text = String(url || '');
    var index = text.indexOf(',');
    if (index <= 0) return { url: text, option: null };
    var before = text.substring(0, index).trim();
    var after = text.substring(index + 1).trim();
    if (!after || (after.charAt(0) !== '{' && after.charAt(0) !== '[')) {
      return { url: text, option: null };
    }
    try {
      return { url: before, option: JSON.parse(after) };
    } catch (e) {
      return { url: text, option: null };
    }
  }

  function makeBridgeId(type, url, method, body, headers, key) {
    return [
      type || '',
      url || '',
      method || '',
      body || '',
      key || '',
      JSON.stringify(headers || {})
    ].join('|');
  }

  function createPendingError(request) {
    var error = new Error('__LEGADO_PENDING_BRIDGE__');
    error.legadoPendingRequest = request;
    return error;
  }

  function buildRuntimeObjects(payload, state, scope, pendingRequests, logs, cookieChanges, toasts) {
    var context = payload.context || {};
    var variables = emptyObject(state.variables || context.variables);
    var sourceUrl = context.sourceUrl || variables.sourceUrl || context.baseUrl || '';
    var sourceSnapshot = buildSourceFromContext(context, variables, sourceUrl);
    var sourceData = emptyObject(state.sourceData);
    var sourceEffects = {};
    var sourceDataChanges = [];
    var cache = state.cache || {};

    function requestBridge(request) {
      if (state.bridgeResponses && state.bridgeResponses[request.id]) {
        return state.bridgeResponses[request.id];
      }
      pendingRequests.push(request);
      throw createPendingError(request);
    }

    function doHttp(url, method, body, headers) {
      var split = splitUrlOption(url);
      var requestUrl = split.url;
      var option = normalizeOption(split.option);
      var actualMethod = String(method || option.method || 'GET').toUpperCase();
      var actualBody = body !== undefined && body !== null ? String(body) : option.body;
      var actualHeaders = {};
      Object.keys(option.headers || {}).forEach(function (key) { actualHeaders[key] = option.headers[key]; });
      Object.keys(headers || {}).forEach(function (key) { actualHeaders[key] = String(headers[key]); });
      var id = makeBridgeId('http', requestUrl, actualMethod, actualBody, actualHeaders, '');
      var response = requestBridge({
        id: id,
        type: 'http',
        url: requestUrl,
        method: actualMethod,
        body: actualBody || '',
        headers: actualHeaders
      });
      return wrapResponse(response);
    }

    function doDigest(value, algorithm) {
      var text = toText(value);
      var alg = String(algorithm || 'MD5');
      var id = makeBridgeId('crypto-digest', '', alg, text, {}, '');
      var response = requestBridge({
        id: id,
        type: 'crypto-digest',
        algorithm: alg,
        value: text
      });
      return response.success ? (response.body || '') : stableHexHash(text, alg, digestHexLength(alg));
    }

    function doHmac(value, key, algorithm) {
      var text = toText(value);
      var secret = toText(key);
      var alg = String(algorithm || 'HmacMD5');
      var id = makeBridgeId('crypto-hmac', '', alg, text, {}, secret);
      var response = requestBridge({
        id: id,
        type: 'crypto-hmac',
        algorithm: alg,
        key: secret,
        value: text
      });
      return response.success ? (response.body || '') : stableHexHash(secret + '|' + text, alg, 64);
    }

    function readRuntimeFile(path) {
      var cleanPath = String(path || '');
      var id = makeBridgeId('file-read', cleanPath, '', '', {}, '');
      var response = requestBridge({
        id: id,
        type: 'file-read',
        path: cleanPath
      });
      return response.success ? (response.body || '') : '';
    }

    function writeRuntimeFile(path, value) {
      var cleanPath = String(path || '');
      var text = toText(value);
      var id = makeBridgeId('file-write', cleanPath, '', text, {}, '');
      var response = requestBridge({
        id: id,
        type: 'file-write',
        path: cleanPath,
        value: text
      });
      return response.path || response.url || cleanPath;
    }

    function downloadRuntimeFile(url) {
      var urlText = String(url || '');
      var id = makeBridgeId('download-file', urlText, 'GET', '', {}, '');
      var response = requestBridge({
        id: id,
        type: 'download-file',
        url: urlText,
        method: 'GET'
      });
      return response.path || response.url || '';
    }

    function executeJsInScope(js, html, url) {
      if (!js) return html || '';
      return executeCode(
        String(js),
        {
          java: java,
          source: source,
          cookie: cookie,
          cache: cacheObject,
          resultValue: html || '',
          baseUrl: url || '',
          key: context.key || '',
          page: context.page || 1,
          book: context.book || {},
          chapter: context.chapter || {},
          src: html || ''
        },
        scope,
        state.now,
        state.randomSeed
      );
    }

    function wrapResponse(response) {
      var headerObject = parseHeaderText(response.headers || '');
      return {
        body: function () { return response.body || ''; },
        bodyString: function () { return response.body || ''; },
        text: function () { return response.body || ''; },
        html: function () { return response.body || ''; },
        url: function () { return response.url || ''; },
        request: function () { return { url: function () { return response.url || ''; } }; },
        code: function () { return response.code || 0; },
        statusCode: function () { return response.code || 0; },
        headers: function () { return headerObject; },
        header: function (name) {
          var target = String(name || '').toLowerCase();
          var keys = Object.keys(headerObject);
          for (var i = 0; i < keys.length; i++) {
            if (keys[i].toLowerCase() === target) return headerObject[keys[i]];
          }
          return '';
        },
        cookies: function () { return {}; },
        cookie: function () { return ''; },
        toString: function () { return response.body || ''; }
      };
    }

    var source = {
      key: sourceUrl,
      bookSourceUrl: sourceUrl,
      bookSourceName: sourceSnapshot.bookSourceName,
      bookSourceType: sourceSnapshot.bookSourceType,
      bookSourceGroup: sourceSnapshot.bookSourceGroup,
      bookSourceComment: sourceSnapshot.bookSourceComment,
      header: sourceSnapshot.header,
      loginUrl: sourceSnapshot.loginUrl,
      loginUi: sourceSnapshot.loginUi,
      loginCheckJs: sourceSnapshot.loginCheckJs,
      variableComment: sourceSnapshot.variableComment,
      enabledCookieJar: sourceSnapshot.enabledCookieJar,
      getKey: function () { return sourceUrl; },
      getTag: function () { return this.bookSourceName || sourceUrl; },
      getHeaderMap: function () {
        try { return createJavaMap(this.header ? JSON.parse(this.header) : {}); } catch (e) { return createJavaMap({}); }
      },
      get: function (key) {
        if (key === 'key' || key === 'bookSourceUrl') return sourceUrl;
        if (key === 'type' || key === 'bookSourceType') return sourceSnapshot.bookSourceType;
        if (key === 'bookSourceName') return sourceSnapshot.bookSourceName;
        if (key === 'bookSourceGroup') return sourceSnapshot.bookSourceGroup;
        if (key === 'bookSourceComment') return sourceSnapshot.bookSourceComment;
        if (key === 'header') return sourceSnapshot.header;
        if (key === 'loginUrl') return sourceSnapshot.loginUrl;
        if (key === 'loginUi') return sourceSnapshot.loginUi;
        if (key === 'loginCheckJs') return sourceSnapshot.loginCheckJs;
        if (key === 'variableComment') return sourceSnapshot.variableComment;
        if (sourceData[key] !== undefined) return sourceData[key];
        if (variables[key] !== undefined) return variables[key];
        return '';
      },
      put: function (key, value) {
        var text = toText(value);
        sourceData[key] = text;
        sourceDataChanges.push({ key: String(key), value: text });
        return text;
      },
      getVariable: function () { return variables.__sourceVariable || ''; },
      setVariable: function (value) {
        sourceEffects.sourceVariable = toText(value);
        variables.__sourceVariable = sourceEffects.sourceVariable;
        return sourceEffects.sourceVariable;
      },
      getLoginInfo: function () { return variables.__loginInfo || ''; },
      putLoginInfo: function (value) {
        sourceEffects.loginInfo = toText(value);
        return true;
      },
      removeLoginInfo: function () {
        sourceEffects.loginInfo = '';
        return true;
      },
      getLoginHeader: function () { return variables.__loginHeader || ''; },
      getLoginHeaderMap: function () {
        try { return createJavaMap(this.getLoginHeader() ? JSON.parse(this.getLoginHeader()) : {}); } catch (e) { return createJavaMap({}); }
      },
      putLoginHeader: function (value) {
        sourceEffects.loginHeader = toText(value);
        return true;
      },
      removeLoginHeader: function () {
        sourceEffects.removeLoginHeader = true;
        return true;
      }
    };

    var cookie = {
      getCookie: function (url, key) {
        var cookieText = variables.cookie || '';
        if (!cookieText) {
          var cookieUrl = String(url || sourceUrl);
          var id = makeBridgeId('cookie-get', cookieUrl, '', '', {}, String(key || ''));
          var response = requestBridge({ id: id, type: 'cookie-get', url: cookieUrl, key: String(key || '') });
          cookieText = response.body || '';
          variables.cookie = cookieText;
        }
        if (!key) return cookieText;
        var match = new RegExp(String(key).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)').exec(cookieText);
        return match ? match[1] : '';
      },
      getKey: function (tag, key) {
        return this.getCookie(tag, key);
      },
      setCookie: function (url, value) {
        cookieChanges.push({ action: 'set', url: String(url || sourceUrl), value: toText(value) });
        return value;
      },
      removeCookie: function (url) {
        cookieChanges.push({ action: 'remove', url: String(url || sourceUrl) });
        return '';
      }
    };

    var cacheObject = {
      get: function (key) {
        var cacheKey = String(key || '');
        if (cache[cacheKey] !== undefined) return cache[cacheKey];
        var id = makeBridgeId('cache-get', '', '', '', {}, cacheKey);
        var response = requestBridge({ id: id, type: 'cache-get', key: cacheKey });
        cache[cacheKey] = response.body || '';
        return cache[cacheKey];
      },
      put: function (key, value, saveTime) {
        var cacheKey = String(key || '');
        var text = toText(value);
        cache[cacheKey] = text;
        var id = makeBridgeId('cache-put', '', '', '', {}, cacheKey + '=' + text);
        requestBridge({ id: id, type: 'cache-put', key: cacheKey, value: text, saveTime: Number(saveTime) || 0 });
        return text;
      },
      delete: function (key) {
        var cacheKey = String(key || '');
        delete cache[cacheKey];
        var id = makeBridgeId('cache-delete', '', '', '', {}, cacheKey);
        requestBridge({ id: id, type: 'cache-delete', key: cacheKey });
        return '';
      },
      getMemory: function (key) { return this.get(key); },
      putMemory: function (key, value) { return this.put(key, value); },
      getFromMemory: function (key) { return this.get(key); },
      putFromMemory: function (key, value) { return this.put(key, value); },
      deleteMemory: function (key) { return this.delete(key); }
    };

    var java = {
      ajax: function (url) {
        var urlText = Array.isArray(url) ? url[0] : url;
        return doHttp(urlText, 'GET', '', {}).body();
      },
      ajaxAll: function (urls) {
        var result = [];
        for (var i = 0; i < urls.length; i++) result.push(doHttp(urls[i], 'GET', '', {}));
        return result;
      },
      connect: function (url, header) {
        var option = normalizeOption(header);
        return doHttp(url, option.method, option.body, option.headers);
      },
      head: function (url, headers) {
        return doHttp(url, 'HEAD', '', headers || {});
      },
      get: function (nameOrUrl, headers) {
        if (nameOrUrl === 'key') return context.key || '';
        if (nameOrUrl === 'page') return context.page || 1;
        if (nameOrUrl === 'result') return context.result || '';
        if (nameOrUrl === 'baseUrl') return context.baseUrl || '';
        if (nameOrUrl === 'sourceUrl') return sourceUrl;
        if (variables[String(nameOrUrl)] !== undefined && headers === undefined) return variables[String(nameOrUrl)];
        if (/^https?:\/\//i.test(String(nameOrUrl))) return doHttp(nameOrUrl, 'GET', '', normalizeHeaders(headers));
        return variables[String(nameOrUrl)] || '';
      },
      post: function (url, body, headers) {
        return doHttp(url, 'POST', body || '', normalizeHeaders(headers));
      },
      put: function (key, value) {
        variables[String(key)] = toText(value);
        return value;
      },
      getCache: function (key) { return cacheObject.get(key); },
      putCache: function (key, value, saveTime) { return cacheObject.put(key, value, saveTime); },
      deleteCache: function (key) { return cacheObject.delete(key); },
      getCookie: function (tag, key) { return cookie.getCookie(tag, key); },
      setCookie: function (url, value) { return cookie.setCookie(url, value); },
      removeCookie: function (url) { return cookie.removeCookie(url); },
      getString: function (value) { return toText(value); },
      encodeURI: function (value) { return encodeURI(String(value)); },
      encodeURIComponent: function (value) { return encodeURIComponent(String(value)); },
      base64Encode: function (value) {
        try { return btoa(unescape(encodeURIComponent(String(value)))); } catch (e) { return ''; }
      },
      base64Decode: function (value) {
        try { return decodeURIComponent(escape(atob(String(value)))); } catch (e) { return ''; }
      },
      md5Encode: function (value) {
        return doDigest(value, 'MD5');
      },
      md5Encode16: function (value) {
        return this.md5Encode(value).substring(8, 24);
      },
      sha1Encode: function (value) {
        return doDigest(value, 'SHA1');
      },
      sha256Encode: function (value) {
        return doDigest(value, 'SHA256');
      },
      HMacHex: function (value, key, algorithm) {
        return doHmac(value, key, algorithm || 'HmacMD5');
      },
      timeFormat: function (time) {
        var n = Number(time);
        if (!isFinite(n)) n = Date.now();
        return new Date(n).toISOString();
      },
      randomUUID: function () {
        var random = Math.random;
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
          var r = random() * 16 | 0;
          var v = c === 'x' ? r : (r & 0x3 | 0x8);
          return v.toString(16);
        });
      },
      util: {
        UUID: {
          randomUUID: function () {
            var value = java.randomUUID();
            return { toString: function () { return value; } };
          }
        }
      },
      log: function (value) {
        logs.push(String(value));
        return value;
      },
      toast: function (value) {
        var text = String(value);
        logs.push('[toast] ' + text);
        toasts.push({ type: 'short', msg: text });
        return value;
      },
      longToast: function (value) {
        var text = String(value);
        logs.push('[longToast] ' + text);
        toasts.push({ type: 'long', msg: text });
        return value;
      },
      webView: function (html, url, js) {
        if (js) return executeJsInScope(js, html || '', url || '');
        return html || '';
      },
      webViewGetSource: function (html, url, js) {
        return this.webView(html, url, js);
      },
      webViewGetOverrideUrl: function (html, url, js) {
        return this.webView(html, url, js);
      },
      cacheFile: function (url, saveTime) {
        var urlText = String(url || '');
        var cacheKey = 'cacheFile:' + java.md5Encode16(urlText);
        var cached = cacheObject.get(cacheKey);
        if (cached) return cached;
        var body = java.ajax(urlText);
        if (body) cacheObject.put(cacheKey, body, saveTime || 0);
        return body;
      },
      importScript: function (path) {
        var pathText = String(path || '');
        if (/^https?:\/\//i.test(pathText)) return java.cacheFile(pathText);
        var body = readRuntimeFile(pathText);
        if (!body) throw new Error(pathText + ' 内容获取失败或者为空');
        return body;
      },
      downloadFile: function (url) {
        return downloadRuntimeFile(url);
      },
      writeTxtFile: function (path, value) {
        return writeRuntimeFile(path, value);
      },
      readTxtFile: function (path) {
        return readRuntimeFile(path);
      }
    };

    var Jsoup = {
      connect: function (url) {
        var requestHeaders = {};
        var requestBody = '';
        var requestMethod = 'GET';
        var api = {
          header: function (key, value) {
            requestHeaders[String(key)] = String(value);
            return api;
          },
          headers: function (headers) {
            Object.keys(headers || {}).forEach(function (key) { requestHeaders[key] = String(headers[key]); });
            return api;
          },
          data: function (key, value) {
            var pair = encodeURIComponent(String(key)) + '=' + encodeURIComponent(String(value));
            requestBody = requestBody ? requestBody + '&' + pair : pair;
            requestMethod = 'POST';
            return api;
          },
          requestBody: function (body) {
            requestBody = toText(body);
            requestMethod = 'POST';
            return api;
          },
          method: function (method) {
            requestMethod = String(method || 'GET').toUpperCase();
            return api;
          },
          get: function () { return doHttp(url, 'GET', '', requestHeaders); },
          post: function () { return doHttp(url, 'POST', requestBody, requestHeaders); },
          execute: function () { return doHttp(url, requestMethod, requestBody, requestHeaders); }
        };
        return api;
      },
      parse: function (html) {
        return {
          html: function () { return html || ''; },
          text: function () { return String(html || '').replace(/<[^>]+>/g, '').trim(); },
          select: function () { return { remove: function () { return this; }, html: function () { return html || ''; }, text: function () { return String(html || '').replace(/<[^>]+>/g, '').trim(); } }; },
          selectFirst: function () { return null; },
          toString: function () { return html || ''; }
        };
      }
    };

    function toByteArray(value) {
      if (value === undefined || value === null) return [];
      if (Array.isArray(value)) return value.map(function (item) { return Number(item) & 255; });
      var text = String(value);
      var bytes = [];
      for (var i = 0; i < text.length; i++) {
        var code = text.charCodeAt(i);
        if (code < 0x80) {
          bytes.push(code);
        } else if (code < 0x800) {
