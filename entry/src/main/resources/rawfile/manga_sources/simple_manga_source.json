{
  "metadata": {
    "name": "简单漫画网站",
    "version": "1.0.0",
    "author": "测试",
    "description": "简化版配置，用于测试基础功能",
    "baseUrl": "https://simple-manga.com",
    "language": "zh-CN",
    "nsfw": false
  },
  "settings": {
    "timeout": 15000,
    "retryCount": 2,
    "retryDelay": 1000,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  },
  "workflows": {
    "initialize": {
      "name": "初始化",
      "description": "访问首页",
      "actions": [
        {
          "type": "navigate",
          "url": "{baseUrl}",
          "waitFor": "load",
          "timeout": 10000
        }
      ]
    },
    "search": {
      "name": "搜索",
      "description": "搜索漫画",
      "actions": [
        {
          "type": "navigate",
          "url": "{baseUrl}/search?keyword={searchKeyword}",
          "waitFor": "load"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": ".manga-list",
          "timeout": 5000
        },
        {
          "type": "extract",
          "selector": ".manga-item",
          "multiple": true,
          "fields": {
            "id": "a@href",
            "title": ".title",
            "author": ".author",
            "coverUrl": "img@src",
            "url": "a@href"
          }
        }
      ]
    },
    "getMangaDetail": {
      "name": "获取详情",
      "description": "获取漫画详情",
      "actions": [
        {
          "type": "navigate",
          "url": "{baseUrl}/manga/{mangaId}",
          "waitFor": "load"
        },
        {
          "type": "extract",
          "selector": ".manga-info",
          "multiple": false,
          "fields": {
            "id": "@data-id",
            "title": ".title",
            "author": ".author",
            "description": ".description",
            "coverUrl": ".cover img@src",
            "status": ".status"
          }
        }
      ]
    },
    "getChapterList": {
      "name": "获取章节",
      "description": "获取章节列表",
      "actions": [
        {
          "type": "navigate",
          "url": "{baseUrl}/manga/{mangaId}/chapters",
          "waitFor": "load"
        },
        {
          "type": "extract",
          "selector": ".chapter",
          "multiple": true,
          "fields": {
            "id": "a@href",
            "title": ".title",
            "url": "a@href",
            "publishTime": ".date"
          }
        }
      ]
    },
    "getPageList": {
      "name": "获取页面",
      "description": "获取页面列表",
      "actions": [
        {
          "type": "navigate",
          "url": "{baseUrl}/chapter/{chapterId}",
          "waitFor": "load"
        },
        {
          "type": "extract",
          "selector": ".page",
          "multiple": true,
          "fields": {
            "index": "@data-index",
            "imageUrl": "img@src"
          }
        }
      ]
    },
    "getImageUrl": {
      "name": "获取图片",
      "description": "获取图片URL",
      "actions": [
        {
          "type": "extract",
          "selector": ".page[data-index='{pageIndex}'] img",
          "multiple": false,
          "fields": {
            "imageUrl": "@src"
          }
        }
      ]
    }
  },
  "errorHandling": {
    "retry": {
      "maxAttempts": 2,
      "delay": 1000,
      "backoff": "linear"
    }
  },
  "performance": {
    "cache": {
      "enabled": true,
      "ttl": 180000
    }
  },
  "debugging": {
    "logging": {
      "enabled": true,
      "level": "info"
    }
  },
  "antiCrawler": {
    "cloudflare": {
      "enabled": false
    },
    "captcha": {
      "enabled": false
    },
    "ipBlock": {
      "enabled": false
    }
  },
  "extensions": {}
}