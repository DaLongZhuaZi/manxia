    "enableAutosave": true,
    "maxAutosaveFiles": 5,
    "showTutorials": true,
    "enableHints": true,
    "difficultySettings": {
      "resourceScarcity": 1.0,
      "eventFrequency": 1.0,
      "threatLevel": 1.0
    }
  },
  "accessibility": {
    "enableColorBlindSupport": false,
    "highContrast": false,
    "largeText": false,
    "enableScreenReader": false,
    "reduceMotion": false
  },
  "network": {
    "enableCloudSave": false,
    "autoSync": false,
    "connectionTimeout": 30000,
    "enableTelemetry": false
  },
  "advanced": {
    "enableExperimentalFeatures": false,
    "enableModSupport": false,
    "maxConcurrentTasks": 4,
    "memoryPoolSize": 256,
    "enableGarbageCollection": true,
    "gcInterval": 60000
